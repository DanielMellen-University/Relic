# shell/desktop.relic: a first MONOLITH 2 desktop, written in Relic (M11).
#   build-sdl/relic shell/desktop.relic
# Click Start, pick an app, click inside it or type. Drag a title bar to move,
# drag the bottom-right corner to resize. The x box closes a window, taskbar
# buttons bring one to the front. Escape quits.
use wm
use std/graphics

fun draw_box(b, r, g, bl)
    graphics.rect(b[0], b[1], b[2], b[3], r, g, bl)

fun draw(d)
    graphics.clear(30, 60, 90)
    graphics.text(8, 8, "MONOLITH 2", 200, 220, 240)
    for w in d.windows
        let top = w == wm.focused(d)
        if top
            draw_box([w.x, w.y, w.width, wm.title_height], 60, 90, 160)
        else
            draw_box([w.x, w.y, w.width, wm.title_height], 90, 90, 100)
        draw_box([w.x, w.y + wm.title_height, w.width, w.height], 235, 235, 235)
        graphics.text(w.x + 4, w.y + 2, w.app.name, 255, 255, 255)
        let cb = wm.close_box(w)
        draw_box(cb, 180, 60, 60)
        graphics.text(cb[0] + 4, cb[1] + 2, "x", 255, 255, 255)
        let row = 0
        for line in w.app.lines(w.state)
            graphics.text(w.x + 6, w.y + wm.title_height + 6 + row * 14, line, 20, 20, 20)
            row = row + 1
        let rb = wm.resize_box(w)
        draw_box(rb, 160, 160, 170)
    let bt = wm.bar_top(d)
    draw_box([0, bt, d.width, wm.bar_height], 50, 50, 55)
    draw_box([2, bt + 3, wm.start_width - 4, wm.bar_height - 6], 70, 130, 70)
    graphics.text(8, bt + 6, "Start", 255, 255, 255)
    let t = wm.tabs(d)
    for i in 0..len(t)
        let b = wm.tab_box(d, i)
        if t[i] == wm.focused(d)
            draw_box(b, 100, 100, 120)
        else
            draw_box(b, 75, 75, 85)
        graphics.text(b[0] + 6, b[1] + 3, t[i].app.name, 255, 255, 255)
    if d.menu_open
        for i in 0..len(d.apps)
            let b = wm.menu_item_box(d, i)
            draw_box(b, 220, 220, 225)
            graphics.text(b[0] + 6, b[1] + 3, d.apps[i].name, 20, 20, 20)
    graphics.present()

if not graphics.available()
    print("this relic was built without graphics; rebuild with -DRELIC_SDL=ON")
else
    let d = wm.new_desktop(640, 480, wm.default_apps())
    graphics.open(d.width, d.height, "MONOLITH 2")
    let was_down = false
    let running = true
    while running and not graphics.quit_requested()
        let k = graphics.next_key()
        while k != none
            if k == "escape"
                running = false
            else
                wm.key(d, k)
            k = graphics.next_key()
        let mx = graphics.mouse_x()
        let my = graphics.mouse_y()
        let down = graphics.mouse_down(1)
        if down and not was_down
            wm.click(d, mx, my)
        else if down and was_down
            wm.motion(d, mx, my)
        else if not down and was_down
            wm.release(d)
        was_down = down
        draw(d)
        graphics.wait(16)
    graphics.close()
