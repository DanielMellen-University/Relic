# shell/wm.relic: the MONOLITH 2 desktop model (M11). No drawing here, so it
# runs and tests without SDL. shell/desktop.relic draws it with std/graphics.
#
# A desktop has apps (what the Start menu can launch) and windows (running
# apps, last one on top). An app is a map:
#   {name, width, height, init(), lines(state), on_click(state, x, y), on_key(state, key)}
# lines() gives the text rows the desktop draws inside the window.
# Drag and resize use press (via click), motion, and release. drag on the
# desktop is none, or {id, mode, ox, oy} with mode "move" or "resize".

use std/strings
use std/time
use std/vfs
use std/paths

let bar_height = 24     # taskbar along the bottom
let title_height = 16   # window title bar
let start_width = 56
let menu_row = 18
let tab_width = 90
let grip = 12           # bottom-right resize handle
let min_width = 80
let min_height = 40

# Shared in-memory VFS for Files, Editor and Terminal (not the host disk).
let _shell_fs = vfs.new()
# The file Editor opens next. Files sets it when you open a file.
let _shell_open = {path: "/home/welcome.txt"}

# p if it is a folder, else its nearest parent that is. Used when a folder
# an app is in gets removed or moved from another app.
fun _existing_dir(fs, p)
    let x = p
    while not vfs.is_dir(fs, x)
        x = paths.dir(x)
    return x

fun new_desktop(width, height, apps)
    return {width: width, height: height, apps: apps, windows: [], menu_open: false, next_id: 1, drag: none}

fun bar_top(d) = d.height - bar_height

# Start menu rows, bottom up from the taskbar: [x, y, w, h] of row i.
fun menu_item_box(d, i)
    let n = len(d.apps)
    return [0, bar_top(d) - (n - i) * menu_row, 120, menu_row]

# Taskbar button of window i (in launch order is fine, it is by index).
fun tab_box(d, i) = [start_width + 4 + i * (tab_width + 4), bar_top(d) + 3, tab_width, bar_height - 6]

fun close_box(w) = [w.x + w.width - title_height, w.y, title_height, title_height]

fun resize_box(w) = [w.x + w.width - grip, w.y + title_height + w.height - grip, grip, grip]

fun _inside(b, x, y) = x >= b[0] and x < b[0] + b[2] and y >= b[1] and y < b[1] + b[3]

fun launch(d, app)
    let n = len(d.windows)
    let w = {id: d.next_id, app: app, state: app.init(), x: 40 + n * 24, y: 30 + n * 20, width: app.width, height: app.height}
    d.next_id = d.next_id + 1
    append(d.windows, w)
    return w

fun focused(d)
    if len(d.windows) == 0
        return none
    return d.windows[len(d.windows) - 1]

fun _raise(d, i)
    let w = d.windows[i]
    remove(d.windows, i)
    append(d.windows, w)

fun _index_of(d, id)
    for i in 0..len(d.windows)
        if d.windows[i].id == id
            return i
    return -1

fun close(d, id)
    let i = _index_of(d, id)
    if i >= 0
        remove(d.windows, i)
    if d.drag != none and d.drag.id == id
        d.drag = none

# Keep enough of the title bar on screen so the window stays reachable.
fun _clamp_pos(d, w)
    let max_x = d.width - 40
    let min_x = 40 - w.width
    if w.x < min_x
        w.x = min_x
    if w.x > max_x
        w.x = max_x
    let max_y = bar_top(d) - title_height
    if w.y < 0
        w.y = 0
    if w.y > max_y
        w.y = max_y

fun _clamp_size(d, w)
    if w.width < min_width
        w.width = min_width
    if w.height < min_height
        w.height = min_height
    if w.x + w.width > d.width
        w.width = d.width - w.x
        if w.width < min_width
            w.width = min_width
    let room = bar_top(d) - w.y - title_height
    if w.height > room
        w.height = room
        if w.height < min_height
            w.height = min_height

# Taskbar order is launch order, which is the id order.
fun tabs(d)
    let out = []
    for w in d.windows
        let placed = false
        for i in 0..len(out)
            if not placed and w.id < out[i].id
                insert(out, i, w)
                placed = true
        if not placed
            append(out, w)
    return out

fun _begin_drag(d, w, mode, x, y)
    d.drag = {id: w.id, mode: mode, ox: x - w.x, oy: y - w.y}

# A mouse click at (x, y). Gives a short word saying what it hit.
# Title and resize hits also start a drag; call motion and release after.
fun click(d, x, y)
    if d.menu_open
        d.menu_open = false
        for i in 0..len(d.apps)
            if _inside(menu_item_box(d, i), x, y)
                launch(d, d.apps[i])
                return "launch"
    if y >= bar_top(d)
        if x < start_width
            d.menu_open = not d.menu_open
            return "start"
        let t = tabs(d)
        for i in 0..len(t)
            if _inside(tab_box(d, i), x, y)
                _raise(d, _index_of(d, t[i].id))
                return "tab"
        return "bar"
    let i = len(d.windows) - 1
    while i >= 0
        let w = d.windows[i]
        if _inside([w.x, w.y, w.width, w.height + title_height], x, y)
            _raise(d, i)
            w = d.windows[len(d.windows) - 1]
            if _inside(close_box(w), x, y)
                close(d, w.id)
                return "close"
            if y < w.y + title_height
                _begin_drag(d, w, "move", x, y)
                return "title"
            if _inside(resize_box(w), x, y)
                _begin_drag(d, w, "resize", x, y)
                return "resize"
            w.app.on_click(w.state, x - w.x, y - w.y - title_height)
            return "app"
        i = i - 1
    return "desktop"

# Mouse move while a button may be held. Updates a drag or resize in progress.
fun motion(d, x, y)
    if d.drag == none
        return
    let i = _index_of(d, d.drag.id)
    if i < 0
        d.drag = none
        return
    let w = d.windows[i]
    if d.drag.mode == "move"
        w.x = x - d.drag.ox
        w.y = y - d.drag.oy
        _clamp_pos(d, w)
    else if d.drag.mode == "resize"
        w.width = x - w.x
        w.height = y - w.y - title_height
        _clamp_size(d, w)

# Mouse button up ends any drag or resize.
fun release(d)
    d.drag = none

# A key press goes to the window on top.
fun key(d, k)
    let w = focused(d)
    if w != none
        w.app.on_key(w.state, k)

# ---- small apps ----

fun _clicker_init() = {count: 0}
fun _clicker_lines(s) = ["Clicks: {s.count}", "Click here to count."]
fun _clicker_click(s, x, y)
    s.count = s.count + 1
fun _clicker_key(s, k)
    if k == "space"
        s.count = s.count + 1

fun _notes_init() = {text: ""}
fun _notes_lines(s) = ["Type something:", s.text + "_"]
fun _notes_click(s, x, y)
    return none
fun _notes_key(s, k)
    if k == "backspace"
        if len(s.text) > 0
            s.text = slice(s.text, 0, len(s.text) - 1)
    else if k == "space"
        s.text = s.text + " "
    else if len(k) == 1
        s.text = s.text + k

# Relic-native terminal (no host process spawn). It works on the shared VFS
# from a current folder that starts at /home. Paths may be relative to it.
fun _term_init() = {buf: ["Terminal. Type help."], input: "", cwd: "/home", fs: _shell_fs}

fun _term_lines(s)
    let out = []
    for line in s.buf
        append(out, line)
    append(out, s.cwd + "> " + s.input + "_")
    return out

fun _term_click(s, x, y)
    return none

fun _term_reply(s, line)
    append(s.buf, line)

fun _term_path(s, p) = paths.normalize(paths.join(s.cwd, p))

# True when the command got at least n words after it, else prints usage.
fun _term_args(s, parts, n, usage)
    if len(parts) - 1 >= n
        return true
    _term_reply(s, "usage: " + usage)
    return false

fun _term_ls(s, parts)
    let p = s.cwd
    if len(parts) > 1
        p = _term_path(s, parts[1])
    if not vfs.exists(s.fs, p)
        _term_reply(s, "ls: not found: " + p)
        return
    if not vfs.is_dir(s.fs, p)
        _term_reply(s, paths.base(p))
        return
    let names = []
    for n in vfs.list(s.fs, p)
        if vfs.is_dir(s.fs, paths.join(p, n))
            append(names, n + "/")
        else
            append(names, n)
    if len(names) > 0
        _term_reply(s, strings.join(names, "  "))

fun _term_cat(s, path)
    let p = _term_path(s, path)
    try
        let text = vfs.read(s.fs, p)
        if strings.ends_with(text, "\n")
            text = slice(text, 0, len(text) - 1)
        if text != ""
            for line in strings.split(text, "\n")
                _term_reply(s, line)
    catch err
        _term_reply(s, "cat: " + err.message)

fun _term_cd(s, parts)
    let p = "/home"
    if len(parts) > 1
        p = _term_path(s, parts[1])
    if vfs.is_dir(s.fs, p)
        s.cwd = p
    else
        _term_reply(s, "cd: not a folder: " + p)

fun _term_touch(s, path)
    let p = _term_path(s, path)
    if vfs.exists(s.fs, p)
        return
    try
        vfs.write(s.fs, p, "")
    catch err
        _term_reply(s, "touch: " + err.message)

# write and echo > replace the file; echo >> adds to the end. Each adds a newline.
fun _term_write(s, cmd, path, text, add)
    let p = _term_path(s, path)
    try
        if add
            vfs.append(s.fs, p, text + "\n")
        else
            vfs.write(s.fs, p, text + "\n")
    catch err
        _term_reply(s, cmd + ": " + err.message)

fun _term_echo(s, parts)
    let n = len(parts)
    if n >= 3 and (parts[n - 2] == ">" or parts[n - 2] == ">>")
        _term_write(s, "echo", parts[n - 1], strings.join(slice(parts, 1, n - 2), " "), parts[n - 2] == ">>")
    else
        _term_reply(s, strings.join(slice(parts, 1, n), " "))

fun _term_rm(s, path)
    let p = _term_path(s, path)
    if not vfs.exists(s.fs, p)
        _term_reply(s, "rm: not found: " + p)
    else if vfs.is_dir(s.fs, p) and len(vfs.list(s.fs, p)) > 0
        _term_reply(s, "rm: folder not empty: " + p)
    else
        try
            vfs.remove(s.fs, p)
        catch err
            _term_reply(s, "rm: " + err.message)
    s.cwd = _existing_dir(s.fs, s.cwd)

# mv a b: rename a to b, or move a into b when b is a folder.
fun _term_mv(s, a, b)
    let src = _term_path(s, a)
    let dst = _term_path(s, b)
    if vfs.is_dir(s.fs, dst)
        dst = paths.join(dst, paths.base(src))
    if not vfs.exists(s.fs, src)
        _term_reply(s, "mv: not found: " + src)
    else if vfs.exists(s.fs, dst)
        _term_reply(s, "mv: already there: " + dst)
    else
        try
            vfs.rename(s.fs, src, dst)
        catch err
            _term_reply(s, "mv: " + err.message)
    s.cwd = _existing_dir(s.fs, s.cwd)

fun _term_run(s, line)
    let trimmed = strings.trim(line)
    append(s.buf, s.cwd + "> " + line)
    if trimmed == ""
        return
    let parts = strings.split(trimmed, " ")
    let cmd = parts[0]
    if cmd == "help"
        _term_reply(s, "help clear echo apps date")
        _term_reply(s, "pwd cd ls cat mkdir touch write rm mv")
        _term_reply(s, "echo text > file, echo text >> file")
    else if cmd == "clear"
        s.buf = []
    else if cmd == "echo"
        _term_echo(s, parts)
    else if cmd == "apps"
        _term_reply(s, "Clicker, Notes, Terminal, Files, Editor")
    else if cmd == "date"
        _term_reply(s, str(time.now()))
    else if cmd == "pwd"
        _term_reply(s, s.cwd)
    else if cmd == "cd"
        _term_cd(s, parts)
    else if cmd == "ls"
        _term_ls(s, parts)
    else if cmd == "cat"
        if _term_args(s, parts, 1, "cat <path>")
            _term_cat(s, parts[1])
    else if cmd == "mkdir"
        if _term_args(s, parts, 1, "mkdir <path>")
            try
                vfs.make_dir(s.fs, _term_path(s, parts[1]))
            catch err
                _term_reply(s, "mkdir: " + err.message)
    else if cmd == "touch"
        if _term_args(s, parts, 1, "touch <path>")
            _term_touch(s, parts[1])
    else if cmd == "write"
        if _term_args(s, parts, 1, "write <path> <text>")
            _term_write(s, "write", parts[1], strings.join(slice(parts, 2, len(parts)), " "), false)
    else if cmd == "rm"
        if _term_args(s, parts, 1, "rm <path>")
            _term_rm(s, parts[1])
    else if cmd == "mv"
        if _term_args(s, parts, 2, "mv <from> <to>")
            _term_mv(s, parts[1], parts[2])
    else
        _term_reply(s, "unknown: " + cmd)

fun _term_key(s, k)
    if k == "return" or k == "enter"
        _term_run(s, s.input)
        s.input = ""
    else if k == "backspace"
        if len(s.input) > 0
            s.input = slice(s.input, 0, len(s.input) - 1)
    else if k == "space"
        s.input = s.input + " "
    else if len(k) == 1
        s.input = s.input + k

# Files: browse the shared VFS. Click a row or use up/down/return/backspace.
fun _files_init() = {fs: _shell_fs, path: "/home", sel: 0}

fun _files_names(s)
    s.path = _existing_dir(s.fs, s.path)
    let names = []
    if s.path != "/"
        append(names, "..")
    for n in vfs.list(s.fs, s.path)
        append(names, n)
    return names

fun _files_full(s, name)
    if name == ".."
        return paths.dir(s.path)
    if s.path == "/"
        return "/" + name
    return s.path + "/" + name

fun _files_lines(s)
    let names = _files_names(s)
    let out = ["Files: " + s.path]
    if s.sel >= len(names)
        s.sel = len(names) - 1
    if s.sel < 0
        s.sel = 0
    for i in 0..len(names)
        let mark = "  "
        if i == s.sel
            mark = "> "
        let name = names[i]
        if name != ".." and vfs.is_dir(s.fs, _files_full(s, name))
            append(out, mark + name + "/")
        else
            append(out, mark + name)
    return out

fun _files_open(s, name)
    let full = _files_full(s, name)
    if name == ".." or vfs.is_dir(s.fs, full)
        s.path = full
        s.sel = 0
    else
        # the next Editor window opens this file
        _shell_open.path = full

fun _files_click(s, x, y)
    let row = int(y / 14)
    if row <= 0
        return
    let names = _files_names(s)
    let i = row - 1
    if i >= 0 and i < len(names)
        s.sel = i
        _files_open(s, names[i])

fun _files_key(s, k)
    let names = _files_names(s)
    if k == "up"
        if s.sel > 0
            s.sel = s.sel - 1
    else if k == "down"
        if s.sel < len(names) - 1
            s.sel = s.sel + 1
    else if k == "return" or k == "enter"
        if len(names) > 0
            _files_open(s, names[s.sel])
    else if k == "backspace"
        if s.path != "/"
            s.path = paths.dir(s.path)
            s.sel = 0

# Editor: text buffer over a VFS path. Type like Notes; ctrl+s saves.
# It opens the file last opened in Files, or /home/welcome.txt.
fun _editor_init()
    let path = _shell_open.path
    let text = ""
    try
        text = vfs.read(_shell_fs, path)
    catch
        text = ""
    return {fs: _shell_fs, path: path, text: text, status: "open"}

fun _editor_lines(s) = ["Editor: " + s.path + "  (ctrl+s save)  [" + s.status + "]", s.text + "_"]

fun _editor_click(s, x, y)
    return none

fun _editor_key(s, k)
    if k == "ctrl+s"
        try
            vfs.write(s.fs, s.path, s.text)
            s.status = "saved"
        catch err
            s.status = err.message
    else if k == "backspace"
        if len(s.text) > 0
            s.text = slice(s.text, 0, len(s.text) - 1)
            s.status = "edited"
    else if k == "return" or k == "enter"
        s.text = s.text + "\n"
        s.status = "edited"
    else if k == "space"
        s.text = s.text + " "
        s.status = "edited"
    else if len(k) == 1
        s.text = s.text + k
        s.status = "edited"

let clicker = {name: "Clicker", width: 180, height: 60, init: _clicker_init, lines: _clicker_lines, on_click: _clicker_click, on_key: _clicker_key}
let notes = {name: "Notes", width: 220, height: 60, init: _notes_init, lines: _notes_lines, on_click: _notes_click, on_key: _notes_key}
let terminal = {name: "Terminal", width: 280, height: 120, init: _term_init, lines: _term_lines, on_click: _term_click, on_key: _term_key}
let files_app = {name: "Files", width: 260, height: 140, init: _files_init, lines: _files_lines, on_click: _files_click, on_key: _files_key}
let editor = {name: "Editor", width: 320, height: 80, init: _editor_init, lines: _editor_lines, on_click: _editor_click, on_key: _editor_key}
fun default_apps() = [clicker, notes, terminal, files_app, editor]
