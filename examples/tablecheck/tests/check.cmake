# Exact stdout, stderr AND exit checks, including failures after valid rows.
file(MAKE_DIRECTORY "${TMP}")
file(COPY "${APP}/samples/" DESTINATION "${TMP}")
file(READ "${APP}/tests/tickets.out" tickets)
file(READ "${APP}/tests/stock.out" stock)
file(READ "${APP}/tests/help.out" help)
set(checks 0)
function(expect label code want_out want_err)
  execute_process(COMMAND ${CMAKE_COMMAND} -E env RELIC_LEAK_CHECK=1 "${EXE}" ${ARGN}
    WORKING_DIRECTORY "${TMP}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE got)
  # Match the repository convention for Windows output line endings.
  string(REPLACE "\r\n" "\n" out "${out}")
  string(REPLACE "\r\n" "\n" err "${err}")
  if(NOT "${got}" STREQUAL "${code}" OR NOT "${out}" STREQUAL "${want_out}" OR NOT "${err}" STREQUAL "${want_err}")
    message(FATAL_ERROR "${label}: wanted exit ${code}, got ${got}\nstdout wanted:\n${want_out}stdout got:\n${out}stderr wanted:\n${want_err}stderr got:\n${err}")
  endif()
  math(EXPR checks "${checks}+1")
  set(checks ${checks} PARENT_SCOPE)
endfunction()
function(bad_input label filename contents diagnostic)
  file(WRITE "${TMP}/${filename}" "${contents}")
  expect("${label}" 3 "" "tablecheck: ${filename}: ${diagnostic}\n" ${ARGN} "${filename}")
  set(checks ${checks} PARENT_SCOPE)
endfunction()
function(bad_usage label diagnostic)
  expect("${label}" 2 "" "tablecheck: ${diagnostic}; run tablecheck --help\n" ${ARGN})
  set(checks ${checks} PARENT_SCOPE)
endfunction()

expect(csv 0 "${tickets}" "" tickets.csv)
expect(csv_key 0 "${tickets}" "" --key ticket tickets.csv)
expect(tsv_key 0 "${stock}" "" --delimiter tsv --key sku stock.tsv)
expect(help 0 "${help}" "" --help)
configure_file("${TMP}/tickets.csv" "${TMP}/spaced name.csv" COPYONLY)
expect(spaced_path 0 "${tickets}" "" "spaced name.csv")
configure_file("${TMP}/tickets.csv" "${TMP}/-tickets.csv" COPYONLY)
expect(dash_path 0 "${tickets}" "" -- -tickets.csv)
file(READ "${TMP}/tickets.csv" csv)
string(REPLACE "\n" "\r\n" crlf "${csv}")
file(WRITE "${TMP}/crlf.csv" "${crlf}")
