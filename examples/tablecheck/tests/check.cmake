file(WRITE "${TMP}/header.csv" "id,note\n")
expect(header_only 0 "rows: 0\ncolumns: 2\ncolumn\tpresent\tempty\tdistinct\nid\t0\t0\t0\nnote\t0\t0\t0\n" "" --key id header.csv)
file(WRITE "${TMP}/empty_fields.csv" "a,b,c\nx,,\n,,\n")
expect(empty_fields 0 "rows: 2\ncolumns: 3\ncolumn\tpresent\tempty\tdistinct\na\t1\t1\t1\nb\t0\t2\t0\nc\t0\t2\t0\n" "" empty_fields.csv)
file(WRITE "${TMP}/exact.csv" "id,value\n01,é\n1,é\n 1,É\n1 , \n")
expect(exact_values 0 "rows: 4\ncolumns: 2\ncolumn\tpresent\tempty\tdistinct\nid\t4\t0\t4\nvalue\t4\t0\t3\n" "" --key id exact.csv)
file(WRITE "${TMP}/one.csv" "item\na\na\nb")
expect(one_column 0 "rows: 3\ncolumns: 1\ncolumn\tpresent\tempty\tdistinct\nitem\t3\t0\t2\n" "" one.csv)
file(WRITE "${TMP}/key_name.csv" "ticket id,status\nT1,open\n")
expect(spaced_key_name 0 "rows: 1\ncolumns: 2\ncolumn\tpresent\tempty\tdistinct\nticket id\t1\t0\t1\nstatus\t1\t0\t1\n" "" --key "ticket id" key_name.csv)
string(REPEAT "long-value-" 300 long_value)
set(many "id,value\n")
foreach(i RANGE 1 250)
  string(APPEND many "${i},${long_value}\n")
endforeach()
file(WRITE "${TMP}/many.csv" "${many}")
expect(many_long_rows 0 "rows: 250\ncolumns: 2\ncolumn\tpresent\tempty\tdistinct\nid\t250\t0\t250\nvalue\t250\t0\t1\n" "" --key id many.csv)

expect(broken_sample 3 "" "tablecheck: broken.csv: line 3: expected 4 fields, got 3; check the delimiter and supply empty trailing fields\n" broken.csv)
bad_input(empty empty.csv "" "line 1: missing header; provide a nonempty first line of column names")
bad_input(blank_header blank.csv "\n" "line 1: column 1 has an empty name; give every column a name")
bad_input(empty_header empty_name.csv "id,\n1,x\n" "line 1: column 2 has an empty name; give every column a name")
bad_input(spaced_header spaced.csv "id, name\n1,x\n" "line 1: column 2 has surrounding whitespace; trim the header name")
bad_input(duplicate_header repeated.csv "id,id\n1,2\n" "line 1: duplicate header 'id'; rename one column")
bad_input(short_row short.csv "id,name\n1,Ada\n2\n" "line 3: expected 2 fields, got 1; check the delimiter and supply empty trailing fields")
bad_input(long_row long.csv "id,name\n1,Ada,x\n" "line 2: expected 2 fields, got 3; check the delimiter and supply empty trailing fields")
bad_input(blank_row blank_row.csv "id,name\n\n" "line 2: expected 2 fields, got 1; check the delimiter and supply empty trailing fields")
bad_input(quoted quoted.csv "id,name\n1,\"Ada\"\n" "line 2: quoted fields are unsupported; export unquoted CSV/TSV without embedded delimiters or newlines")
bad_input(quoted_header quoted_header.csv "\"id\",name\n" "line 1: quoted fields are unsupported; export unquoted CSV/TSV without embedded delimiters or newlines")
bad_input(tab_in_csv tabs.csv "id\tname\n" "line 1: control character 9 is unsupported; remove it or select --delimiter tsv for tabs")
bad_input(bare_cr cr.csv "id,name\r1,Ada" "line 1: control character 13 is unsupported; remove it or select --delimiter tsv for tabs")
string(ASCII 127 del)
bad_input(del del.csv "id\n${del}\n" "line 2: control character 127 is unsupported; remove it or select --delimiter tsv for tabs")
string(ASCII 239 187 191 bom)
bad_input(bom bom.csv "${bom}id\n1\n" "line 1: byte order mark is unsupported; save the file as UTF-8 without BOM")
bad_input(missing_key absent.csv "id,name\n1,Ada\n" "line 1: key column 'ticket' is absent; choose one of: id, name" --key ticket)
bad_input(blank_key blank_key.csv "id,name\n1,Ada\n,Lee\n" "line 3: key 'id' is blank; supply a nonblank unique value" --key id)
bad_input(whitespace_key white_key.csv "id,name\n   ,Ada\n" "line 2: key 'id' is blank; supply a nonblank unique value" --key id)
bad_input(duplicate_key duplicate.csv "id,name\n1,Ada\n2,Lee\n1,Sam\n" "line 4: duplicate key 'id' value '1' (first seen on line 2); make keys unique" --key id)
expect(duplicate_allowed_without_key 0 "rows: 3\ncolumns: 2\ncolumn\tpresent\tempty\tdistinct\nid\t3\t0\t2\nname\t3\t0\t3\n" "" duplicate.csv)
expect(missing_file 3 "" "tablecheck: cannot read 'missing.csv'; check that it is a readable file (files.read(): cannot open missing.csv)\n" missing.csv)
expect(directory 3 "" "tablecheck: cannot read '.'; check that it is a readable file (files.read(): cannot open .)\n" .)
bad_usage(no_args "expected exactly one input file, got 0")
bad_usage(extra_file "expected exactly one input file, got 2" tickets.csv stock.tsv)
bad_usage(unknown_option "unknown option '--wat' (use -- before a filename starting with '-')" --wat)
bad_usage(missing_delimiter "--delimiter needs a value" --delimiter)
bad_usage(bad_delimiter "unknown delimiter 'pipe' (choose csv or tsv)" --delimiter pipe tickets.csv)
bad_usage(repeated_delimiter "--delimiter was supplied twice" --delimiter csv --delimiter tsv tickets.csv)
bad_usage(missing_key_value "--key needs a value" --key)
bad_usage(empty_key "--key needs a nonblank column name" --key " " tickets.csv)
bad_usage(repeated_key "--key was supplied twice" --key ticket --key team tickets.csv)
bad_usage(help_with_input "unknown option '--help' (use -- before a filename starting with '-')" --help tickets.csv)
bad_usage(dash_filename "unknown option '-tickets.csv' (use -- before a filename starting with '-')" -tickets.csv)

# Syntax rejection is compile-time. Type hints are checked only at runtime.
execute_process(COMMAND "${RELICC}" tests/syntax_error.relic -o "${TMP}/syntax_error.c"
  WORKING_DIRECTORY "${APP}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code)
file(READ "${APP}/tests/syntax_error.err" want)
string(REPLACE "\r\n" "\n" err "${err}")
if(NOT code STREQUAL "1" OR NOT out STREQUAL "" OR NOT err STREQUAL want)
  message(FATAL_ERROR "syntax diagnostic: exit ${code}\n${out}${err}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E env RELIC_LEAK_CHECK=1 "${TYPE_EXE}"
  WORKING_DIRECTORY "${APP}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code)
file(READ "${APP}/tests/type_error.err" want)
string(REPLACE "\r\n" "\n" err "${err}")
string(REPLACE "${APP}/" "" err "${err}")
if(NOT code STREQUAL "1" OR NOT out STREQUAL "" OR NOT err STREQUAL want)
  message(FATAL_ERROR "type diagnostic: exit ${code}\n${out}${err}")
endif()
math(EXPR checks "${checks}+2")
message(STATUS "tablecheck: ${checks} exact stdout/stderr/exit checks passed (leak check enabled)")
