# Validation and summary only; the CLI owns file access and exit codes.
use std/strings

fun _bad(line, message)
    fail("line {line}: {message}")

fun _fields(line as string, delimiter as string, number as int) as list
    for c in line
        if c == "\""
            _bad(number, "quoted fields are unsupported; export unquoted CSV/TSV without embedded delimiters or newlines")
        if (ord(c) < 32 or ord(c) == 127) and c != delimiter
            _bad(number, "control character {ord(c)} is unsupported; remove it or select --delimiter tsv for tabs")
    return strings.split(line, delimiter)

fun summarize(text as string, delimiter as string, key as string) as map
    if delimiter != "," and delimiter != "\t"
        fail("delimiter must be comma or tab")
    let lines = strings.lines(text)
    if len(lines) == 0
        _bad(1, "missing header; provide a nonempty first line of column names")
    if strings.starts_with(lines[0], chr(65279))
        _bad(1, "byte order mark is unsupported; save the file as UTF-8 without BOM")
    let names = _fields(lines[0], delimiter, 1)
    let columns = []
    let positions = {}
    for i in 0..len(names)
        let name = names[i]
        if strings.trim(name) == ""
            _bad(1, "column {i + 1} has an empty name; give every column a name")
        if strings.trim(name) != name
            _bad(1, "column {i + 1} has surrounding whitespace; trim the header name")
        if name in positions
            _bad(1, "duplicate header '{name}'; rename one column")
        positions[name] = i
        append(columns, {name: name, present: 0, empty: 0, seen: {}})
    let key_index = -1
    if key != ""
        if not (key in positions)
            _bad(1, "key column '{key}' is absent; choose one of: " + strings.join(names, ", "))
        key_index = positions[key]
    let key_lines = {}
    for i in 1..len(lines)
        let number = i + 1
        let fields = _fields(lines[i], delimiter, number)
        if len(fields) != len(names)
            _bad(number, "expected {len(names)} fields, got {len(fields)}; check the delimiter and supply empty trailing fields")
        if key_index >= 0
            let value = fields[key_index]
            if strings.trim(value) == ""
                _bad(number, "key '{key}' is blank; supply a nonblank unique value")
            if value in key_lines
                _bad(number, "duplicate key '{key}' value '{value}' (first seen on line {key_lines[value]}); make keys unique")
            key_lines[value] = number
        for j in 0..len(fields)
            let column = columns[j]
            let value = fields[j]
            if value == ""
                column.empty = column.empty + 1
            else
                column.present = column.present + 1
                column.seen[value] = true
    return {rows: len(lines) - 1, columns: columns}

fun report(summary as map)
    print("rows: {summary.rows}")
    print("columns: {len(summary.columns)}")
    print("column\tpresent\tempty\tdistinct")
    for column in summary.columns
        print("{column.name}\t{column.present}\t{column.empty}\t{len(column.seen)}")
