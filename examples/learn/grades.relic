# A short grade book: letter for each score, then the mean.
#   relic examples/learn/grades.relic
use std/lists

fun letter(score)
    if score >= 90
        return "A"
    else if score >= 80
        return "B"
    else if score >= 70
        return "C"
    else if score >= 60
        return "D"
    return "F"

let book = [
    {name: "Ada", score: 92},
    {name: "Grace", score: 81},
    {name: "Linus", score: 74}
]
fun score_of(row) = row.score
let scores = lists.map(book, score_of)
for row in book
    print("{row.name}  {row.score}  {letter(row.score)}")
print("mean {lists.mean(scores)}")
