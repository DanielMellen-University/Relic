# Perfect, abundant and deficient numbers, by comparing a number with the sum
# of its proper divisors. Divisors come in pairs up to the square root.
#   relic examples/learn/perfect.relic

fun divisor_sum(n)
    if n == 1
        return 0
    let total = 1
    let d = 2
    while d * d <= n
        if n % d == 0
            total = total + d
            let other = int(n / d)
            if other != d
                total = total + other
        d = d + 1
    return total

fun classify(n)
    let s = divisor_sum(n)
    if s == n
        return "perfect"
    if s > n
        return "abundant"
    return "deficient"

for n in [1, 6, 12, 28, 35, 496, 945, 8128]
    print("{n}: {classify(n)} (divisors add to {divisor_sum(n)})")
let found = []
for n in 2..10000
    if divisor_sum(n) == n
        append(found, n)
print("perfect below 10000: {found}")
