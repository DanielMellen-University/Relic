# Quicksort with the Lomuto partition: the last item is the pivot, smaller
# items move in front of it, and each side is sorted the same way.
#   relic examples/learn/quicksort.relic

fun swap(xs, i, j)
    let tmp = xs[i]
    xs[i] = xs[j]
    xs[j] = tmp

fun partition(xs, lo, hi)
    let pivot = xs[hi]
    let i = lo
    for j in lo..hi
        if xs[j] < pivot
            swap(xs, i, j)
            i = i + 1
    swap(xs, i, hi)
    return i

fun sort_range(xs, lo, hi)
    if lo >= hi
        return
    let p = partition(xs, lo, hi)
    sort_range(xs, lo, p - 1)
    sort_range(xs, p + 1, hi)

fun quicksort(xs)
    sort_range(xs, 0, len(xs) - 1)
    return xs

print(quicksort([3, 6, 1, 8, 2, 9, 4]))
print(quicksort([5, 5, 1, 5, 0]))
print(quicksort(["kiwi", "apple", "mango", "banana"]))
print(quicksort([]))
