# Longest increasing subsequence, the O(n^2) way: the best run ending at each
# item, and a link back to the item before it.
#   relic examples/learn/lis.relic

fun lis(xs)
    if len(xs) == 0
        return []
    let best = []
    let back = []
    let top = 0
    for i in 0..len(xs)
        append(best, 1)
        append(back, -1)
        for j in 0..i
            if xs[j] < xs[i] and best[j] + 1 > best[i]
                best[i] = best[j] + 1
                back[i] = j
        if best[i] > best[top]
            top = i
    let out = []
    let i = top
    while i >= 0
        insert(out, 0, xs[i])
        i = back[i]
    return out

for xs in [[10, 9, 2, 5, 3, 7, 101, 18], [0, 8, 4, 12, 2, 10, 6, 14, 1, 9], [5, 4, 3], []]
    let run = lis(xs)
    print("{xs}: {run} ({len(run)})")
