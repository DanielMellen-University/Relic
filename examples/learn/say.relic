# Whole numbers from 0 to 99 in words.
#   relic examples/learn/say.relic

fun say(n)
    let ones = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
    let teens = ["ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    let tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    if n < 10
        return ones[n]
    if n < 20
        return teens[n - 10]
    let t = tens[int(n / 10)]
    let o = n % 10
    if o == 0
        return t
    return t + "-" + ones[o]

for n in [0, 5, 10, 13, 20, 21, 42, 99]
    print(n, say(n))
