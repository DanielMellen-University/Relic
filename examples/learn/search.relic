# Binary search on a sorted list. Missing items come back as -1.
#   relic examples/learn/search.relic

fun search(xs, target)
    let lo = 0
    let hi = len(xs) - 1
    while lo <= hi
        let mid = int((lo + hi) / 2)
        if xs[mid] == target
            return mid
        else if xs[mid] < target
            lo = mid + 1
        else
            hi = mid - 1
    return -1

let xs = [1, 3, 4, 7, 9, 12, 15]
print(xs)
print(search(xs, 7))
print(search(xs, 1))
print(search(xs, 15))
print(search(xs, 8))
