# Multiply, transpose and take the determinant of small matrices.
#   relic examples/learn/matrix.relic

fun mul(a, b)
    let out = []
    for i in 0..len(a)
        let row = []
        for j in 0..len(b[0])
            let s = 0
            for k in 0..len(b)
                s = s + a[i][k] * b[k][j]
            append(row, s)
        append(out, row)
    return out

fun transpose(a)
    let out = []
    for j in 0..len(a[0])
        let row = []
        for i in 0..len(a)
            append(row, a[i][j])
        append(out, row)
    return out

fun det2(a)
    return a[0][0] * a[1][1] - a[0][1] * a[1][0]

fun show(title, m)
    print(title)
    for row in m
        print(row)

let a = [[1, 2], [3, 4]]
let b = [[5, 6], [7, 8]]
show("a", a)
show("b", b)
show("a * b", mul(a, b))
show("transpose a", transpose(a))
print("det a = {det2(a)}")
