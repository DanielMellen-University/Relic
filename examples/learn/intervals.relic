# Merge overlapping intervals: sort by start, then grow the last merged
# interval while the next one starts inside it.
#   relic examples/learn/intervals.relic
use std/lists

fun starts_first(a, b) = a[0] < b[0]

fun merge(spans)
    let sorted = lists.sort_by(spans, starts_first)
    let out = []
    for s in sorted
        if len(out) > 0 and s[0] <= out[len(out) - 1][1]
            let last = out[len(out) - 1]
            if s[1] > last[1]
                last[1] = s[1]
        else
            append(out, [s[0], s[1]])
    return out

print(merge([[1, 3], [8, 10], [2, 6], [15, 18]]))
print(merge([[1, 4], [4, 5]]))
print(merge([[5, 7], [1, 10], [2, 3]]))
print(merge([]))
