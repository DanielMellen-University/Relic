# One month, as a Sunday-first calendar. November 2026 starts on a Sunday.
#   relic examples/learn/calendar.relic
use std/strings

fun weekday(year, month, day)
    let y = year
    if month < 3
        y = y - 1
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    let n = y + int(y / 4) - int(y / 100) + int(y / 400) + t[month - 1] + day
    return n % 7

fun days_in(year, month)
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if month == 2 and year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
        return 29
    return lengths[month - 1]

fun month_name(month)
    let names = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    return names[month - 1]

fun show(year, month)
    print("{month_name(month)} {year}")
    print("Su Mo Tu We Th Fr Sa")
    let pad = weekday(year, month, 1)
    let line = strings.repeat("   ", pad)
    let col = pad
    for day in 1..(days_in(year, month) + 1)
        line = line + strings.pad_left(str(day), 2, " ")
        col = col + 1
        if col == 7
            print(line)
            line = ""
            col = 0
        else
            line = line + " "
    if col != 0
        print(strings.trim_end(line))

show(2026, 11)
