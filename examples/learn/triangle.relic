# Name a triangle from its three sides: equilateral, isosceles or scalene, or
# not a triangle when one side is too long. A right angle is noted too.
#   relic examples/learn/triangle.relic
use std/lists

fun kind(sides)
    let s = lists.sort(sides)
    if s[0] <= 0 or s[0] + s[1] <= s[2]
        return "not a triangle"
    let name = "scalene"
    if s[0] == s[2]
        name = "equilateral"
    else if s[0] == s[1] or s[1] == s[2]
        name = "isosceles"
    if s[0] * s[0] + s[1] * s[1] == s[2] * s[2]
        name = name + ", right"
    return name

for t in [[3, 3, 3], [3, 4, 4], [3, 4, 5], [5, 12, 13], [1, 1, 3], [2, 3, 4], [0, 1, 1]]
    print("{t}: {kind(t)}")
