# Length of the longest common subsequence of two strings.
#   relic examples/learn/lcs.relic

fun lcs(a, b)
    let rows = []
    for i in 0..(len(a) + 1)
        let row = []
        for j in 0..(len(b) + 1)
            append(row, 0)
        append(rows, row)
    for i in 1..(len(a) + 1)
        for j in 1..(len(b) + 1)
            if a[i - 1] == b[j - 1]
                rows[i][j] = rows[i - 1][j - 1] + 1
            else if rows[i - 1][j] >= rows[i][j - 1]
                rows[i][j] = rows[i - 1][j]
            else
                rows[i][j] = rows[i][j - 1]
    return rows[len(a)][len(b)]

print(lcs("kitten", "sitting"))
print(lcs("abc", "abc"))
print(lcs("abc", "def"))
print(lcs("", "abc"))
print(lcs("XMJYAUZ", "MZJAWXU"))
