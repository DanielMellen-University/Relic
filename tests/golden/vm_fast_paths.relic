# The VM's fast paths must match the slow ones: overflow, signs, floats,
# counting loops, and scopes that closures keep.
let big = 9223372036854775807
try
    print(big + 1)
catch e
    print(e.message)
try
    print(big * 2)
catch e
    print(e.message)
print(-7 % 3, 7 % -3, -7 % -3, 7 % 3)
try
    print(5 % 0)
catch e
    print(e.message)
print(7 / 2, 6 / 3, 2 * 3, 2 <= 2, 3 >= 4, 1 == 1, 1 != 1)
print(1.5 + 2.5, 1.5 * 2.0, 0.5 < 0.25, 2.0 == 2.0, 1 == 1.0, 1 < 1.5)
print("a" < "b", "a" == "a", [1] == [1])
let fs = []
for i in 0..4
    let k = i * 10
    fun get() = k + i
    append(fs, get)
    if i == 2
        break
for f in fs
    print(f())
let total = 0
for i in -3..3
    if i == 0
        next
    total = total + i
print(total)
for i in 5..2
    print("never")
fun count(n)
    let c = 0
    for i in 0..n
        let sq = i * i
        c = c + sq
    return c
print(count(10), count(0))
try
    for i in 0..1.5
        print(i)
catch e
    print(e.message)
