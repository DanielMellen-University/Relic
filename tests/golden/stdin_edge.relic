# Long lines, a NUL byte, bytes that are not UTF-8, a Ctrl-Z byte (0x1A, which
# a Windows text-mode stdin would take for the end of the input), and an empty last line.
# A long line is described by its length and three characters (a loop over it would
# make the slow self-hosted interpreter take seconds); a short one also by a checksum.
use std/os
fun sum(s)
    let t = 0
    for c in s
        t = (t * 31 + ord(c)) % 1000003
    return t
let n = 0
while true
    let line = os.read_line()
    if line == none
        break
    n = n + 1
    if len(line) > 100
        print(n, len(line), line[0], line[100], line[len(line) - 1])
    else
        print(n, len(line), sum(line))
print("lines", n)
