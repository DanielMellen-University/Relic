print(1 + 2 == 3, not 1 == 2, -2 * 3, 10 % 3 * 2, 2 * 3 % 4)
print(true and false or true, not true and false)
let x = [1, 2]
print(x + [3], "a" + "b", 1.5 + 1.5)
try
    print("a" * 2)
catch e
    print(e.message)
try
    print([1] * 2)
catch e
    print(e.message)
try
    print(1 + "a")
catch e
    print(e.message)
