print(slice("abcdef", 2, 2), slice("abcdef", 0, 0), slice([1, 2], 5, 9), slice([1, 2], 1, 99))
print(slice("abcdef", -3, -1), slice("abcdef", 3, 100))
try
    print(slice("abc", 1.5, 2))
catch e
    print(e.message)
try
    print(slice(5, 0, 1))
catch e
    print(e.message)
print(slice("héllo", 1, 3), slice("héllo", 0, 1))
