# The call limit counts Relic functions only: the 800th frame can still call
# built-ins (str, len, print, append). `reached` is the deepest frame that got
# past its built-in calls.
let depth = 0
let reached = 0
let log = []

fun down(n)
    depth = depth + 1
    let s = str(depth)
    append(log, len(s))
    reached = depth
    down(n + 1)
    depth = depth - 1

try
    down(0)
catch e
    print(e.message)
print(depth, reached, len(log))

# the same with a loop and a try around the call
depth = 0
reached = 0
fun loop_down(n)
    depth = depth + 1
    for i in [1]
        try
            print_at_limit()
            loop_down(n + 1)
        catch e
            fail(e.message)
    depth = depth - 1

fun print_at_limit()
    reached = depth
    let t = str(depth) + "!"
    if depth == 800
        print("at the limit:", t)

try
    loop_down(0)
catch e
    print(e.message)
print(depth, reached)
