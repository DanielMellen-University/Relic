# Since 1.0.49: lists.contains, unique, min, max, any, all, flatten and zip.
use std/lists
print(lists.contains([1, 2], 1.0), lists.contains([], none), lists.contains([[1]], [1]), lists.contains(["a"], "A"))
print(lists.unique(["a", "b", "a", 1, 1.0, 2, [1], [1], none, none]), lists.unique([]))
# a long list of strings takes a map, not a search of what is kept
let many = []
for i in 0..3000
    append(many, "k" + str(i % 500))
print(len(lists.unique(many)), lists.unique(many)[499])
# lists.min and lists.max: by <, so ints and floats mix, strings compare, an
# empty list or a mix that < refuses is an error
print(lists.min([3, 1.5, 2]), lists.max([3, 1.5, 2]), lists.max(["b", "a", "c"]), lists.min([5]), lists.max([-0.0, 0]))
for xs in [[], [1, "a"], [[1], [2]]]
    try
        print(lists.min(xs))
    catch e
        print("ERR", e.message)
    try
        print(lists.max(xs))
    catch e
        print("ERR", e.message)
# any and all stop at the first item that decides
fun big(x) = x > 2
fun is_a(c) = c == "a"
let seen = []
fun noted(x)
    append(seen, x)
    return x > 2
print(lists.any([1, 2, 3], big), lists.any([1, 2], big), lists.any([], big), lists.all([3, 4], big), lists.all([3, 1], big), lists.all([], big))
print(lists.any([1, 5, 9], noted), lists.copy(seen))
seen = []
print(lists.all([5, 1, 9], noted), seen)
# flatten takes out one level only
print(lists.flatten([[1, 2], [], 3, [[4]], "ab", {k: 1}]), lists.flatten([]), lists.flatten([[[]]]))
# zip stops at the shorter one; strings and maps (keys) are walked too
print(lists.zip([1, 2, 3], ["a", "b"]), lists.zip([], [1]), lists.zip("ab", {x: 1, y: 2, z: 3}))
# count and chunk (since 1.0.50)
print(lists.count([1, 1.0, "1", [1], 1], 1), lists.count([], 1), lists.count("banana", "a"), lists.count([[1], [1]], [1]))
print(lists.chunk([1, 2, 3, 4, 5], 2), lists.chunk([], 3), lists.chunk("abc", 5), lists.chunk([1, 2], 1))
for n in [0, -1, 1.5, "2"]
    try
        lists.chunk([1], n)
    catch e
        print(e.message)
# find gives the first match or none (since 1.0.50)
fun big(x) = x > 2
fun is_a(c) = c == "a"
print(lists.find([1, 3, 5], big), lists.find([1, 2], big), lists.find([], big), lists.find("xay", is_a))
print(lists.find_index([1, 3, 5], big), lists.find_index([1, 2], big), lists.find_index("bca", is_a))
# take and drop (since 1.0.50)
print(lists.take([1, 2, 3], 2), lists.take([1], 5), lists.take("abc", 0), lists.drop([1, 2, 3], 2), lists.drop([1], 5), lists.drop("abc", 1))
for n in [-1, 1.5, "1"]
    try
        lists.take([1], n)
    catch e
        print(e.message)
try
    lists.drop([1], -2)
catch e
    print(e.message)
print(lists.partition([1, 3, 2, 5], big), lists.partition([], big), lists.partition("banana", is_a))
