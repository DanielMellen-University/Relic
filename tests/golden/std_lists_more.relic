# Since 1.0.49: lists.contains, unique, min, max, any, all, flatten and zip.
use std/lists
print(lists.contains([1, 2], 1.0), lists.contains([], none), lists.contains([[1]], [1]), lists.contains(["a"], "A"))
print(lists.unique(["a", "b", "a", 1, 1.0, 2, [1], [1], none, none]), lists.unique([]))
# a long list of strings takes a map, not a search of what is kept
let many = []
for i in 0..1000
    append(many, "k" + str(i % 250))
print(len(lists.unique(many)), lists.unique(many)[249])
# lists.min and lists.max: by <, so ints and floats mix, strings compare, an
# empty list or a mix that < refuses is an error
print(lists.min([3, 1.5, 2]), lists.max([3, 1.5, 2]), lists.max(["b", "a", "c"]), lists.min([5]), lists.max([-0.0, 0]))
for xs in [[], [1, "a"], [[1], [2]]]
    try
        print(lists.min(xs))
    catch e
        print("ERR", e.message)
    try
        print(lists.max(xs))
    catch e
        print("ERR", e.message)
# any and all stop at the first item that decides
fun big(x) = x > 2
fun is_a(c) = c == "a"
let seen = []
fun noted(x)
    append(seen, x)
    return x > 2
print(lists.any([1, 2, 3], big), lists.any([1, 2], big), lists.any([], big), lists.all([3, 4], big), lists.all([3, 1], big), lists.all([], big))
print(lists.any([1, 5, 9], noted), lists.copy(seen))
seen = []
print(lists.all([5, 1, 9], noted), seen)
# flatten takes out one level only
print(lists.flatten([[1, 2], [], 3, [[4]], "ab", {k: 1}]), lists.flatten([]), lists.flatten([[[]]]))
# zip stops at the shorter one; strings and maps (keys) are walked too
print(lists.zip([1, 2, 3], ["a", "b"]), lists.zip([], [1]), lists.zip("ab", {x: 1, y: 2, z: 3}))
# count and chunk (since 1.0.50)
print(lists.count([1, 1.0, "1", [1], 1], 1), lists.count([], 1), lists.count("banana", "a"), lists.count([[1], [1]], [1]))
print(lists.chunk([1, 2, 3, 4, 5], 2), lists.chunk([], 3), lists.chunk("abc", 5), lists.chunk([1, 2], 1))
for n in [0, -1, 1.5, "2"]
    try
        lists.chunk([1], n)
    catch e
        print(e.message)
# find gives the first match or none (since 1.0.50)
fun big(x) = x > 2
fun is_a(c) = c == "a"
print(lists.find([1, 3, 5], big), lists.find([1, 2], big), lists.find([], big), lists.find("xay", is_a))
print(lists.find_index([1, 3, 5], big), lists.find_index([1, 2], big), lists.find_index("bca", is_a))
# take and drop (since 1.0.50)
print(lists.take([1, 2, 3], 2), lists.take([1], 5), lists.take("abc", 0), lists.drop([1, 2, 3], 2), lists.drop([1], 5), lists.drop("abc", 1))
for n in [-1, 1.5, "1"]
    try
        lists.take([1], n)
    catch e
        print(e.message)
try
    lists.drop([1], -2)
catch e
    print(e.message)
print(lists.partition([1, 3, 2, 5], big), lists.partition([], big), lists.partition("banana", is_a))
print(lists.product([2, 3, 4]), lists.product([]), lists.product([1.5, 2]), lists.product([5, 0, 7]))
# group_by (since 1.0.50)
fun first_letter(w) = w[0]
fun same(x) = x
print(lists.group_by(["apple", "bean", "avocado", "beet", "corn"], first_letter), lists.group_by([], first_letter))
try
    lists.group_by([1], same)
catch e
    print(e.message)
# min_by and max_by (since 1.0.50): the first of equal keys
print(lists.min_by(["ccc", "a", "bb", "d"], len), lists.max_by(["ccc", "a", "bbb"], len), lists.max_by([3, -7, 5], same))
try
    lists.max_by([], len)
catch e
    print(e.message)
# last (since 1.0.50)
print(lists.last([1, 2, 3]), lists.last("abc"), lists.last([[1]]))
try
    lists.last([])
catch e
    print(e.message)
# windows (since 1.0.50): runs of n in a row
print(lists.windows([1, 2, 3, 4], 2), lists.windows([1, 2], 3), lists.windows("abc", 3), lists.windows([], 1))
try
    lists.windows([1], 0)
catch e
    print(e.message)
# mean (since 1.0.50): always a float
print(lists.mean([1, 2, 3, 4]), lists.mean([5]), lists.mean([0.5, -0.5]))
try
    lists.mean([])
catch e
    print(e.message)
# The 1.0.50 list functions walk a string's characters and a map's keys too
let km = {a: 1, b: 2, c: 3}
print(lists.take(km, 2), lists.drop(km, 2), lists.windows(km, 2), lists.last("xyz"), lists.find(km, is_a))
print(lists.group_by("banana", same), lists.partition("abcab", is_a), lists.min_by(km, same), lists.max_by("hello", same))
# rotate (since 1.0.50): wraps, and a negative count goes the other way
print(lists.rotate([1, 2, 3], 1), lists.rotate([1, 2, 3], -1), lists.rotate([1, 2, 3], 4), lists.rotate([], 2), lists.rotate("abc", 2))
try
    lists.rotate([1], 1.5)
catch e
    print(e.message)
# sum_by (since 1.0.50)
print(lists.sum_by(["ab", "c", ""], len), lists.sum_by([], len), lists.sum_by([[1, 2], [3]], len))
# count_by (since 1.0.50): counts per key, keys in first-seen order
print(lists.count_by(["pear", "apple", "plum", "fig"], first_letter), lists.count_by([], first_letter))
try
    lists.count_by([1, 2], same)
catch err
    print(err.message)
# windows longer than the list gives no runs; rotate on an empty list and by
# a multiple of the length; mean of floats and of one item
print(lists.windows([1, 2], 3), lists.windows([1, 2], 2), lists.rotate([], 3), lists.rotate([1, 2, 3], 3), lists.rotate([1, 2, 3], -4))
print(lists.mean([0.5, 1.5]), lists.mean([7]), lists.mean([-2, 2]))
# count_by walks a string's characters and a map's keys like the other list
# functions
print(lists.count_by("banana", same), lists.count_by({apple: 1, avocado: 2, fig: 3}, first_letter))
# Since 1.0.52 reverse, copy, sort and sort_by take a string's characters or a
# map's keys too, like the other helpers, and give a list
let km = {b: 1, a: 2, c: 3}
fun later(a, b) = b < a
print(lists.reverse(km), lists.copy(km), lists.sort(km), lists.sort_by(km, later))
print(lists.reverse("héllo"), lists.copy("ab"), lists.sort("cab"), lists.sort_by("cab", lists.natural))
# min_by and max_by call key once for each item (the first was keyed twice
# before 1.0.52)
let key_calls = {n: 0}
fun counted_len(s)
    key_calls.n = key_calls.n + 1
    return len(s)
print(lists.min_by(["ccc", "a", "bb", "z"], counted_len), key_calls.n, lists.max_by({ab: 1, c: 2}, counted_len), key_calls.n)
# unique on numbers looks them up (since 1.0.52) and keeps the same rules: ==,
# so 1 and 1.0 and -0.0 and 0 match, the first is kept, nan never matches,
# and big ints and fractions still compare with ==
let nan2 = 1e308 * 10 - 1e308 * 10
print(lists.unique([1, 1.0, 2.5, 2.5, -0.0, 0, nan2, nan2, 9007199254740993, 9007199254740992.0, 9007199254740992, "1", 1, [1], [1.0], 3.0, 3]))
let nums = []
for i in 0..1000
    append(nums, i % 300)
print(len(lists.unique(nums)), lists.unique(nums)[299])
