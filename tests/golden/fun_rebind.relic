# A later fun of the same name replaces it. A value that already held the
# first function keeps that function.
fun f()
    return 1
let g = f
fun f()
    return 2
print(g(), f())
print(g == f)

fun make()
    fun h()
        return 1
    let saved = h
    fun h()
        return 2
    return [saved, h]

let pair = make()
print(pair[0](), pair[1]())
