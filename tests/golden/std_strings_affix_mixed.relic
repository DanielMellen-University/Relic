use std/strings
fun show(f)
    try
        print(f())
    catch e
        print(e.message)
fun a() = strings.starts_with("abc", ["a"])
fun b() = strings.starts_with(["a", "b"], "a")
fun c() = strings.ends_with("abc", ["c"])
fun d() = strings.ends_with(["a", "b"], "b")
fun e() = strings.starts_with("abc", [])
fun f() = strings.ends_with([], "")
fun g() = strings.starts_with("abc", "ab")
fun h() = strings.ends_with([1, 2, 3], [2, 3])
fun i() = strings.starts_with("", "")
fun j() = strings.remove_prefix("abc", "ab")
show(a)
show(b)
show(c)
show(d)
show(e)
show(f)
show(g)
show(h)
show(i)
show(j)
