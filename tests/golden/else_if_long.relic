for x in [0, 1, 2, 99, 150, 199, 200, 201, -1]
    print(x, pick(x))

# an error in a later condition still points at it
let y = "s"
try
    if y == 1
        print(1)
    else if y == 2
        print(2)
    else if y > 3
        print(3)
    else
        print(4)
catch e
    print(e.message)

# break and next from inside a branch
for i in 0..6
    if i == 1
        next
    else if i == 2
        print("two")
    else if i == 4
        break
    else
        print("i", i)
print("end")

# no branch runs and there is no else
let z = 5
if z == 1
    print("one")
else if z == 2
    print("two")
print("none ran")
