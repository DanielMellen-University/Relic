# insertion sort on numbers, then on strings
fun sort(items)
    let out = []
    for x in items
        append(out, x)
    let i = 1
    while i < len(out)
        let j = i
        while j > 0 and out[j - 1] > out[j]
            let tmp = out[j]
            out[j] = out[j - 1]
            out[j - 1] = tmp
            j = j - 1
        i = i + 1
    return out

let nums = [5, 3, 9, 1, 7, 2, 8, 2]
print(sort(nums))
print(nums)
print(sort(["pear", "apple", "fig", "banana"]))
print(sort([]))
