# std/strings on empty and odd inputs: results, and the errors for bad arguments
use std/strings

fun show_error(f)
    try
        f()
    catch e
        print("error:", e.message)

print(strings.split("", ","), strings.split(",", ","), strings.split("a,b,,c", ","))
print(strings.split("a--b--", "--"), strings.split("abc", ""), strings.split("héé", ""))
print(strings.join([], ","), strings.join(["a"], ","), strings.join([1, 2.5, true], "-"))
print(strings.find("abc", ""), strings.find("", "a"), strings.find("héllo wörld", "wör"))
print(strings.contains("abc", ""), strings.starts_with("ab", "abc"), strings.ends_with("ab", "abc"))
print(strings.replace("aaa", "aa", "b"), strings.replace("abc", "", "-"), strings.replace("", "a", "b"))
print("[{strings.repeat("ab", 0)}] [{strings.repeat("ab", -1)}] [{strings.repeat("é", 3)}]")
print(strings.pad_left("abc", 2, "x"), strings.pad_left("7", 3, "0"), strings.pad_left("abc", 6, "xy"))
print(strings.pad_right("é", 3, "-"), strings.pad_right("abc", 3, "-"), strings.pad_right("", 2, "ab"))
print(strings.pad_left("abc", 3, ""), strings.pad_right("abc", 2, ""))
print(strings.upper("héllo ß"), strings.lower("HÉLLO"), strings.upper(""))
print("[{strings.trim("  \t\n x y \n")}] [{strings.trim("")}] [{strings.trim("   ")}]")

fun pad_left_empty() = strings.pad_left("abc", 6, "")
fun pad_right_empty() = strings.pad_right("", 1, "")
show_error(pad_left_empty)
show_error(pad_right_empty)

# text functions say what they got when it is not text
try
    print(strings.upper(5))
catch e
    print(e.message)
try
    print(strings.trim(none))
catch e
    print(e.message)
try
    print(strings.split("a,b", 1))
catch e
    print(e.message)
try
    print(strings.repeat([1], 2))
catch e
    print(e.message)

# repeat wants a whole count, pad_* a number width that is not +infinity (it padded
# forever) and text for the fill (since 1.0.35)
let inf = 1e308 * 10
for args in [["ab", 2.5], ["ab", "3"], ["ab", inf]]
    try
        print(strings.repeat(args[0], args[1]))
    catch e
        print(e.message)
for args in [["a", inf, "x"], ["a", "5", "x"], ["a", 5, 3], [5, 3, "x"], ["a", 2.5, "x"], ["a", inf - inf, "x"], ["a", 0 - inf, "x"]]
    try
        print(strings.pad_left(args[0], args[1], args[2]), strings.pad_right(args[0], args[1], args[2]))
    catch e
        print(e.message)

# long text (over 1024 characters) takes find's character-list path; repeat
# doubles and pad works out the count (all three were quadratic before 1.0.37)
let long = strings.repeat("ab", 520) + "XéZ"
print(strings.find(long, "éZ"), strings.find(long, ""), strings.find(long, "Zé"))
print(strings.pad_left("7", 41, "ab") == strings.repeat("ab", 20) + "7", len(strings.pad_right("x", 6.5, "ab")), strings.pad_left("x", 4, "abc"), strings.repeat("xy", 5), strings.repeat("q", 0), strings.repeat("q", -2), strings.repeat("ab", 3.0), strings.upper("aé") + strings.lower("ÉB"))
# long text where a near miss repeats: "aa...ab" in "aa...a" (it took time growing with both lengths)
let many_a = strings.repeat("a", 1200)
let near = strings.repeat("a", 30) + "b"
print(strings.find(many_a, near), strings.find(many_a + "b", near), len(strings.split(many_a + "b" + many_a + "b", near)), strings.find(many_a + "aab", "aab"))
