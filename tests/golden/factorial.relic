# recursion: factorial and Fibonacci
fun factorial(n)
    if n <= 1
        return 1
    return n * factorial(n - 1)

fun fib(n)
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

for n in [0, 1, 5, 10, 15]
    print("{n}! = {factorial(n)}")

let fibs = []
for i in 0..15
    append(fibs, fib(i))
print(fibs)
