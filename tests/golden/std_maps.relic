use std/maps
let m = {a: 1, b: 2}
print(maps.values(m), maps.items(m))
print(maps.get(m, "a", 0), maps.get(m, "z", 0))
print(maps.merge(m, {b: 3, c: 4}), m)
print(remove(m, "a"), m, keys(m))
# drop: in place, keeps the order of the rest, false for a missing key
let dm = {a: 1, b: 2, c: 3}
print(maps.drop(dm, "b"), maps.drop(dm, "zz"), dm, len(dm))
dm.b = 4
print(maps.drop(dm, "a"), dm)
# from_items (since 1.0.49) undoes items; a later pair wins
let m2 = {b: 1, a: [2]}
print(maps.from_items(maps.items(m2)), maps.from_items([]), maps.from_items([["k", 1], ["k", 2]]))
for bad in [[["a", 1], ["b"]], [[1, 2]], ["ab"], 5]
    try
        maps.from_items(bad)
    catch e
        print(e.message)
# invert (since 1.0.50): values to keys, the later key winning
print(maps.invert({a: "x", b: "y"}), maps.invert({}), maps.invert({a: "same", b: "same"}))
for bad in [{a: 1}, [1]]
    try
        maps.invert(bad)
    catch e
        print(e.message)
# map_values (since 1.0.50): same keys, same order, a new map
fun twice(v) = v * 2
let src = {b: 1, a: 2}
let doubled = maps.map_values(src, twice)
print(doubled, src, maps.map_values({}, twice), keys(doubled))
# filter (since 1.0.50): keep gets the key and the value
fun small(k, v) = v < 3
fun not_a(k, v) = k != "a"
print(maps.filter({x: 1, y: 5, z: 2}, small), maps.filter({a: 1, b: 9}, not_a), maps.filter({}, small))
# pick (since 1.0.50): in the order asked for; missing keys left out
print(maps.pick({a: 1, b: 2, c: 3}, ["c", "a", "q"]), maps.pick({a: 1}, []), maps.pick({}, ["a"]))
try
    maps.pick({a: 1}, "a")
catch e
    print(e.message)
# merge keeps a's order and adds b's new keys after; a value of none is kept,
# and get gives it back rather than the fallback
let mixed = maps.merge({z: 1, a: none}, {a: 2, q: none})
print(mixed, keys(mixed), maps.get({k: none}, "k", 5), maps.get({}, "k", 5))
