fun summarize(text, required = [])
    append(required, text)
    return required

print(summarize("a"))
print(summarize("b"))
print(summarize("c", ["z"]))

fun add(a, b = a + 1)
    return b

print(add(2), add(2, 9))

let n = 0

fun nxt()
    n = n + 1
    return n

fun tick(x = nxt())
    return x

print(tick(7), n)
print(tick(), n)

fun make(k)
    fun inc(x = k)
        return x + 1
    return inc

let g = make(10)
print(g(), g(3))

fun take(m as int = 2) = m
print(take(), take(4))

fun pair(a = 1, b = a + 1)
    return b

print(pair(), pair(4), pair(4, 9))
