# Since 1.0.49 the std functions name themselves when they get the wrong kind
# of value, instead of failing inside with "cannot loop over an int".
use std/paths
use std/maps
for f in ["join", "join2", "base", "dir", "ext", "stem", "normalize"]
    try
        if f == "join"
            paths.join(1, "a")
        else if f == "join2"
            paths.join("a", none)
        else if f == "base"
            paths.base(none)
        else if f == "dir"
            paths.dir([1])
        else if f == "ext"
            paths.ext(2.5)
        else if f == "stem"
            paths.stem(true)
        else
            paths.normalize(3)
    catch e
        print(e.message)

for f in ["values", "items", "get", "merge", "merge2", "drop"]
    try
        if f == "values"
            maps.values(5)
        else if f == "items"
            maps.items("ab")
        else if f == "get"
            maps.get([1], "a", 2)
        else if f == "merge"
            maps.merge(none, {a: 1})
        else if f == "merge2"
            maps.merge({a: 1}, 5)
        else
            maps.drop(5, "a")
    catch e
        print(e.message)
print(maps.get({a: 1}, "a", 2), maps.merge({}, {b: 2}))
