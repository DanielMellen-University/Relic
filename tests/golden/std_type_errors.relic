# Since 1.0.49 the std functions name themselves when they get the wrong kind
# of value, instead of failing inside with "cannot loop over an int".
use std/paths
for f in ["join", "join2", "base", "dir", "ext", "stem", "normalize"]
    try
        if f == "join"
            paths.join(1, "a")
        else if f == "join2"
            paths.join("a", none)
        else if f == "base"
            paths.base(none)
        else if f == "dir"
            paths.dir([1])
        else if f == "ext"
            paths.ext(2.5)
        else if f == "stem"
            paths.stem(true)
        else
            paths.normalize(3)
    catch e
        print(e.message)
