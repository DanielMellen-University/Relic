# Since 1.0.49 the std functions name themselves when they get the wrong kind
# of value, instead of failing inside with "cannot loop over an int".
use std/paths
use std/maps
use std/lists
for f in ["join", "join2", "base", "dir", "ext", "stem", "normalize"]
    try
        if f == "join"
            paths.join(1, "a")
        else if f == "join2"
            paths.join("a", none)
        else if f == "base"
            paths.base(none)
        else if f == "dir"
            paths.dir([1])
        else if f == "ext"
            paths.ext(2.5)
        else if f == "stem"
            paths.stem(true)
        else
            paths.normalize(3)
    catch e
        print(e.message)

for f in ["values", "items", "get", "merge", "merge2", "drop"]
    try
        if f == "values"
            maps.values(5)
        else if f == "items"
            maps.items("ab")
        else if f == "get"
            maps.get([1], "a", 2)
        else if f == "merge"
            maps.merge(none, {a: 1})
        else if f == "merge2"
            maps.merge({a: 1}, 5)
        else
            maps.drop(5, "a")
    catch e
        print(e.message)
print(maps.get({a: 1}, "a", 2), maps.merge({}, {b: 2}))

fun same(y) = y
fun yes(y) = true
fun first(a, b) = a
let bad = [5, 2.5, none, true]
let i = 0
for f in ["map", "filter", "reduce", "sum", "index_of", "contains", "unique", "min", "max", "reverse", "copy", "sort_by", "sort"]
    let x = bad[i % len(bad)]
    i = i + 1
    try
        if f == "map"
            lists.map(x, same)
        else if f == "filter"
            lists.filter(x, yes)
        else if f == "reduce"
            lists.reduce(x, first, 0)
        else if f == "sum"
            lists.sum(x)
        else if f == "index_of"
            lists.index_of(x, 1)
        else if f == "contains"
            lists.contains(x, 1)
        else if f == "unique"
            lists.unique(x)
        else if f == "min"
            lists.min(x)
        else if f == "max"
            lists.max(x)
        else if f == "reverse"
            lists.reverse(x)
        else if f == "copy"
            lists.copy(x)
        else if f == "sort_by"
            lists.sort_by(x, lists.natural)
        else
            lists.sort(x)
    catch e
        print(e.message)
print(lists.map("ab", same), lists.reverse("abc"), lists.sort_by([3, 1, 2], lists.natural), lists.sum({}))
# the functions added since keep the same messages
for f in ["any", "all", "flatten", "zip", "zip2", "count", "chunk"]
    try
        if f == "any"
            lists.any(5, yes)
        else if f == "all"
            lists.all(none, yes)
        else if f == "flatten"
            lists.flatten(1.5)
        else if f == "zip"
            lists.zip(true, [1])
        else if f == "zip2"
            lists.zip([1], 7)
        else if f == "count"
            lists.count(none, 1)
        else
            lists.chunk(3, 1)
    catch e
        print(e.message)

# The lists functions added in 1.0.50 check xs the same way.
fun yes(x) = true
fun key(x) = "k"
for f in ["find", "find_index", "take", "drop", "partition", "product", "group_by"]
    try
        if f == "find"
            lists.find(1, yes)
        else if f == "find_index"
            lists.find_index(none, yes)
        else if f == "take"
            lists.take(2.5, 1)
        else if f == "drop"
            lists.drop(true, 1)
        else if f == "partition"
            lists.partition(9, yes)
        else if f == "product"
            lists.product(none)
        else
            lists.group_by(4, key)
    catch e
        print(e.message)

# The std/strings functions added in 1.0.50 say which argument is wrong.
use std/strings
for f in ["is_alpha", "words", "center", "center2", "remove_prefix"]
    try
        if f == "is_alpha"
            strings.is_alpha(7)
        else if f == "words"
            strings.words(["a b"])
        else if f == "center"
            strings.center(none, 3, " ")
        else if f == "center2"
            strings.center("a", "3", " ")
        else
            strings.remove_prefix(1, "a")
    catch e
        print(e.message)

# The std/maps and std/paths functions added in 1.0.50 check theirs too.
fun keep_all(k, v) = true
for f in ["map_values", "filter", "pick", "is_abs", "with_ext"]
    try
        if f == "map_values"
            maps.map_values([1], keep_all)
        else if f == "filter"
            maps.filter("ab", keep_all)
        else if f == "pick"
            maps.pick(none, ["a"])
        else if f == "is_abs"
            paths.is_abs(5)
        else
            paths.with_ext([], ".md")
    catch e
        print(e.message)

# min_by, max_by and last check xs, and capitalize its text, like the rest.
for f in ["min_by", "max_by", "last", "capitalize"]
    try
        if f == "min_by"
            lists.min_by(3, same)
        else if f == "max_by"
            lists.max_by(none, same)
        else if f == "last"
            lists.last(1.5)
        else
            strings.capitalize(["a"])
    catch e
        print(e.message)

# The rest of 1.0.50's additions: windows and mean check xs, hypot, radians
# and degrees their numbers, relative its paths.
use std/math
for f in ["windows", "mean", "hypot", "radians", "degrees", "relative"]
    try
        if f == "windows"
            lists.windows(5, 2)
        else if f == "mean"
            lists.mean("")
        else if f == "hypot"
            math.hypot(3, "4")
        else if f == "radians"
            math.radians(none)
        else if f == "degrees"
            math.degrees([1])
        else
            paths.relative("/a", 7)
    catch e
        print(e.message)

# truncate, is_upper, is_lower, rotate, sum_by, find_key and trunc too.
for f in ["truncate", "is_upper", "is_lower", "rotate", "sum_by", "find_key", "trunc"]
    try
        if f == "truncate"
            strings.truncate("abc", 2.5, "")
        else if f == "is_upper"
            strings.is_upper(1)
        else if f == "is_lower"
            strings.is_lower(none)
        else if f == "rotate"
            lists.rotate(3, 1)
        else if f == "sum_by"
            lists.sum_by(true, same)
        else if f == "find_key"
            maps.find_key([1], 1)
        else
            math.trunc("2")
    catch e
        print(e.message)
# the last three of 1.0.50: count_by, has_value and dist
for f in ["count_by", "has_value", "dist"]
    try
        if f == "count_by"
            lists.count_by(5, same)
        else if f == "has_value"
            maps.has_value(none, 1)
        else
            math.dist(0, 0, 1, none)
    catch e
        print(e.message)

# Since 1.0.52 maps.get, drop and pick name themselves for a key that is not a
# string (it was "map keys must be strings").
for f in ["get", "drop", "pick"]
    try
        if f == "get"
            maps.get({a: 1}, 1, "x")
        else if f == "drop"
            maps.drop({a: 1}, none)
        else
            maps.pick({a: 1}, ["a", 2.5])
    catch e
        print(e.message)

# Since 1.0.52 strings.join and replace name themselves too.
for f in ["join", "join_sep", "replace", "replace_old", "replace_new"]
    try
        if f == "join"
            strings.join(5, ",")
        else if f == "join_sep"
            strings.join(["a", "b"], 5)
        else if f == "replace"
            strings.replace(5, "a", "b")
        else if f == "replace_old"
            strings.replace("a", none, "b")
        else
            strings.replace("a,b", ",", 5)
    catch e
        print(e.message)

# starts_with and ends_with too (since 1.0.52); lists still work
print(strings.starts_with([1, 2, 3], [1, 2]), strings.ends_with([1, 2, 3], [3]), strings.starts_with("abc", "ab"), strings.ends_with("abc", ""))
for f in ["starts_with", "starts_with_pre", "ends_with", "ends_with_suf"]
    try
        if f == "starts_with"
            strings.starts_with(5, "a")
        else if f == "starts_with_pre"
            strings.starts_with("abc", none)
        else if f == "ends_with"
            strings.ends_with({a: 1}, "a")
        else
            strings.ends_with("abc", 3)
    catch e
        print(e.message)
