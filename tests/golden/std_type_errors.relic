# Since 1.0.49 the std functions name themselves when they get the wrong kind
# of value, instead of failing inside with "cannot loop over an int".
use std/paths
use std/maps
use std/lists
for f in ["join", "join2", "base", "dir", "ext", "stem", "normalize"]
    try
        if f == "join"
            paths.join(1, "a")
        else if f == "join2"
            paths.join("a", none)
        else if f == "base"
            paths.base(none)
        else if f == "dir"
            paths.dir([1])
        else if f == "ext"
            paths.ext(2.5)
        else if f == "stem"
            paths.stem(true)
        else
            paths.normalize(3)
    catch e
        print(e.message)

for f in ["values", "items", "get", "merge", "merge2", "drop"]
    try
        if f == "values"
            maps.values(5)
        else if f == "items"
            maps.items("ab")
        else if f == "get"
            maps.get([1], "a", 2)
        else if f == "merge"
            maps.merge(none, {a: 1})
        else if f == "merge2"
            maps.merge({a: 1}, 5)
        else
            maps.drop(5, "a")
    catch e
        print(e.message)
print(maps.get({a: 1}, "a", 2), maps.merge({}, {b: 2}))

fun same(y) = y
fun yes(y) = true
fun first(a, b) = a
let bad = [5, 2.5, none, true]
let i = 0
for f in ["map", "filter", "reduce", "sum", "index_of", "contains", "unique", "min", "max", "reverse", "copy", "sort_by", "sort"]
    let x = bad[i % len(bad)]
    i = i + 1
    try
        if f == "map"
            lists.map(x, same)
        else if f == "filter"
            lists.filter(x, yes)
        else if f == "reduce"
            lists.reduce(x, first, 0)
        else if f == "sum"
            lists.sum(x)
        else if f == "index_of"
            lists.index_of(x, 1)
        else if f == "contains"
            lists.contains(x, 1)
        else if f == "unique"
            lists.unique(x)
        else if f == "min"
            lists.min(x)
        else if f == "max"
            lists.max(x)
        else if f == "reverse"
            lists.reverse(x)
        else if f == "copy"
            lists.copy(x)
        else if f == "sort_by"
            lists.sort_by(x, lists.natural)
        else
            lists.sort(x)
    catch e
        print(e.message)
print(lists.map("ab", same), lists.reverse("abc"), lists.sort_by([3, 1, 2], lists.natural), lists.sum({}))
