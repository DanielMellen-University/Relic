use std/time
use std/math
let t = time.clock()
print(time.since(t) >= 0, time.now() > 1700000000)
print(math.abs(-3), math.min(2, 5), math.max(2, 5), math.clamp(12, 0, 10))
print(math.floor(2.7), math.ceil(2.1), math.round(2.5), math.sqrt(16), math.pow(2, 10))
print(math.round(math.sin(math.pi / 2)), math.cos(0), math.is_whole(3), math.round(math.log(math.e)))
