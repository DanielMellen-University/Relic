use std/time
use std/math
let t = time.clock()
print(time.since(t) >= 0, time.now() > 1700000000)
print(math.abs(-3), math.min(2, 5), math.max(2, 5), math.clamp(12, 0, 10))
print(math.floor(2.7), math.ceil(2.1), math.round(2.5), math.sqrt(16), math.pow(2, 10))
print(math.round(math.sin(math.pi / 2)), math.cos(0), math.is_whole(3), math.round(math.log(math.e)))
# Since 1.0.52 limit wants an fps above 0 (0 was a division by zero) and since
# a number; a frame that is already late does not sleep
let tm = time.timer()
for fps in [0, -5, "60", none]
    try
        time.limit(tm, fps)
    catch e
        print(e.message)
try
    time.since("now")
catch e
    print(e.message)
tm.last = time.clock() - 1
time.limit(tm, 60)
print("late frame ok")
# a t that is not a timer names the function (since 1.0.52)
for bad in [5, {fps: 0}]
    try
        time.tick(bad)
    catch e
        print(e.message)
try
    time.limit(none, 60)
catch e
    print(e.message)
