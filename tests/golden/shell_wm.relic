# the desktop model in shell/wm.relic, driven by fake clicks and keys
use ../../shell/wm
let d = wm.new_desktop(640, 480, wm.default_apps())
fun show(d)
    let names = []
    for w in d.windows
        append(names, "{w.app.name}#{w.id}")
    print(names, "menu", d.menu_open)
print(wm.click(d, 10, 470))
show(d)
let b = wm.menu_item_box(d, 0)
print(wm.click(d, b[0] + 5, b[1] + 5))
show(d)
let w = wm.focused(d)
print(wm.click(d, w.x + 10, w.y + 30), wm.click(d, w.x + 10, w.y + 30))
print(w.app.lines(w.state)[0])
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 1)
print(wm.click(d, b[0] + 5, b[1] + 5))
for k in ["h", "i", "space", "x", "backspace", "!"]
    wm.key(d, k)
print(wm.focused(d).app.lines(wm.focused(d).state)[1])
b = wm.tab_box(d, 0)
print(wm.click(d, b[0] + 5, b[1] + 5))
show(d)
let cb = wm.close_box(wm.focused(d))
print(wm.click(d, cb[0] + 2, cb[1] + 2))
show(d)
print(wm.click(d, 600, 100), wm.click(d, 300, 470))
try
    print(wm._inside)
catch e
    print(e.message)

# drag by title bar
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 0)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
let ox = w.x
let oy = w.y
print(wm.click(d, w.x + 20, w.y + 4), d.drag.mode)
wm.motion(d, w.x + 20 + 50, w.y + 4 + 30)
print(w.x - ox, w.y - oy)
wm.release(d)
print(d.drag)

# resize from bottom-right grip
let rb = wm.resize_box(w)
let ow = w.width
let oh = w.height
print(wm.click(d, rb[0] + 2, rb[1] + 2), d.drag.mode)
wm.motion(d, w.x + ow + 40, w.y + wm.title_height + oh + 20)
print(w.width - ow, w.height - oh)
wm.release(d)

# clamp: drag far off the top-left, stay reachable
print(wm.click(d, w.x + 10, w.y + 4))
wm.motion(d, -500, -500)
print(w.x > -w.width, w.y >= 0)
wm.release(d)

# terminal app: help, echo, apps, clear (no date: non-deterministic)
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 2)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
print(w.app.name)
for k in ["h", "e", "l", "p", "return"]
    wm.key(d, k)
for k in ["e", "c", "h", "o", "space", "h", "i", "return"]
    wm.key(d, k)
for k in ["a", "p", "p", "s", "return"]
    wm.key(d, k)
let lines = w.app.lines(w.state)
print(lines[len(lines) - 2])
print(lines[len(lines) - 4])
for k in ["c", "l", "e", "a", "r", "return"]
    wm.key(d, k)
print(w.app.lines(w.state))

# Files: launch, list /home, enter / via .. then back
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 3)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
print(w.app.name)
print(w.app.lines(w.state)[0])
print(w.app.lines(w.state)[1])
print(w.app.lines(w.state)[2])
wm.key(d, "return")
print(w.app.lines(w.state)[0])
print(w.app.lines(w.state)[1])
wm.key(d, "return")
print(w.app.lines(w.state)[0])

# Editor: open welcome.txt, append, save, confirm via Files listing unchanged and re-read
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 4)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
print(w.app.name)
print(w.app.lines(w.state)[0])
for k in ["!", "ctrl+s"]
    wm.key(d, k)
print(w.app.lines(w.state)[0])
print(w.app.lines(w.state)[1])

# Terminal on the shared VFS: type a command line, then print what it added
fun run(d, text)
    let w = wm.focused(d)
    let before = len(w.state.buf)
    for c in text
        if c == " "
            wm.key(d, "space")
        else
            wm.key(d, c)
    wm.key(d, "return")
    for line in slice(w.state.buf, before, len(w.state.buf))
        print(line)

wm.click(d, 10, 470)
b = wm.menu_item_box(d, 2)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
let term = w
run(d, "help")
run(d, "pwd")
run(d, "ls")
run(d, "mkdir notes/old")
run(d, "cd notes")
run(d, "write todo.txt buy milk")
run(d, "echo call home >> todo.txt")
run(d, "cat todo.txt")
run(d, "touch empty.txt")
run(d, "ls")
run(d, "mv empty.txt old")
run(d, "ls old")
run(d, "echo draft > /tmp/plan.txt")
run(d, "cat ../../tmp/plan.txt")
run(d, "cd ..")
run(d, "pwd")
run(d, "cd")
run(d, "cd /")
run(d, "ls")
print(term.app.lines(term.state)[len(term.app.lines(term.state)) - 1])
run(d, "cd home")

# errors print a line and the terminal keeps going
run(d, "cat nope.txt")
run(d, "cd welcome.txt")
run(d, "rm notes")
run(d, "rm nope")
run(d, "mkdir welcome.txt/x")
run(d, "touch /no/such/file")
run(d, "mv nope x")
run(d, "mv notes notes/old")
run(d, "mv welcome.txt notes/todo.txt")
run(d, "cat")
run(d, "mv a")
run(d, "frob")
run(d, "rm notes/old/empty.txt")
run(d, "ls notes/old")
run(d, "rm notes/old")
run(d, "mv /tmp/plan.txt notes")
run(d, "ls notes")

# Terminal-made file shows in Files; opening it there sends it to Editor
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 3)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
print(w.app.lines(w.state))
wm.key(d, "down")
wm.key(d, "return")
print(w.app.lines(w.state))
for k in ["down", "down", "return"]
    wm.key(d, k)
wm.click(d, 10, 470)
b = wm.menu_item_box(d, 4)
print(wm.click(d, b[0] + 5, b[1] + 5))
w = wm.focused(d)
print(w.app.lines(w.state))

# Terminal removes the folder Files is in; Files falls back to the parent
let files = d.windows[len(d.windows) - 2]
print(files.app.name, files.state.path)
let t = wm.tabs(d)
for i in 0..len(t)
    if t[i].id == term.id
        b = wm.tab_box(d, i)
print(wm.click(d, b[0] + 5, b[1] + 5), wm.focused(d).app.name)
run(d, "rm notes/todo.txt")
run(d, "rm notes/plan.txt")
run(d, "rm notes")
print(files.app.lines(files.state))
