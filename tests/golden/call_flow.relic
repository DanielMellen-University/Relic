# Calls, returns and errors crossing function frames (the self-hosted
# interpreter runs these on one frame stack since 1.0.21).
fun f(n) as int
    if n > 2
        return "s"
    return n
print(f(1))
try
    print(f(3))
catch e
    print(e.message, e.line, e.col)

fun g()
    break
try
    g()
catch e
    print(e.message, e.line)

# an error deep in a call chain unwinds to the try in the caller
fun deep(n)
    if n == 0
        fail("bottom")
    return 1 + deep(n - 1)
try
    deep(40)
catch e
    print(e.message, e.line)

# a try inside a function catches; the call goes on and returns
fun safe(n)
    try
        return deep(n)
    catch e
        return "caught " + e.message
print(safe(5), safe(3) == "caught bottom")

let r = [1, 2]
for i in 0..10
    if i == 3
        next
    if i == 6
        break
    try
        r[i] = i
    catch e
        print("x", e.message)
print(r)

fun h(a as int) = a * 2
try
    h("q")
catch e
    print(e.message)
fun k() as string = 5
try
    k()
catch e
    print(e.message, e.col)

# calls inside expressions keep the values already worked out
fun two() = 2
let m = {a: [1, {b: 0}]}
m.a[two() - 1].b = h(4) + two() * 10
print(m, "{h(2)}-{two()}", [two(), [two() + 1]])
print(1 + two() * (3 - two()), two() == 2 and safe(0) != none)

# return from inside loops in a called function
fun first_even(xs)
    for x in xs
        while true
            if x % 2 == 0
                return x
            break
    return none
print(first_even([1, 3, 4, 6]), first_even([1]))

while true
    try
        fail("w")
    catch e
        break
print("end")
