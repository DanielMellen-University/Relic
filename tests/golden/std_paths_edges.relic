# std/paths on odd input: empty, root, doubled and trailing slashes, dots, backslashes.
use std/paths
for p in ["", "/", "//", "a//b", "./a", "a/.", "a/./b", "a/../b", "../a", "a/../../b", "/a/../..", "/a/b/", "a\\b\\..\\c", ".", "..", "./", "a/b/../..", "a/b/../../..", "/./a", "//a///b//"]
    print("[{p}] -> [{paths.normalize(p)}]")
for p in ["", "/", "a", "a/", "/a", "a/b.txt", "a.b/c", "a/.hidden", ".a.b", "a.", "a..b", "/x/y.tar.gz", "a\\b.c", "..", "a/..", "...a", "..a.b"]
    print("[{p}] base [{paths.base(p)}] dir [{paths.dir(p)}] ext [{paths.ext(p)}] stem [{paths.stem(p)}]")
for pr in [["", ""], ["a", ""], ["", "b"], ["/", "b"], ["a", "/b"], ["a/", "/b"], ["a\\", "b"], ["a", "b\\c"]]
    print(pr, paths.join(pr[0], pr[1]))
# "\" is "/" everywhere; ".." past the start stays in a relative path and goes in an absolute one
print(paths.normalize("a\\..\\..\\b/./c//"), paths.normalize("\\x\\..\\..\\y"), paths.ext("a.b\\c.d"), paths.ext("a.b\\c"), paths.base("x\\"))
# parts (since 1.0.50): the names after normalize, "/" first when absolute
print(paths.parts("/a/./b/../c/"), paths.parts("a//b"), paths.parts(""), paths.parts("/"), paths.parts("../x"), paths.parts("a\\b"))
try
    paths.parts(5)
catch e
    print(e.message)
# is_abs (since 1.0.50)
print(paths.is_abs("/a"), paths.is_abs("a/b"), paths.is_abs(""), paths.is_abs("\\x"), paths.is_abs("./a"), paths.is_abs("/"))
# with_ext (since 1.0.50): only the last ext is swapped
for p in ["a/b.txt", "b", ".hidden", "/x/y.tar.gz", "a.b/c", "a\\b.c"]
    print("[{p}] -> [{paths.with_ext(p, ".md")}] [{paths.with_ext(p, "")}]")
try
    paths.with_ext("a.txt", none)
catch e
    print(e.message)
# relative (since 1.0.50)
for pr in [["/a/b", "/a/c/d"], ["/a", "/a"], ["/", "/x/y"], ["/x/y", "/"], ["a/b", "a/b/c"], ["a", "b"], ["a/./b/", "a//b/../c"], [".", "a"]]
    print(pr, paths.relative(pr[0], pr[1]))
for pr in [["/a", "b"], ["a", "/b"], ["../a", "b"]]
    try
        paths.relative(pr[0], pr[1])
    catch e
        print(e.message)
# relative from a folder to itself and to a folder inside it; with_ext on a
# dotfile and on a name with two dots
print(paths.relative("/a/b", "/a/b"), paths.relative("/a", "/a/b/c"), paths.relative("a/b", "a"))
print(paths.with_ext(".bashrc", ".txt"), paths.with_ext("x.tar.gz", ".zip"), paths.with_ext("dir.d/file", ".md"))
