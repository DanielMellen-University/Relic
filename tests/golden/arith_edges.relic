# Arithmetic edges: division, remainder, float printing, mixed int and float.
print(7 / 2, -7 / 2, 7 / -2, 6 / 3, 7.0 / 2)
print(7 % 3, -7 % 3, 7 % -3, -7 % -3, 7.5 % 2)
print(1 / 3, 2 / 3, 10 / 4, 1e15, 1e16, 1.5e300)
print(0.1 + 0.2, 0.5 + 0.25, 3 * 1.5, 2 * 3.0)
print(1 + 2 * 3 - 4 / 2, (1 + 2) * 3, -2 * -3, - -4)
print(9007199254740993, 9007199254740993 + 0.0)
print(5 == 5.0, 5 != 5.0, 5 < 5.5, 5.5 >= 5, -1 < 0)
print(int(3.9), int(-3.9), int("42"), float(3), float("2.5"))
print(num("12"), num("1.50"), num("-0"), num("1e3"))
print(str(1.0), str(-0.0), str(100), str(true), str(none), str([1, "a"]))
