use std/vfs
let fs = vfs.new()
print(vfs.list(fs, "/"), vfs.list(fs, "/home"), vfs.list(fs, "/tmp"))
print(vfs.exists(fs, "/home/welcome.txt"), vfs.is_dir(fs, "/home"), vfs.is_dir(fs, "/home/welcome.txt"))
print(vfs.read(fs, "/home/welcome.txt"), vfs.size(fs, "/home/welcome.txt"))
vfs.write(fs, "/home/a.txt", "one")
vfs.append(fs, "/home/a.txt", "two")
print(vfs.read(fs, "/home/a.txt"))
vfs.make_dir(fs, "/home/sub/deep")
vfs.write(fs, "/home/sub/deep/x.txt", "x")
print(vfs.list(fs, "/home"), vfs.list(fs, "/home/sub/deep"))
vfs.rename(fs, "/home/a.txt", "/tmp/a.txt")
print(vfs.exists(fs, "/home/a.txt"), vfs.read(fs, "/tmp/a.txt"))
try
    vfs.remove(fs, "/home/sub")
catch err
    print(err.message)
vfs.remove_tree(fs, "/home/sub")
print(vfs.list(fs, "/home"), vfs.exists(fs, "/home/sub"))
vfs.remove(fs, "/tmp/a.txt")
print(vfs.list(fs, "/tmp"))
try
    vfs.read(fs, "/nope")
catch err
    print(err.message)
try
    vfs.list(fs, "/home/welcome.txt")
catch err
    print(err.message)
vfs.remove_tree(fs, "/no_such")
print("missing_ok")
print(vfs.exists(fs, "/home/./welcome.txt"), vfs.read(fs, "/home/../home/welcome.txt"))
vfs.make_dir(fs, "/home/box")
try
    vfs.rename(fs, "/home/box", "/home/box/inner")
catch err
    print(err.message)
print(vfs.is_dir(fs, "/home/box"), vfs.exists(fs, "/home/box/inner"))
# a path that goes through a file is not there; it does not crash
fs = vfs.new()
print(vfs.exists(fs, "/home/welcome.txt/x"), vfs.is_dir(fs, "/home/welcome.txt/x"))
try
    vfs.read(fs, "/home/welcome.txt/x")
catch err
    print(err.message)
try
    vfs.remove(fs, "/home/welcome.txt/x")
catch err
    print(err.message)
vfs.remove_tree(fs, "/home/welcome.txt/x")
try
    vfs.append(fs, "/home/welcome.txt/x", "t")
catch err
    print(err.message)
try
    vfs.size(fs, "/home/welcome.txt/x/y")
catch err
    print(err.message)
print(vfs.list(fs, "/home"))
# paths are read as if they started at /: "\" is "/", "." and doubled slashes go, ".." stops at the top
print(vfs.exists(fs, "home\\welcome.txt"), vfs.exists(fs, "../../home//./welcome.txt"), vfs.is_dir(fs, "tmp/../home/"))
try
    vfs.list(fs, "a\\..\\..\\b//c/.")
catch err
    print(err.message)
# list sorts the names (an odd count, so the last run merges alone)
fs = vfs.new()
for n in ["m", "b", "z", "a", "B", "aa", "é", "_", "0"]
    vfs.write(fs, "/tmp/" + n, n)
print(vfs.list(fs, "/tmp"))
# entries: [name, is_folder] in list's order
vfs.make_dir(fs, "/tmp/c/inner")
print(vfs.entries(fs, "/tmp"))
try
    vfs.entries(fs, "/tmp/z")
catch err
    print(err.message)
# a big folder: list keeps its sorted names, and any change shows next time
fs = vfs.new()
for i in 0..100
    vfs.write(fs, "/tmp/f{i}", "")
let first = vfs.list(fs, "/tmp")
append(first, "mine")
print(len(vfs.list(fs, "/tmp")), slice(vfs.list(fs, "/tmp"), 0, 4))
vfs.remove(fs, "/tmp/f10")
vfs.remove(fs, "/tmp/f5")
vfs.make_dir(fs, "/tmp/f5")
let es = vfs.entries(fs, "/tmp")
print(len(es), slice(es, 0, 4), es[len(es) - 1], vfs.list(fs, "/tmp")[2])
vfs.rename(fs, "/tmp/f99", "/tmp/a")
print(vfs.list(fs, "/tmp")[0], len(vfs.list(fs, "/tmp")))
