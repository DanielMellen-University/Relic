# std/math edges: negatives, halves, int against float results, errors.
use std/math
print(math.floor(-2.5), math.floor(-3), math.floor(0.0), math.floor(2.0))
print(math.ceil(-2.5), math.ceil(-3), math.ceil(2.0), math.ceil(2.000001))
print(math.round(-2.5), math.round(-2.4), math.round(-0.5), math.round(0.49), math.round(7))
print(math.abs(-0.0), math.abs(2.5), math.abs(-2.5), math.abs(0))
print(math.min(3, 3.0), math.max(3, 3.0), math.min(-1, 1), math.max(-1.5, -2))
print(math.clamp(-5, 0, 10), math.clamp(5, 0, 10), math.clamp(1.5, 0, 1))
print(math.sqrt(0), math.sqrt(2), math.pow(2, -1), math.pow(0, 0), math.pow(2.5, 2))
print(type(math.floor(2.5)), type(math.sqrt(4)), type(math.pow(2, 2)), type(math.abs(-2)))
print(math.is_whole(2.0), math.is_whole(2.5), math.is_whole(-4), math.is_whole(-0.5))
print(math.exp(0), math.log(1), math.cos(math.pi))
try
    print(math.floor("x"))
catch e
    print(e.message)
try
    print(math.sqrt("x"))
catch e
    print(e.message)
try
    print(math.abs("x"))
catch e
    print(e.message)
try
    print(math.ceil("x"))
catch e
    print(e.message)
try
    print(math.round([1]))
catch e
    print(e.message)
try
    print(math.abs(none))
catch e
    print(e.message)
try
    print(math.min(1, "a"))
catch e
    print(e.message)
try
    print(math.floor(1e30))
catch e
    print(e.message)
# pow checks the base first, then the power, on every engine (the host used to
# check the power first when both were wrong)
for args in [["a", "b"], ["a", 2], [2, "b"], [none, []], [2, 3]]
    try
        print(math.pow(args[0], args[1]))
    catch e
        print(e.message)

# floor, ceil and round: an int comes back as it is (past 2^53 it lost digits), round
# looks at the part over the floor (0.49999999999999994 gave 1), and nan, inf or a
# float past the int range is a math error (since 1.0.35)
let inf2 = 1e308 * 10
for x in [inf2, 0 - inf2, inf2 - inf2, 1e300, -1e300, "a", none, -0.5, -0.4, 0.5, 1.5, -1.5, -0.0, 9.2e18, -9.2e18, 9223372036854775807, -9223372036854775807 - 1, 2.0, -7.25]
    for f in [math.floor, math.ceil, math.round]
        try
            print(x, f(x))
        catch e
            print(x, e.message)
print(math.floor(9007199254740993), math.round(0.49999999999999994), math.round(4503599627370497.0))
