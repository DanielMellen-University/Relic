# Since 1.0.49: strings.count, find_last, lines, trim_start and trim_end, with
# their edges and errors.
use std/strings
use std/files
print(strings.count("a,b,,c", ","), strings.count("aaaa", "aa"), strings.count("", "x"), strings.count("éé", "é"))
print(strings.find_last("abcabc", "bc"), strings.find_last("aaa", "aa"), strings.find_last("abc", "x"), strings.find_last("abc", ""), strings.find_last("", ""), strings.find_last("ééa", "é"))
for f in [0, 1, 2]
    try
        if f == 0
            strings.count("a", "")
        else if f == 1
            strings.find_last(5, "a")
        else
            strings.count("a", 1)
    catch e
        print(e.message)
# long text: agree with find on one match (kept to 800 characters, since
# selfhost_interp runs this through the Relic-written interpreter)
let long = strings.repeat("ab", 400) + "c" + strings.repeat("ab", 10)
print(strings.find_last(long, "c"), strings.find(long, "c"), strings.count(long, "ab"), strings.find_last(long, "ab"))
# strings.lines: split at newlines, a "\r" before one dropped, no empty last
# line for text that ends with one; files.lines reads a file the same way
print(strings.lines("a\u{d}\nb\n\nc\n"), strings.lines(""), strings.lines("\n"), strings.lines("x"))
try
    strings.lines(none)
catch e
    print(e.message)
let p = "std_strings_more_lines.tmp"
files.write(p, "one\u{d}\ntwo\n\nthree\n")
print(files.lines(p), files.lines(p) == strings.lines(files.read(p)))
files.remove(p)
# trim_start and trim_end: the same spaces trim takes, one end each
let padded = " \t a b " + chr(13) + "\n"
fun shown(x) = [strings.replace(x, chr(13), "<CR>")]
print(shown(strings.trim_start(padded)), shown(strings.trim_end(padded)), [strings.trim_start("")], [strings.trim_end("   ")], strings.trim_end(strings.trim_start(padded)) == strings.trim(padded))
for f in ["trim_start", "trim_end"]
    try
        if f == "trim_start"
            strings.trim_start(5)
        else
            strings.trim_end(none)
    catch e
        print(e.message)
# reverse (since 1.0.50): whole characters, so text past ASCII stays readable
print(strings.reverse("abc"), strings.reverse(""), strings.reverse("héllo€"), strings.reverse(strings.reverse("a b\tc")) == "a b\tc")
try
    strings.reverse([1, 2])
catch e
    print(e.message)
# is_digits (since 1.0.50): ASCII 0 to 9 only, at least one
print(strings.is_digits("0123456789"), strings.is_digits(""), strings.is_digits("-1"), strings.is_digits("1.5"), strings.is_digits("١٢"), strings.is_digits("12 "))
# is_alpha (since 1.0.50): ASCII letters only, at least one
print(strings.is_alpha("abcXYZ"), strings.is_alpha(""), strings.is_alpha("ab1"), strings.is_alpha("é"), strings.is_alpha("a b"), strings.is_alpha("Z"))
# remove_prefix and remove_suffix (since 1.0.50): once, and only when there
print(strings.remove_prefix("v1.0.50", "v"), strings.remove_prefix("abc", "x"), strings.remove_prefix("aab", "a"), strings.remove_prefix("ab", ""), strings.remove_prefix("ab", "abc"))
print(strings.remove_suffix("main.relic", ".relic"), strings.remove_suffix("abc", "x"), strings.remove_suffix("abb", "b"), strings.remove_suffix("", ""))
try
    strings.remove_suffix("a", 1)
catch e
    print(e.message)
# words (since 1.0.50): split at runs of space, no empty pieces
print(strings.words("  a  b "), strings.words(""), strings.words(" \t\n "), strings.words("one"), strings.words("x" + chr(13) + "\ny\tz"))
