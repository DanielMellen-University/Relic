# SDL_ttf smoke test (ctest gfx_ttf): relic gfx_ttf.relic FONT.ttf
use std/graphics
print(graphics.has_fonts())
graphics.open(200, 60, "ttf")
let font = graphics.load_font(args()[0], 18)
graphics.font_text(font, 4, 4, "Hello é", 255, 255, 255)
let size = graphics.font_size(font, "Hello")
print("wide", size[0] > 20)
print("tall", size[1] >= 18)
print(type(size[0]), type(size[1]), graphics.font_size(font, "")[0])
graphics.text(4, 40, "built-in still works", 255, 255, 0)
graphics.present()
graphics.close()
print("done")
