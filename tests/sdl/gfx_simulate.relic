# SDL-only: extended simulate kinds (keyup, mods, move, mouseup, quit).
use std/graphics
graphics.open(80, 60, "simulate")
graphics.simulate("key", "a", "ctrl+shift")
graphics.simulate("keyup", "a", "ctrl")
graphics.simulate("move", 40, 50)
graphics.simulate("mousedown", 11, 22)
graphics.simulate("mouseup", 11, 22)
graphics.simulate("quit", none, none)
let e = graphics.next_event()
while e != none
    if e.type == "key_down"
        print("key_down", e.key, e.ctrl, e.shift, e.alt)
    else if e.type == "key_up"
        print("key_up", e.key, e.ctrl, e.shift, e.alt)
    else if e.type == "mouse_move"
        print("move", e.x, e.y, e.dx, e.dy)
    else if e.type == "mouse_down"
        print("down", e.button, e.x, e.y)
    else if e.type == "mouse_up"
        print("up", e.button, e.x, e.y)
    else if e.type == "quit"
        print("quit", graphics.quit_requested())
    e = graphics.next_event()
graphics.close()
print("done")
