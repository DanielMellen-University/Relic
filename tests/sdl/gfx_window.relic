# SDL-only: window title and size, fullscreen, cursor, vsync and frame timing,
# headless (ctest gfx_window). The dummy video driver has no real screen or
# cursors, so values it cannot honor are checked by type, not by value.
use std/graphics
graphics.open(120, 80, "first")
print(graphics.title())
graphics.set_title("second é")
print(graphics.title())
print(graphics.window_size())
print(type(graphics.scale()), graphics.scale() > 0)
let px = graphics.size()
print(px[0] == graphics.window_size()[0] * graphics.scale())
graphics.set_window_size(160, 100)
print(graphics.window_size())
print(graphics.fullscreen())
graphics.set_fullscreen(false)
print(graphics.fullscreen())
print(type(graphics.set_cursor("hand")), type(graphics.set_cursor("arrow")))
graphics.show_cursor(false)
print(graphics.cursor_visible())
graphics.show_cursor(true)
print(graphics.cursor_visible())
print(type(graphics.set_vsync(false)), type(graphics.vsync()))
let t0 = graphics.ticks()
print(type(t0), t0 >= 0)
print(graphics.frame_time())
graphics.present()
graphics.wait(20)
print(graphics.ticks() - t0 >= 15)
graphics.present()
print(type(graphics.frame_time()), graphics.frame_time() > 0.01)
graphics.present_capped(25)
print(graphics.frame_time() >= 0.035)
graphics.present_capped(1000)
print(graphics.frame_time() < 1)
graphics.close()
print("done")
