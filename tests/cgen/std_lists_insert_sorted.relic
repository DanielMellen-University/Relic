use std/lists
let xs = [1, 3, 5]
print(lists.insert_sorted(xs, 4), lists.insert_sorted(xs, 0), lists.insert_sorted(xs, 9), xs)
print(lists.insert_sorted([], "a"), lists.insert_sorted(["b", "d"], "c"), lists.insert_sorted("bd", "a"))
# after equal items: 2.0 goes after the 2, and 2 after the 2.0
print(lists.insert_sorted([1, 2, 3], 2.0), lists.insert_sorted([1, 2.0, 3], 2))
# adding one at a time gives what sort gives, ties in arrival order
let items = [5, 1, 4, 1.0, 3, 5.0, 2]
let built = []
for x in items
    built = lists.insert_sorted(built, x)
print(built, built == lists.sort(items))
let same = true
let i = 0
for x in lists.sort(items)
    if type(x) != type(built[i])
        same = false
    i = i + 1
print(same)
try
    lists.insert_sorted([1], [2])
catch e
    print(e.message)
