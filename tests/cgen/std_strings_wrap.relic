use std/strings
print(strings.wrap("one two three four", 7))
print(strings.wrap("longword x y", 3))
print(strings.wrap("a  b\n\nc d", 3))
print(strings.wrap("", 5))
try
    strings.wrap("x", 0)
catch e
    print(e.message)
try
    strings.wrap("x", 1.5)
catch e
    print(e.message)
try
    strings.wrap(1, 3)
catch e
    print(e.message)
