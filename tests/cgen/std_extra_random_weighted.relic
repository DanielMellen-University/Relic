use std/random
let r = random.new(2)
let picks = []
for i in 0..6
    append(picks, random.weighted(r, ["a", "b"], [1, 3]))
print(picks)
let r2 = random.new(2)
let again = []
for i in 0..6
    append(again, random.weighted(r2, ["a", "b"], [1, 3]))
print(picks == again)
try
    random.weighted(random.new(1), [], [])
catch e
    print(e.message)
try
    random.weighted(random.new(1), ["a"], [0])
catch e
    print(e.message)
try
    random.weighted(random.new(1), ["a", "b"], [1])
catch e
    print(e.message)
