use std/lists
let xs = [1, 3, 3, 5, 9]
print(lists.bisect(xs, 0), lists.bisect(xs, 1), lists.bisect(xs, 3), lists.bisect(xs, 4), lists.bisect(xs, 9), lists.bisect(xs, 10))
print(lists.bisect([], 5), lists.bisect([1.5, 2.5], 2), lists.bisect([1, 2], 2.0))
print(lists.bisect(["apple", "fig", "pear"], "kiwi"), lists.bisect("aceg", "d"))
# against a linear count on a long list
let big = []
for i in 0..2000
    append(big, i * 2)
let ok = true
for v in [-1, 0, 1, 777, 778, 3998, 3999, 5000]
    let want = 0
    for b in big
        if b < v
            want = want + 1
    if lists.bisect(big, v) != want
        ok = false
        print("wrong for", v)
print(ok)
try
    lists.bisect([1, 2], none)
catch e
    print(e.message)
try
    lists.bisect([1, 2], "a")
catch e
    print(e.message)
try
    lists.bisect(7, 1)
catch e
    print(e.message)
