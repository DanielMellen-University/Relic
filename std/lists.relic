# std/lists: list helpers. pop, insert and remove are built in. A list, a
# string or a map (its keys) can be walked; since 1.0.49 anything else fails
# as "lists.map(): xs must be a list, got int".

fun _seq(name, xs) = _seq_named(name, "xs", xs)

fun _seq_named(name, what, xs)
    let t = type(xs)
    if t != "list" and t != "string" and t != "map"
        fail("lists." + name + "(): " + what + " must be a list, got " + t)

fun map(xs, f)
    _seq("map", xs)
    let out = []
    for x in xs
        append(out, f(x))
    return out

fun filter(xs, keep)
    _seq("filter", xs)
    let out = []
    for x in xs
        if keep(x)
            append(out, x)
    return out

fun reduce(xs, f, start)
    _seq("reduce", xs)
    let acc = start
    for x in xs
        acc = f(acc, x)
    return acc

fun sum(xs)
    _seq("sum", xs)
    return reduce(xs, fun_add, 0)

fun fun_add(a, b) = a + b

fun index_of(xs, item)
    _seq("index_of", xs)
    let i = 0
    for x in xs
        if x == item
            return i
        i = i + 1
    return -1

# Since 1.0.49: whether item is in xs (==, so 1 and 1.0 match), the items
# without repeats (the first of each kept, in order), and the smallest and
# largest item (by <, so NaN and mixed types follow its rules; an empty list
# is an error).
fun contains(xs, item)
    _seq("contains", xs)
    return index_of(xs, item) >= 0

fun unique(xs)
    _seq("unique", xs)
    let out = []
    let seen = {}
    for x in xs
        if type(x) == "string"
            if not x in seen
                seen[x] = true
                append(out, x)
        else if index_of(out, x) < 0
            append(out, x)
    return out

# Since 1.0.49: whether test(x) is true for some item, and for every item.
# Both stop at the first item that decides it; an empty list is false for
# any and true for all.
fun any(xs, test)
    _seq("any", xs)
    for x in xs
        if test(x)
            return true
    return false

fun all(xs, test)
    _seq("all", xs)
    for x in xs
        if not test(x)
            return false
    return true

# Since 1.0.49: one level of nesting taken out; an item that is not a list
# stays as it is, and lists inside the inner lists stay lists.
fun flatten(xs)
    _seq("flatten", xs)
    let out = []
    for x in xs
        if type(x) == "list"
            for y in x
                append(out, y)
        else
            append(out, x)
    return out

# Since 1.0.49: [a item, b item] pairs in order, as many as the shorter has.
fun zip(a, b)
    _seq_named("zip", "a", a)
    _seq_named("zip", "b", b)
    let ys = []
    for y in b
        append(ys, y)
    let out = []
    let i = 0
    for x in a
        if i >= len(ys)
            return out
        append(out, [x, ys[i]])
        i = i + 1
    return out

# Since 1.0.50: how many items are == item (so 1 and 1.0 both count).
fun count(xs, item)
    _seq("count", xs)
    let n = 0
    for x in xs
        if x == item
            n = n + 1
    return n

# Since 1.0.50: the items in lists of n (the last one may be shorter); n must
# be a whole number above 0.
fun chunk(xs, n)
    _seq("chunk", xs)
    if type(n) != "int" or n < 1
        fail("lists.chunk(): size must be a whole number above 0")
    let out = []
    let part = []
    for x in xs
        append(part, x)
        if len(part) == n
            append(out, part)
            part = []
    if len(part) > 0
        append(out, part)
    return out

# Since 1.0.50: the first item test(x) is true for, or none when there is no
# such item.
fun find(xs, test)
    _seq("find", xs)
    for x in xs
        if test(x)
            return x
    return none

# Since 1.0.50: where the first item test(x) is true for is, or -1.
fun find_index(xs, test)
    _seq("find_index", xs)
    let i = 0
    for x in xs
        if test(x)
            return i
        i = i + 1
    return -1

# Since 1.0.50: the first n items (all of them when there are fewer), and the
# items after the first n. n must be a whole number, 0 or more.
fun _count_arg(name, n)
    if type(n) != "int" or n < 0
        fail("lists." + name + "(): count must be a whole number, 0 or more")

fun take(xs, n)
    _seq("take", xs)
    _count_arg("take", n)
    let out = []
    for x in xs
        if len(out) >= n
            break
        append(out, x)
    return out

fun drop(xs, n)
    _seq("drop", xs)
    _count_arg("drop", n)
    let out = []
    let i = 0
    for x in xs
        if i >= n
            append(out, x)
        i = i + 1
    return out

# Since 1.0.50: two lists, the items test(x) is true for and the rest, each in
# the order they came.
fun partition(xs, test)
    _seq("partition", xs)
    let yes = []
    let no = []
    for x in xs
        if test(x)
            append(yes, x)
        else
            append(no, x)
    return [yes, no]

# Since 1.0.50: the items multiplied together, 1 for an empty list.
fun product(xs)
    _seq("product", xs)
    let acc = 1
    for x in xs
        acc = acc * x
    return acc

# Since 1.0.50: a map from key(x) to the list of items with that key, in the
# order they came. key(x) must give a string.
fun group_by(xs, key)
    _seq("group_by", xs)
    let out = {}
    for x in xs
        let k = key(x)
        if type(k) != "string"
            fail("lists.group_by(): key must give a string, got " + type(k))
        if not k in out
            out[k] = []
        append(out[k], x)
    return out

fun _empty(name, xs)
    _seq(name, xs)
    if len(xs) == 0
        fail("lists." + name + "(): the list is empty")

fun min(xs)
    _empty("min", xs)
    let m = xs[0]
    for x in xs
        if x < m
            m = x
    return m

fun max(xs)
    _empty("max", xs)
    let m = xs[0]
    for x in xs
        if m < x
            m = x
    return m

fun reverse(xs)
    _seq("reverse", xs)
    let out = []
    let i = len(xs) - 1
    while i >= 0
        append(out, xs[i])
        i = i - 1
    return out

fun copy(xs)
    _seq("copy", xs)
    return slice(xs, 0, len(xs))

fun sort_by(xs, less)
    # stable merge sort; returns a new list
    _seq("sort_by", xs)
    return _merge(xs, less)

fun _merge(xs, less)
    if len(xs) <= 1
        return slice(xs, 0, len(xs))
    let mid = int(len(xs) / 2)
    let a = _merge(slice(xs, 0, mid), less)
    let b = _merge(slice(xs, mid, len(xs)), less)
    let out = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        if less(b[j], a[i])
            append(out, b[j])
            j = j + 1
        else
            append(out, a[i])
            i = i + 1
    return out + slice(a, i, len(a)) + slice(b, j, len(b))

fun natural(a, b) = a < b

# A list of only numbers or only strings is sorted by the host (host_sort,
# the same merge as sort_by, so the order is the same, ties and NaN too);
# anything else goes through sort_by, with its errors.
fun sort(xs)
    _seq("sort", xs)
    let r = host_sort(xs)
    if r == none
        return sort_by(xs, natural)
    return r
