# std/lists: list helpers. pop, insert and remove are built in. A list, a
# string or a map (its keys) can be walked; since 1.0.49 anything else fails
# as "lists.map(): xs must be a list, got int".

fun _seq(name, xs) = _seq_named(name, "xs", xs)

fun _seq_named(name, what, xs)
    let t = type(xs)
    if t != "list" and t != "string" and t != "map"
        fail("lists." + name + "(): " + what + " must be a list, got " + t)

# Since 1.0.52 a function argument that is not one names the function and the
# argument: "lists.map(): f must be a function, got int" (it was "cannot call
# an int", and an empty list let it pass).
fun _fn(name, what, f)
    if type(f) != "function"
        fail("lists." + name + "(): " + what + " must be a function, got " + type(f))

# What a bad size or count was, for the error: the number itself, or the type
# of anything that is not one.
fun _got(n)
    if type(n) == "int" or type(n) == "float"
        return str(n)
    return type(n)

# map, filter and reduce make a new list (or value) and leave xs as it is.
# map: f(x) for each item, in order.
fun map(xs, f)
    _seq("map", xs)
    _fn("map", "f", f)
    let out = []
    for x in xs
        append(out, f(x))
    return out

# filter: the items keep(x) is true for, in order.
fun filter(xs, keep)
    _seq("filter", xs)
    _fn("filter", "keep", keep)
    let out = []
    for x in xs
        if keep(x)
            append(out, x)
    return out

# reduce: start, then f(acc, x) with each item in turn; reduce([1, 2], f, 0)
# is f(f(0, 1), 2). An empty list gives start.
fun reduce(xs, f, start)
    _seq("reduce", xs)
    _fn("reduce", "f", f)
    let acc = start
    for x in xs
        acc = f(acc, x)
    return acc

# scan: every step of reduce, in order; scan([1, 2], f, 0) is
# [f(0, 1), f(f(0, 1), 2)]. start itself is not in the list, so an empty list
# gives [].
fun scan(xs, f, start)
    _seq("scan", xs)
    _fn("scan", "f", f)
    let out = []
    let acc = start
    for x in xs
        acc = f(acc, x)
        append(out, acc)
    return out

# sum: the items added with +, from 0, so a list of strings is an error
# ("cannot add an int and a string") and not a join.
fun sum(xs)
    _seq("sum", xs)
    return _total("sum", xs)

# The items added up; one that is not a number names the helper and where it
# is: "lists.sum(): item 1 must be a number, got string" (since 1.0.52; it was
# "cannot add an int and a string").
fun _total(name, xs)
    let acc = 0
    let i = 0
    for x in xs
        let t = type(x)
        if t != "int" and t != "float"
            fail("lists." + name + "(): item " + str(i) + " must be a number, got " + t)
        acc = acc + x
        i = i + 1
    return acc

fun fun_add(a, b) = a + b

# index_of: where the first item == item is, or -1.
fun index_of(xs, item)
    _seq("index_of", xs)
    let i = 0
    for x in xs
        if x == item
            return i
        i = i + 1
    return -1

# Since 1.0.49: whether item is in xs (==, so 1 and 1.0 match), the items
# without repeats (the first of each kept, in order), and the smallest and
# largest item (by <, so NaN and mixed types follow its rules; an empty list
# is an error).
fun contains(xs, item)
    _seq("contains", xs)
    return index_of(xs, item) >= 0

# Strings, and whole numbers under 2^53 either way (an int, or a float with
# nothing after the point, keyed as the same int so 1 and 1.0 match), are
# looked up in a map; anything else is searched for in what is kept. 20,000
# ints took 4.9 s searching (since 1.0.52, 0.015 s). A number under 2^53 is
# never == one at or past it, or a fraction, so the two ways cannot miss a match.
fun unique(xs)
    _seq("unique", xs)
    let out = []
    let seen = {}
    let nums = {}
    for x in xs
        let t = type(x)
        if t == "string"
            if not x in seen
                seen[x] = true
                append(out, x)
        else if (t == "int" or t == "float") and x > -9007199254740992 and x < 9007199254740992 and (t == "int" or x == host_floor(x))
            let k = str(int(x))
            if not k in nums
                nums[k] = true
                append(out, x)
        else if index_of(out, x) < 0
            append(out, x)
    return out

# Since 1.0.49: whether test(x) is true for some item, and for every item.
# Both stop at the first item that decides it; an empty list is false for
# any and true for all.
fun any(xs, test)
    _seq("any", xs)
    _fn("any", "test", test)
    for x in xs
        if test(x)
            return true
    return false

fun all(xs, test)
    _seq("all", xs)
    _fn("all", "test", test)
    for x in xs
        if not test(x)
            return false
    return true

# Since 1.0.49: one level of nesting taken out; an item that is not a list
# stays as it is, and lists inside the inner lists stay lists.
fun flatten(xs)
    _seq("flatten", xs)
    let out = []
    for x in xs
        if type(x) == "list"
            for y in x
                append(out, y)
        else
            append(out, x)
    return out

# Since 1.0.49: [a item, b item] pairs in order, as many as the shorter has.
fun zip(a, b)
    _seq_named("zip", "a", a)
    _seq_named("zip", "b", b)
    let ys = []
    for y in b
        append(ys, y)
    let out = []
    let i = 0
    for x in a
        if i >= len(ys)
            return out
        append(out, [x, ys[i]])
        i = i + 1
    return out

# Since 1.0.50: how many items are == item (so 1 and 1.0 both count).
fun count(xs, item)
    _seq("count", xs)
    let n = 0
    for x in xs
        if x == item
            n = n + 1
    return n

# Since 1.0.50: the items in lists of n (the last one may be shorter); n must
# be a whole number above 0.
fun chunk(xs, n)
    _seq("chunk", xs)
    if type(n) != "int" or n < 1
        fail("lists.chunk(): size must be a whole number above 0, got " + _got(n))
    let out = []
    let part = []
    for x in xs
        append(part, x)
        if len(part) == n
            append(out, part)
            part = []
    if len(part) > 0
        append(out, part)
    return out

# Since 1.0.50: the first item test(x) is true for, or none when there is no
# such item.
fun find(xs, test)
    _seq("find", xs)
    _fn("find", "test", test)
    for x in xs
        if test(x)
            return x
    return none

# Since 1.0.50: where the first item test(x) is true for is, or -1.
fun find_index(xs, test)
    _seq("find_index", xs)
    _fn("find_index", "test", test)
    let i = 0
    for x in xs
        if test(x)
            return i
        i = i + 1
    return -1

# union, intersect and difference treat two lists as sets: the result has no
# item twice, in the order items first came (a, then b for union), and items
# match by ==, so 1 and 1.0 are the same item and the first one is kept.
# Strings are looked up in a map; other items are compared one by one.
fun _set_of(xs)
    let strs = {}
    let rest = []
    for x in xs
        if type(x) == "string"
            strs[x] = true
        else
            append(rest, x)
    return [strs, rest]

fun _in_set(set, x)
    if type(x) == "string"
        return x in set[0]
    return x in set[1]

fun _add_new(out, set, x)
    if not _in_set(set, x)
        append(out, x)
        if type(x) == "string"
            set[0][x] = true
        else
            append(set[1], x)

fun union(a, b)
    _seq_named("union", "a", a)
    _seq_named("union", "b", b)
    let out = []
    let seen = _set_of([])
    for x in a
        _add_new(out, seen, x)
    for x in b
        _add_new(out, seen, x)
    return out

fun intersect(a, b)
    _seq_named("intersect", "a", a)
    _seq_named("intersect", "b", b)
    let other = _set_of(b)
    let out = []
    let seen = _set_of([])
    for x in a
        if _in_set(other, x)
            _add_new(out, seen, x)
    return out

fun difference(a, b)
    _seq_named("difference", "a", a)
    _seq_named("difference", "b", b)
    let other = _set_of(b)
    let out = []
    let seen = _set_of([])
    for x in a
        if not _in_set(other, x)
            _add_new(out, seen, x)
    return out

# Since 1.0.50: the first n items (all of them when there are fewer), and the
# items after the first n. n must be a whole number, 0 or more.
fun _count_arg(name, n)
    if type(n) != "int" or n < 0
        fail("lists." + name + "(): count must be a whole number, 0 or more, got " + _got(n))

fun take(xs, n)
    _seq("take", xs)
    _count_arg("take", n)
    let out = []
    for x in xs
        if len(out) >= n
            break
        append(out, x)
    return out

fun drop(xs, n)
    _seq("drop", xs)
    _count_arg("drop", n)
    let out = []
    let i = 0
    for x in xs
        if i >= n
            append(out, x)
        i = i + 1
    return out

# take_while: the items from the front while test(x) is true, stopping at the
# first one it is false for. drop_while: the rest, from that item on.
fun take_while(xs, test)
    _seq("take_while", xs)
    _fn("take_while", "test", test)
    let out = []
    for x in xs
        if not test(x)
            break
        append(out, x)
    return out

fun drop_while(xs, test)
    _seq("drop_while", xs)
    _fn("drop_while", "test", test)
    let out = []
    let dropping = true
    for x in xs
        if dropping and test(x)
            next
        dropping = false
        append(out, x)
    return out

# Since 1.0.50: two lists, the items test(x) is true for and the rest, each in
# the order they came.
fun partition(xs, test)
    _seq("partition", xs)
    _fn("partition", "test", test)
    let yes = []
    let no = []
    for x in xs
        if test(x)
            append(yes, x)
        else
            append(no, x)
    return [yes, no]

# Since 1.0.50: the items multiplied together, 1 for an empty list.
fun product(xs)
    _seq("product", xs)
    let acc = 1
    let i = 0
    for x in xs
        let t = type(x)
        if t != "int" and t != "float"
            fail("lists.product(): item " + str(i) + " must be a number, got " + t)
        acc = acc * x
        i = i + 1
    return acc

# Since 1.0.50: a map from key(x) to the list of items with that key, in the
# order they came. key(x) must give a string.
fun group_by(xs, key)
    _seq("group_by", xs)
    _fn("group_by", "key", key)
    let out = {}
    for x in xs
        let k = key(x)
        if type(k) != "string"
            fail("lists.group_by(): key must give a string, got " + type(k))
        if not k in out
            out[k] = []
        append(out[k], x)
    return out

# unique_by: the first item for each key(x), in order. key(x) must give a
# string, as for group_by.
fun unique_by(xs, key)
    _seq("unique_by", xs)
    _fn("unique_by", "key", key)
    let out = []
    let seen = {}
    for x in xs
        let k = key(x)
        if type(k) != "string"
            fail("lists.unique_by(): key must give a string, got " + type(k))
        if not k in seen
            seen[k] = true
            append(out, x)
    return out

# Since 1.0.50: a map from key(x) to how many items have that key, keys in the
# order they first came; group_by with the counts. key(x) must give a string.
fun count_by(xs, key)
    _seq("count_by", xs)
    _fn("count_by", "key", key)
    let out = {}
    for x in xs
        let k = key(x)
        if type(k) != "string"
            fail("lists.count_by(): key must give a string, got " + type(k))
        if k in out
            out[k] = out[k] + 1
        else
            out[k] = 1
    return out

fun _empty(name, xs)
    _seq(name, xs)
    if len(xs) == 0
        fail("lists." + name + "(): the list is empty")

# The first item as a loop sees it: xs[0] would fail on a map, whose items
# here are its keys.
fun _first(xs)
    for x in xs
        return x

fun min(xs)
    _empty("min", xs)
    let m = _first(xs)
    for x in xs
        if x < m
            m = x
    return m

fun max(xs)
    _empty("max", xs)
    let m = _first(xs)
    for x in xs
        if m < x
            m = x
    return m

# Since 1.0.50: the item with the smallest, or largest, key(x) by <; the
# first of equal ones. An empty list is an error, as for min and max. key is
# called once for each item (since 1.0.52; the first was keyed twice).
fun min_by(xs, key)
    _empty("min_by", xs)
    _fn("min_by", "key", key)
    let best = none
    let k = none
    let first = true
    for x in xs
        let kx = key(x)
        if first or kx < k
            best = x
            k = kx
            first = false
    return best

fun max_by(xs, key)
    _empty("max_by", xs)
    _fn("max_by", "key", key)
    let best = none
    let k = none
    let first = true
    for x in xs
        let kx = key(x)
        if first or k < kx
            best = x
            k = kx
            first = false
    return best

# Since 1.0.50: the last item; an empty list is an error.
fun last(xs)
    _empty("last", xs)
    if type(xs) == "map"
        return keys(xs)[len(xs) - 1]
    return xs[len(xs) - 1]

# Since 1.0.50: every run of n items in a row, in order: windows([1, 2, 3], 2)
# is [[1, 2], [2, 3]]. Fewer than n items give [].
fun windows(xs, n)
    _seq("windows", xs)
    if type(n) != "int" or n < 1
        fail("lists.windows(): size must be a whole number above 0, got " + _got(n))
    let items = []
    for x in xs
        append(items, x)
    let out = []
    for i in 0..len(items) - n + 1
        append(out, slice(items, i, i + n))
    return out

# median: the middle item once sorted, as it is, for an odd count; the mean
# of the two middle ones, as a float, for an even count. Items must be
# numbers, and an empty list is an error, as for mean. A NaN item sorts where
# sort leaves it.
fun median(xs)
    _empty("median", xs)
    let i = 0
    for x in xs
        let t = type(x)
        if t != "int" and t != "float"
            fail("lists.median(): item " + str(i) + " must be a number, got " + t)
        i = i + 1
    let ys = sort(xs)
    let n = len(ys)
    let mid = int(n / 2)
    if n % 2 == 1
        return ys[mid]
    return float(ys[mid - 1]) / 2 + float(ys[mid]) / 2

# Since 1.0.50: the average of the items, as a float; an empty list is an
# error, as for min and max.
fun mean(xs)
    _empty("mean", xs)
    try
        return float(_total("mean", xs)) / len(xs)
    catch e
        if e.message != "int overflow"
            fail(e.message)
    # ints near the edge of the range overflowed the exact sum, so add them as
    # floats (mean of [2^62, 2^62] was an int overflow; since 1.0.52 it is
    # 4.61168601842739e+18)
    let acc = 0.0
    for x in xs
        acc = acc + x
    return acc / len(xs)

# Since 1.0.50: the items with the first n moved to the end, in order;
# a negative n moves the last ones to the front, and n wraps round.
fun rotate(xs, n)
    _seq("rotate", xs)
    if type(n) != "int"
        fail("lists.rotate(): count must be an int, got " + type(n))
    let items = []
    for x in xs
        append(items, x)
    if len(items) == 0
        return items
    let k = n % len(items)
    return slice(items, k, len(items)) + slice(items, 0, k)

# Since 1.0.50: f(x) for each item, added up from 0, as sum(map(xs, f)).
fun sum_by(xs, f)
    _seq("sum_by", xs)
    _fn("sum_by", "f", f)
    let acc = 0
    let i = 0
    for x in xs
        let v = f(x)
        let t = type(v)
        if t != "int" and t != "float"
            fail("lists.sum_by(): f gave " + t + " for item " + str(i) + ", not a number")
        acc = acc + v
        i = i + 1
    return acc

# The items as a list: xs itself when it is one, else a new list of a
# string's characters or a map's keys, so the helpers below that index or
# slice work on those too (since 1.0.52; before, reverse, copy, sort and
# sort_by failed on a map, and sort_by on a string).
fun _items(xs)
    if type(xs) == "list"
        return xs
    let out = []
    for x in xs
        append(out, x)
    return out

fun reverse(xs)
    _seq("reverse", xs)
    let ys = _items(xs)
    let out = []
    let i = len(ys) - 1
    while i >= 0
        append(out, ys[i])
        i = i - 1
    return out

fun copy(xs)
    _seq("copy", xs)
    let ys = _items(xs)
    return slice(ys, 0, len(ys))

fun sort_by(xs, less)
    # stable merge sort; returns a new list
    _seq("sort_by", xs)
    _fn("sort_by", "less", less)
    return _merge(_items(xs), less)

fun _merge(xs, less)
    if len(xs) <= 1
        return slice(xs, 0, len(xs))
    let mid = int(len(xs) / 2)
    let a = _merge(slice(xs, 0, mid), less)
    let b = _merge(slice(xs, mid, len(xs)), less)
    let out = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        if less(b[j], a[i])
            append(out, b[j])
            j = j + 1
        else
            append(out, a[i])
            i = i + 1
    return out + slice(a, i, len(a)) + slice(b, j, len(b))

fun natural(a, b) = a < b

# bisect: where item would go in xs, which must already be sorted (as sort
# leaves it): the index of the first item that is not < item, so before any
# equal ones; len(xs) when every item is smaller. A binary search, so a
# 100,000 item list takes about 17 compares. item must be a number or a
# string, and comparing it with the items has the usual errors ("cannot
# compare an int and a string").
fun _sortable(name, item)
    let t = type(item)
    if t != "int" and t != "float" and t != "string"
        fail("lists." + name + "(): item must be a number or a string, got " + t)

fun _bisect(ys, item, after)
    let lo = 0
    let hi = len(ys)
    while lo < hi
        let mid = int((lo + hi) / 2)
        let go_right = ys[mid] < item
        if after
            go_right = not (item < ys[mid])
        if go_right
            lo = mid + 1
        else
            hi = mid
    return lo

fun bisect(xs, item)
    _seq("bisect", xs)
    _sortable("bisect", item)
    return _bisect(_items(xs), item, false)

# insert_sorted: a new sorted list with item added after any equal items, so
# adding items one at a time keeps them in the order they came, as sort does.
# xs is left as it is.
fun insert_sorted(xs, item)
    _seq("insert_sorted", xs)
    _sortable("insert_sorted", item)
    let ys = _items(xs)
    let at = _bisect(ys, item, true)
    let out = slice(ys, 0, at)
    append(out, item)
    for y in slice(ys, at, len(ys))
        append(out, y)
    return out

# A list of only numbers or only strings is sorted by the host (host_sort,
# the same merge as sort_by, so the order is the same, ties and NaN too);
# anything else goes through sort_by, with its errors.
fun sort(xs)
    _seq("sort", xs)
    let ys = _items(xs)
    let r = host_sort(ys)
    if r == none
        return sort_by(ys, natural)
    return r

# [index, item] pairs from 0, in order. A string gives its characters and a
# map its keys, as the other helpers do.
fun enumerate(xs)
    _seq("enumerate", xs)
    let out = []
    let i = 0
    for x in xs
        append(out, [i, x])
        i = i + 1
    return out

# One list from a list of lists, in order. An item that is not a list is an
# error (flatten keeps those as they are; concat does not).
fun concat(parts)
    if type(parts) != "list"
        fail("lists.concat(): parts must be a list, got " + type(parts))
    let out = []
    let i = 0
    for p in parts
        if type(p) != "list"
            fail("lists.concat(): item " + str(i) + " must be a list, got " + type(p))
        for x in p
            append(out, x)
        i = i + 1
    return out

# sep between the items, not before the first or after the last. An empty
# list stays empty, and a one-item list is that item alone.
fun intersperse(xs, sep)
    _seq("intersperse", xs)
    let out = []
    let first = true
    for x in xs
        if not first
            append(out, sep)
        first = false
        append(out, x)
    return out

# The items that are not none, in order. false, 0 and "" stay.
fun compact(xs)
    _seq("compact", xs)
    let out = []
    for x in xs
        if x != none
            append(out, x)
    return out

# The items test(x) is not true for, in order. The opposite of filter.
fun reject(xs, test)
    _seq("reject", xs)
    _fn("reject", "test", test)
    let out = []
    for x in xs
        if not test(x)
            append(out, x)
    return out

# The last item test(x) is true for, or none. test is called on every item.
fun find_last(xs, test)
    _seq("find_last", xs)
    _fn("find_last", "test", test)
    let items = _items(xs)
    let i = len(items) - 1
    while i >= 0
        if test(items[i])
            return items[i]
        i = i - 1
    return none

# How many items test(x) is true for. An empty list is 0.
fun count_if(xs, test)
    _seq("count_if", xs)
    _fn("count_if", "test", test)
    let n = 0
    for x in xs
        if test(x)
            n = n + 1
    return n

