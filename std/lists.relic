# std/lists: list helpers. pop, insert and remove are built in.

fun map(xs, f)
    let out = []
    for x in xs
        append(out, f(x))
    return out

fun filter(xs, keep)
    let out = []
    for x in xs
        if keep(x)
            append(out, x)
    return out

fun reduce(xs, f, start)
    let acc = start
    for x in xs
        acc = f(acc, x)
    return acc

fun sum(xs) = reduce(xs, fun_add, 0)
fun fun_add(a, b) = a + b

fun index_of(xs, item)
    let i = 0
    for x in xs
        if x == item
            return i
        i = i + 1
    return -1

# Since 1.0.49: whether item is in xs (==, so 1 and 1.0 match), the items
# without repeats (the first of each kept, in order), and the smallest and
# largest item (by <, so NaN and mixed types follow its rules; an empty list
# is an error).
fun contains(xs, item) = index_of(xs, item) >= 0

fun unique(xs)
    let out = []
    let seen = {}
    for x in xs
        if type(x) == "string"
            if not x in seen
                seen[x] = true
                append(out, x)
        else if index_of(out, x) < 0
            append(out, x)
    return out

fun _empty(name, xs)
    if len(xs) == 0
        fail("lists." + name + "(): the list is empty")

fun min(xs)
    _empty("min", xs)
    let m = xs[0]
    for x in xs
        if x < m
            m = x
    return m

fun max(xs)
    _empty("max", xs)
    let m = xs[0]
    for x in xs
        if m < x
            m = x
    return m

fun reverse(xs)
    let out = []
    let i = len(xs) - 1
    while i >= 0
        append(out, xs[i])
        i = i - 1
    return out

fun copy(xs) = slice(xs, 0, len(xs))

fun sort_by(xs, less)
    # stable merge sort; returns a new list
    if len(xs) <= 1
        return copy(xs)
    let mid = int(len(xs) / 2)
    let a = sort_by(slice(xs, 0, mid), less)
    let b = sort_by(slice(xs, mid, len(xs)), less)
    let out = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        if less(b[j], a[i])
            append(out, b[j])
            j = j + 1
        else
            append(out, a[i])
            i = i + 1
    return out + slice(a, i, len(a)) + slice(b, j, len(b))

fun natural(a, b) = a < b

# A list of only numbers or only strings is sorted by the host (host_sort,
# the same merge as sort_by, so the order is the same, ties and NaN too);
# anything else goes through sort_by, with its errors.
fun sort(xs)
    let r = host_sort(xs)
    if r == none
        return sort_by(xs, natural)
    return r
