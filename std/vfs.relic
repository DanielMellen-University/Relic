# std/vfs: in-memory virtual filesystem for Relic apps (M11).
# Not the host disk (see std/files). Paths use "/", like std/paths.
use std/paths
use std/strings
use std/lists

# A dir node is {dir: true, kids: {name: node, ...}}.
# A file node is {dir: false, text: "..."}.
# The VFS value is {root: dir_node}.

# The names along a path, in one pass: what paths.normalize gives for the path
# made absolute ("\" is "/"; ".", empty names and ".." at the top dropped; a
# ".." takes the name before it away). Every call here starts with this, so a
# Files window checking each of 3,000 names spent most of its time in it.
fun _parts(p)
    let parts = []
    let cur = ""
    for c in p
        if c == "/" or c == "\\"
            parts = _put(parts, cur)
            cur = ""
        else
            cur = cur + c
    return _put(parts, cur)

fun _put(parts, name)
    if name == ".."
        if len(parts) > 0
            pop(parts)
    else if name != "." and name != ""
        parts = parts + [name]
    return parts

fun _norm(p) = "/" + strings.join(_parts(p), "/")

fun _node(fs, path)
    let cur = fs.root
    for name in _parts(path)
        if not cur.dir or not name in cur.kids
            return none
        cur = cur.kids[name]
    return cur

# Drop a key without calling the builtin remove (this module exports remove).
fun _drop(m, name)
    let out = {}
    for k in m
        if k != name
            out[k] = m[k]
    return out

fun new()
    let fs = {root: {dir: true, kids: {}}}
    make_dir(fs, "/home")
    make_dir(fs, "/tmp")
    write(fs, "/home/welcome.txt", "Welcome to Relic.\n")
    return fs

fun exists(fs, path) = _node(fs, path) != none

fun is_dir(fs, path)
    let n = _node(fs, path)
    return n != none and n.dir

# Names in order, merged in place in widening runs: the same order as
# lists.sort (names are strings, all different) in about half the time, which
# a folder of 3,000 names listed every frame notices.
fun _sorted(xs)
    let n = len(xs)
    let a = slice(xs, 0, n)
    let b = slice(xs, 0, n)
    let w = 1
    while w < n
        let lo = 0
        while lo < n
            let mid = lo + w
            if mid > n
                mid = n
            let hi = mid + w
            if hi > n
                hi = n
            let i = lo
            let j = mid
            let k = lo
            while i < mid and j < hi
                if a[j] < a[i]
                    b[k] = a[j]
                    j = j + 1
                else
                    b[k] = a[i]
                    i = i + 1
                k = k + 1
            while i < mid
                b[k] = a[i]
                i = i + 1
                k = k + 1
            while j < hi
                b[k] = a[j]
                j = j + 1
                k = k + 1
            lo = hi
        let t = a
        a = b
        b = t
        w = w * 2
    return a
fun list(fs, path)
    let n = _node(fs, path)
    if n == none or not n.dir
        fail("cannot list " + _norm(path))
    return _sorted(keys(n.kids))

fun read(fs, path)
    let n = _node(fs, path)
    if n == none or n.dir
        fail("cannot read " + _norm(path))
    return n.text

fun write(fs, path, text)
    let p = _norm(path)
    if p == "/"
        fail("cannot write /")
    let parent = paths.dir(p)
    let name = paths.base(p)
    let d = _node(fs, parent)
    if d == none or not d.dir
        fail("cannot write " + p)
    if name in d.kids and d.kids[name].dir
        fail("cannot write " + p)
    d.kids[name] = {dir: false, text: text}

fun append(fs, path, text)
    let p = _norm(path)
    let n = _node(fs, p)
    if n == none
        write(fs, p, text)
        return
    if n.dir
        fail("cannot append " + p)
    n.text = n.text + text

fun make_dir(fs, path)
    let p = _norm(path)
    if p == "/"
        return
    let cur = fs.root
    for name in _parts(p)
        if name in cur.kids
            let n = cur.kids[name]
            if not n.dir
                fail("cannot make folder " + p)
            cur = n
        else
            let n = {dir: true, kids: {}}
            cur.kids[name] = n
            cur = n

fun remove(fs, path)
    let p = _norm(path)
    if p == "/"
        fail("cannot remove /")
    let parent = paths.dir(p)
    let name = paths.base(p)
    let d = _node(fs, parent)
    if d == none or not d.dir or not name in d.kids
        fail("cannot remove " + p)
    let n = d.kids[name]
    if n.dir and len(keys(n.kids)) > 0
        fail("cannot remove " + p)
    d.kids = _drop(d.kids, name)

# The folder goes from its parent with everything in it at once. It was emptied
# one name at a time, and each removal copied the folder's map of names, so a
# folder of 4,000 files took 3 s.
fun remove_tree(fs, path)
    let p = _norm(path)
    if p == "/"
        fail("cannot remove /")
    if _node(fs, p) == none
        return
    let d = _node(fs, paths.dir(p))
    d.kids = _drop(d.kids, paths.base(p))

fun rename(fs, from, to)
    let src = _norm(from)
    let dst = _norm(to)
    if src == "/" or dst == "/"
        fail("cannot rename " + src)
    let n = _node(fs, src)
    if n == none
        fail("cannot rename " + src)
    if exists(fs, dst) or strings.starts_with(dst, src + "/")
        fail("cannot rename " + src)
    let sp = paths.dir(src)
    let sn = paths.base(src)
    let dp = paths.dir(dst)
    let dn = paths.base(dst)
    let sd = _node(fs, sp)
    let dd = _node(fs, dp)
    if dd == none or not dd.dir
        fail("cannot rename " + src)
    dd.kids[dn] = n
    sd.kids = _drop(sd.kids, sn)

fun size(fs, path)
    let n = _node(fs, path)
    if n == none or n.dir
        fail("cannot get the size of " + _norm(path))
    return len(n.text)
