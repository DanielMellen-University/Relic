# std/time: clocks, in seconds.

fun now() = host_now()       # seconds since 1970-01-01 UTC
fun clock() = host_clock()   # steady clock for measuring; only differences mean anything
# seconds since a clock() reading
fun since(start)
    if type(start) != "int" and type(start) != "float"
        fail("time.since(): start must be a number, got " + type(start))
    return host_clock() - start
fun sleep(ms) = host_sleep(ms)           # in milliseconds, unlike the clocks

# Frame timer: tick(t) once per frame gives seconds since the last tick and
# keeps t.fps up to date (averaged over about one second).
fun timer() = {last: host_clock(), fps: 0, frames: 0, window: 0}

fun tick(t)
    let now = host_clock()
    let dt = now - t.last
    t.last = now
    t.frames = t.frames + 1
    t.window = t.window + dt
    if t.window >= 1
        t.fps = t.frames / t.window
        t.frames = 0
        t.window = 0
    return dt

# limit(t, fps): sleeps so frames run no faster than fps, a number above 0
# (since 1.0.52 anything else is "time.limit(): fps must be a number above 0,
# got 0"; 0 was a division by zero and a negative fps never slept).
fun limit(t, fps)
    if (type(fps) != "int" and type(fps) != "float") or not (fps > 0)
        let got = type(fps)
        if got == "int" or got == "float"
            got = str(fps)
        fail("time.limit(): fps must be a number above 0, got " + got)
    let left = 1 / fps - (host_clock() - t.last)
    if left > 0
        host_sleep(left * 1000)
