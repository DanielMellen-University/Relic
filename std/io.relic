# std/io: small file helpers on top of std/files. Paths are relative to
# where relic runs, the same as files.
use std/files
use std/strings

fun _path(name, what, path)
    if type(path) != "string"
        fail("io." + name + "(): " + what + " must be a string, got " + type(path))

# true when path is a file. A missing path and a folder are false.
fun is_file(path)
    _path("is_file", "path", path)
    return files.exists(path) and not files.is_dir(path)

# Copy the text of one file onto another. from must be a file, not a folder.
# to is created or replaced. A missing from fails as files.read does.
fun copy(from, to)
    _path("copy", "from", from)
    _path("copy", "to", to)
    if files.is_dir(from)
        fail("io.copy(): cannot copy a folder, got " + from)
    files.write(to, files.read(from))

# Write each string as its own line, with a newline after every one, including
# the last. An empty list writes an empty file. A line that is not a string
# is an error (it is not passed through str).
fun write_lines(path, lines)
    _path("write_lines", "path", path)
    if type(lines) != "list"
        fail("io.write_lines(): lines must be a list, got " + type(lines))
    let i = 0
    for line in lines
        if type(line) != "string"
            fail("io.write_lines(): line " + str(i) + " must be a string, got " + type(line))
        i = i + 1
    if len(lines) == 0
        files.write(path, "")
        return
    files.write(path, strings.join(lines, "\n") + "\n")
