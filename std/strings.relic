# std/strings: text helpers, written in Relic on top of slice, ord and chr.

# upper, lower, trim, split and repeat check that they got text, so a number
# gives "strings.upper(): argument must be a string, got int" and not "cannot loop over an int".
fun _text(name, what, s)
    if type(s) != "string"
        fail("strings." + name + "(): " + what + " must be a string, got " + type(s))

fun find(s, sub)
    # index of the first `sub` in `s`, or -1. Two strings go to the host
    # (host_find, linear time); lists and anything else take the loop below.
    if type(s) == "string" and type(sub) == "string"
        return host_find(s, sub)
    let n = len(sub)
    let ls = len(s)
    if ls > 1024
        return _find_long(s, sub, n, ls)
    let i = 0
    while i + n <= ls
        if slice(s, i, i + n) == sub
            return i
        i = i + 1
    return -1

# Long text. slice(s, i, ...) walks s from the start to character i, so the loop
# above takes time growing with the square of where `sub` is (80,000 characters
# took 0.9 s); this compares characters from lists instead, with _match so that
# text like "aaaa...a" and a `sub` like "aa...ab" does not take long either.
fun _find_long(s, sub, n, ls)
    if n == 0
        return 0
    let cs = []
    for c in s
        append(cs, c)
    let ss = []
    for c in sub
        append(ss, c)
    return _match(cs, ls, ss, n, _borders(ss), 0)

# borders[q]: the length of the longest part of ss[0..q] that is both its start
# and its end (not all of it). When a compare fails after k characters matched,
# the search goes on from borders[k - 1] matched instead of from 0, so each
# character of the text is passed once (Knuth-Morris-Pratt).
fun _borders(ss)
    let f = [0]
    let k = 0
    for q in 1..len(ss)
        let c = ss[q]
        while k > 0 and c != ss[k]
            k = f[k - 1]
        if c == ss[k]
            k = k + 1
        append(f, k)
    return f

# The first i >= from where ss (m characters, borders f) starts in cs (n
# characters), or -1.
fun _match(cs, n, ss, m, f, from)
    let j = 0
    let i = from
    while i < n
        let c = cs[i]
        while j > 0 and c != ss[j]
            j = f[j - 1]
        if c == ss[j]
            j = j + 1
            if j == m
                return i - m + 1
        i = i + 1
    return -1

fun contains(s, sub) = find(s, sub) >= 0

fun starts_with(s, pre) = slice(s, 0, len(pre)) == pre

fun ends_with(s, suf) = len(suf) <= len(s) and slice(s, len(s) - len(suf), len(s)) == suf

# ASCII letters to the other case, looked up a character at a time, with the
# result built by `out = out + ...` (in place since 1.0.43): about 3x quicker
# than ord and chr on each character into a list joined at the end.
fun _case_table(first, shift)
    let t = {}
    for k in first..first + 26
        t[chr(k)] = chr(k + shift)
    return t

let _to_upper = _case_table(97, -32)
let _to_lower = _case_table(65, 32)

fun _case(s, table)
    let out = ""
    for c in s
        if c in table
            out = out + table[c]
        else
            out = out + c
    return out

fun upper(s)
    _text("upper", "argument", s)
    return _case(s, _to_upper)

fun lower(s)
    _text("lower", "argument", s)
    return _case(s, _to_lower)

fun is_space(c) = c == " " or c == "\t" or c == "\n" or c == chr(13)

fun trim(s)
    _text("trim", "argument", s)
    # s[i] is quick since 1.0.41, so only the spaces at the ends are looked at
    let a = 0
    let b = len(s)
    while a < b and is_space(s[a])
        a = a + 1
    while b > a and is_space(s[b - 1])
        b = b - 1
    return slice(s, a, b)

fun split(s, sep)
    # split("a,b", ",") is ["a", "b"]; an empty sep splits into characters
    _text("split", "text", s)
    _text("split", "separator", sep)
    let parts = []
    if sep == ""
        for c in s
            append(parts, c)
        return parts
    # Each piece is found with find (the host's, linear) in a window of the text
    # from where the last one ended. The window starts a little longer than the
    # last piece and doubles until it holds a separator or reaches the end, so
    # a piece costs about its own length and the text is never copied whole
    # again (20,000 lines: 270 ms before 1.0.46).
    let n = len(s)
    let m = len(sep)
    let pos = 0
    let w = 64
    while true
        let end = pos + w
        if end > n
            end = n
        let i = find(slice(s, pos, end), sep)
        if i >= 0
            append(parts, slice(s, pos, pos + i))
            pos = pos + i + m
            w = 2 * (i + m)
            if w < 64
                w = 64
        else if end >= n
            append(parts, slice(s, pos, n))
            return parts
        else
            w = w * 2

fun join(items, sep)
    let parts = []
    for x in items
        append(parts, str(x))
    if len(parts) == 0
        return ""
    return _join(parts, sep, 0, len(parts))

# Joins halves, so a long list costs n log n bytes copied, not n squared.
fun _join(parts, sep, a, b)
    if b - a <= 8
        let out = parts[a]
        for i in a + 1..b
            out = out + sep + parts[i]
        return out
    let m = a + int((b - a) / 2)
    return _join(parts, sep, a, m) + sep + _join(parts, sep, m, b)

fun replace(s, old, new) = join(split(s, old), new)

fun repeat(s, n)
    _text("repeat", "text", s)
    if type(n) != "int" and type(n) != "float"
        fail("strings.repeat(): count must be a number, got " + type(n))
    if n % 1 != 0
        fail("strings.repeat(): count must be a whole number")
    # doubling, so the text is copied about twice in all, not once per copy added
    let out = ""
    let piece = s
    let k = n
    while k > 0
        if k % 2 == 1
            out = out + piece
        k = int(k / 2)
        if k > 0
            piece = piece + piece
    return out

# The checks pad_left and pad_right share. An infinite width would pad forever.
fun _pad(name, s, width, fill)
    _text(name, "text", s)
    _text(name, "fill", fill)
    if type(width) != "int" and type(width) != "float"
        fail("strings." + name + "(): width must be a number, got " + type(width))
    if width > 0 and width - width != 0
        fail("strings." + name + "(): width must not be infinite")
    if fill == "" and len(s) < width
        fail("strings." + name + "(): fill must not be empty")

# How many whole copies of fill bring s to at least width.
fun _fills(s, width, fill)
    let ls = len(s)
    if ls >= width
        return 0
    let lf = len(fill)
    let k = int((width - ls) / lf)
    if ls + k * lf < width
        k = k + 1
    return k

# pad_left("7", 3, "0") is "007"; pad_right pads on the right.
fun pad_left(s, width, fill)
    _pad("pad_left", s, width, fill)
    return repeat(fill, _fills(s, width, fill)) + s

fun pad_right(s, width, fill)
    _pad("pad_right", s, width, fill)
    return s + repeat(fill, _fills(s, width, fill))
