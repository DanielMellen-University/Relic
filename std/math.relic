# std/math: numbers. Only floor, sqrt, sin, cos, exp, log and pow come from the host.

let pi = 3.141592653589793
let e = 2.718281828459045

# abs, floor, ceil and round check their argument, so a string gives a math error and not a "cannot negate" one.
fun _number(name, x)
    if type(x) != "int" and type(x) != "float"
        fail("math." + name + "(): argument must be a number, got " + type(x))

# -2^63 has no int on the plus side; since 1.0.52 that names abs, as gcd does
# (it was "int overflow").
fun abs(x)
    _number("abs", x)
    if x == -9223372036854775807 - 1 and type(x) == "int"
        fail("math.abs(): the result, 2^63, is out of the int range")
    if x < 0
        return -x
    if x == 0 and type(x) == "float"
        return 0.0  # not -0.0
    return x

fun min(a, b)
    if b < a
        return b
    return a

fun max(a, b)
    if b > a
        return b
    return a

fun clamp(x, lo, hi) = min(max(x, lo), hi)

# gcd and lcm take two ints; the error names the one that is not.
fun _ints(name, a, b)
    if type(a) != "int"
        fail("math." + name + "(): a must be an int, got " + type(a))
    if type(b) != "int"
        fail("math." + name + "(): b must be an int, got " + type(b))

# Since 1.0.50: the greatest common divisor of two ints, never negative;
# gcd(0, 0) is 0.
# Worked on the negatives, since -2^63 has no int on the plus side: gcd of it
# and 6 is 2. Only gcd(-2^63, 0) and gcd(-2^63, -2^63), which are 2^63, fail.
fun gcd(a, b)
    _ints("gcd", a, b)
    if a > 0
        a = -a
    if b > 0
        b = -b
    while b != 0
        let r = a % b
        a = b
        b = r
    if a == -9223372036854775807 - 1
        fail("math.gcd(): the result, 2^63, is out of the int range")
    return -a

# Since 1.0.50: the least common multiple of two ints, never negative;
# 0 when either is 0. Past the int range it is the usual overflow error.
fun lcm(a, b)
    _ints("lcm", a, b)
    if a == 0 or b == 0
        return 0
    a = abs(a)
    let g = gcd(a, b)
    # a / g exactly: / gives a float, which is off past 2^53, so fix it up
    let q = int(a / g)
    q = q + int((a - q * g) / g)
    while q * g > a
        q = q - 1
    while a - q * g >= g
        q = q + 1
    return q * abs(b)

# Since 1.0.49: -1, 0 or 1 as an int, for an int or a float; nan stays nan.
fun sign(x)
    _number("sign", x)
    if x > 0
        return 1
    if x < 0
        return -1
    if x == 0
        return 0
    return x
# floor, ceil and round give an int. An int comes back as it is (going through a
# float lost digits past 2^53); a float must land in the int range.
fun _int(name, f)
    if f >= -9223372036854775808.0 and f < 9223372036854775808.0
        return int(f)
    fail("math." + name + "(): number is out of the int range")

fun floor(x)
    _number("floor", x)
    if type(x) == "int"
        return x
    return _int("floor", host_floor(x))

fun ceil(x)
    _number("ceil", x)
    if type(x) == "int"
        return x
    return _int("ceil", 0.0 - host_floor(0.0 - x))

# Halves go up. x + 0.5 could round up first (0.49999999999999994 + 0.5 is 1.0),
# so this looks at what is left over the floor instead.
fun round(x)
    _number("round", x)
    if type(x) == "int"
        return x
    let f = host_floor(x)
    if x - f >= 0.5
        f = f + 1
    return _int("round", f)
# sqrt, pow, sin, cos, exp and log are the host's, which checks the
# arguments itself (math.sqrt(): argument must be a number, got string). They
# give a float, and nan or an infinity rather than an error at the edges:
# sqrt(-1) is nan and log(0) is -inf.
fun sqrt(x) = host_sqrt(x)
fun pow(x, y) = host_pow(x, y)
fun sin(x) = host_sin(x)
fun cos(x) = host_cos(x)
fun exp(x) = host_exp(x)
fun log(x) = host_log(x)
fun is_whole(x) = type(x) == "int" or x == host_floor(x)

# Since 1.0.50: whether an int is even, or odd; negative ones too.
fun _whole(name, x)
    if type(x) != "int"
        fail("math." + name + "(): argument must be an int, got " + type(x))

fun is_even(x)
    _whole("is_even", x)
    return x % 2 == 0

fun is_odd(x)
    _whole("is_odd", x)
    return x % 2 != 0

# Since 1.0.50: the number t of the way from a to b, a + (b - a) * t; t of 0
# is a, 1 is b, and t outside 0 to 1 goes past them.
fun lerp(a, b, t)
    _number("lerp", a)
    _number("lerp", b)
    _number("lerp", t)
    return a + (b - a) * t

# Since 1.0.50: the length of the line from (0, 0) to (x, y), a float.
# x * x can pass the float range (hypot(1e200, 1e200) was inf) or fall
# under it (1e-200 gave 0.0), so then both are scaled by the bigger one first.
fun hypot(x, y)
    _number("hypot", x)
    _number("hypot", y)
    let r = sqrt(x * x + y * y)
    if r < 1e300 and r > 1e-300
        return r
    let ax = abs(float(x))
    let ay = abs(float(y))
    let m = max(ax, ay)
    if m == 0 or m > 1.7976931348623157e308 or m != m or ay != ay or ax != ax
        return r
    let s = ax / m
    let t = ay / m
    return m * sqrt(s * s + t * t)

# Since 1.0.50: the distance from (x1, y1) to (x2, y2), a float.
fun dist(x1, y1, x2, y2)
    _number("dist", x1)
    _number("dist", y1)
    _number("dist", x2)
    _number("dist", y2)
    return hypot(x2 - x1, y2 - y1)

# Since 1.0.50: degrees to radians and back.
fun radians(deg)
    _number("radians", deg)
    return deg * pi / 180

fun degrees(rad)
    _number("degrees", rad)
    return rad * 180 / pi

# Since 1.0.50: x with its fraction dropped, toward 0, as an int: trunc(-2.7)
# is -2 where floor gives -3.
fun trunc(x)
    _number("trunc", x)
    if type(x) == "int"
        return x
    if x < 0
        return _int("trunc", 0.0 - host_floor(0.0 - x))
    return _int("trunc", host_floor(x))
