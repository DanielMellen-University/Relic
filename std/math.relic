# std/math: numbers. Only floor, sqrt, sin, cos, exp, log and pow come from the host.

let pi = 3.141592653589793
let e = 2.718281828459045

fun abs(x)
    if x < 0
        return -x
    return x

fun min(a, b)
    if b < a
        return b
    return a

fun max(a, b)
    if b > a
        return b
    return a

fun clamp(x, lo, hi) = min(max(x, lo), hi)
fun floor(x) = host_floor(x)
fun ceil(x) = -host_floor(-x)
fun round(x) = host_floor(x + 0.5)
fun sqrt(x) = host_sqrt(x)
fun pow(x, y) = host_pow(x, y)
fun sin(x) = host_sin(x)
fun cos(x) = host_cos(x)
fun exp(x) = host_exp(x)
fun log(x) = host_log(x)
fun is_whole(x) = x == host_floor(x)
