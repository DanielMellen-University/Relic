# std/graphics: one window to draw in (M11). Backed by SDL2: in the host with
# cmake -DRELIC_SDL=ON, in compiled programs with -DRELIC_C_SDL=ON and
# relic_add_program(... GRAPHICS). Colors are 0 to 255 per channel.

fun available() = host_gfx_available()   # false when the host was built without SDL
fun open(width, height, title) = host_gfx_open(width, height, title)
fun close() = host_gfx_close()
fun clear(r, g, b) = host_gfx_clear(r, g, b)
fun rect(x, y, w, h, r, g, b) = host_gfx_rect(x, y, w, h, r, g, b)
fun pixel(x, y, r, g, b) = host_gfx_pixel(x, y, r, g, b)
fun present() = host_gfx_present()       # show what was drawn since the last present
fun quit_requested() = host_gfx_quit_requested()  # true once the window's close button was hit
fun wait(ms) = host_gfx_wait(ms)

# Input. Key names are lowercase SDL names: "a", "space", "left", "return", "escape".
fun key_down(name) = host_gfx_key_down(name)      # true while the key is held
fun next_key() = host_gfx_next_key()              # next pressed key name, or none
fun mouse_x() = host_gfx_mouse_x()
fun mouse_y() = host_gfx_mouse_y()
fun mouse_down(button) = host_gfx_mouse_down(button)  # 1 left, 2 middle, 3 right

# Text in a built-in 8x12 font (ASCII). Each character is 8 * scale wide.
fun text(x, y, s, r, g, b) = host_gfx_text(x, y, s, 1, r, g, b)
fun text_scaled(x, y, s, scale, r, g, b) = host_gfx_text(x, y, s, scale, r, g, b)

# Fonts: the built-in font above is the default. With SDL2_ttf, load a .ttf
# at a pixel size and draw with it. font_size gives [width, height] of a string.
fun has_fonts() = host_gfx_has_fonts()
fun load_font(path, size) = host_gfx_font_load(path, size)
fun font_text(font, x, y, s, r, g, b) = host_gfx_font_text(font, x, y, s, r, g, b)
fun font_size(font, s) = host_gfx_font_size(font, s)

# Images: BMP always; PNG and JPG too when built with SDL2_image (has_png()).
# load returns an id; open a window first.
fun has_png() = host_gfx_has_png()
fun load_image(path) = host_gfx_image_load(path)
fun image(id, x, y) = host_gfx_image(id, x, y)
fun image_width(id) = host_gfx_image_width(id)
fun image_height(id) = host_gfx_image_height(id)

# Events, oldest first: next_event() gives a map or none. Each has a type:
#   key_down, key_up   key, repeat, shift, ctrl, alt
#   text               text (typed characters, UTF-8; use this for text boxes)
#   mouse_down, mouse_up  button (1 left, 2 middle, 3 right), x, y, clicks
#   mouse_move         x, y, dx, dy
#   wheel              dx, dy (dy > 0 scrolls up)
#   resize             width, height (the window is resizable)
#   quit
fun next_event() = host_gfx_next_event()
fun size() = host_gfx_size()      # [width, height] of the drawing area
# simulate(kind, a, b) queues a fake event for tests. Pass none for unused args.
#   "key"/"keyup"  a=name  b=none or "shift"/"ctrl"/"alt" (join with +)
#   "text"         a=text  b=none
#   "click"        a=x     b=y     (left mouse_down then mouse_up)
#   "mousedown"/"mouseup"  a=x  b=y
#   "move"         a=x     b=y     (dx and dy are 0)
#   "wheel"        a=dx    b=dy
#   "resize"       a=w     b=h
#   "quit"         a=none  b=none
fun simulate(kind, a, b) = host_gfx_simulate(kind, a, b)

# More drawing.
fun line(x1, y1, x2, y2, r, g, b) = host_gfx_line(x1, y1, x2, y2, r, g, b)
fun outline(x, y, w, h, r, g, b) = host_gfx_outline(x, y, w, h, r, g, b)
fun rect_alpha(x, y, w, h, r, g, b, a) = host_gfx_rect_alpha(x, y, w, h, r, g, b, a)
fun clip(x, y, w, h) = host_gfx_clip(x, y, w, h)   # draw only inside this rect
fun unclip() = host_gfx_clip(0, 0, 0, 0)

# Clipboard text. The system clipboard while a window is open; works without
# a window too (kept inside this program).
fun copy(s) = host_clipboard_set(s)
fun clipboard() = host_clipboard_get()

# Canvas: an image that keeps what is drawn into it (for paint apps).
# draw_to(c) sends all drawing to canvas c until draw_to(none); then show it
# with image(c, x, y) like any other image.
fun canvas(width, height) = host_gfx_canvas(width, height)
fun draw_to(c) = host_gfx_draw_to(c)
