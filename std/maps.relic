# std/maps: map helpers. keys and remove are built in.

fun values(m)
    let out = []
    for k in m
        append(out, m[k])
    return out

fun items(m)
    # list of [key, value] pairs, in insertion order
    let out = []
    for k in m
        append(out, [k, m[k]])
    return out

fun get(m, k, fallback)
    if k in m
        return m[k]
    return fallback

fun merge(a, b)
    # new map: everything in a, then b on top
    let out = {}
    for k in a
        out[k] = a[k]
    for k in b
        out[k] = b[k]
    return out

fun drop(m, k)
    # removes k from m in place if it is there; true if it was. The built-in
    # remove fails on a missing key, and a module that defines its own remove
    # (std/vfs) hides the built-in: this reaches it from here.
    if k in m
        remove(m, k)
        return true
    return false
