# std/maps: map helpers. keys and remove are built in. Since 1.0.49 a value
# that is not a map fails as "maps.values(): m must be a map, got int".

fun _map(name, what, m)
    if type(m) != "map"
        fail("maps." + name + "(): " + what + " must be a map, got " + type(m))

fun values(m)
    _map("values", "m", m)
    let out = []
    for k in m
        append(out, m[k])
    return out

fun items(m)
    _map("items", "m", m)
    # list of [key, value] pairs, in insertion order
    let out = []
    for k in m
        append(out, [k, m[k]])
    return out

fun get(m, k, fallback)
    _map("get", "m", m)
    if k in m
        return m[k]
    return fallback

fun merge(a, b)
    _map("merge", "a", a)
    _map("merge", "b", b)
    # new map: everything in a, then b on top
    let out = {}
    for k in a
        out[k] = a[k]
    for k in b
        out[k] = b[k]
    return out

fun drop(m, k)
    _map("drop", "m", m)
    # removes k from m in place if it is there; true if it was. The built-in
    # remove fails on a missing key, and a module that defines its own remove
    # (std/vfs) hides the built-in: this reaches it from here.
    if k in m
        remove(m, k)
        return true
    return false

# Since 1.0.49: a new map from [key, value] pairs, what items gives back; a
# later pair with the same key wins. Each item must be a list of two with a
# string key.
fun from_items(pairs)
    if type(pairs) != "list"
        fail("maps.from_items(): pairs must be a list, got " + type(pairs))
    let out = {}
    let i = 0
    for p in pairs
        if type(p) != "list" or len(p) != 2 or type(p[0]) != "string"
            fail("maps.from_items(): item " + str(i) + " is not a [string key, value] pair")
        out[p[0]] = p[1]
        i = i + 1
    return out
