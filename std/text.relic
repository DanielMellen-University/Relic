# std/text: more text helpers, on top of std/strings. Case and splitting
# that look at words, and a few tests strings does not have.
use std/strings

fun _text(name, what, s)
    if type(s) != "string"
        fail("text." + name + "(): " + what + " must be a string, got " + type(s))

# true when s is empty or every character is space, tab, newline or CR.
fun is_blank(s)
    _text("is_blank", "argument", s)
    for c in s
        if not strings.is_space(c)
            return false
    return true

# [the text before sep, sep, the text after] for the first sep. When sep is
# not there, the result is [s, "", ""]. An empty sep is an error.
fun partition(s, sep)
    _text("partition", "text", s)
    _text("partition", "separator", sep)
    if sep == ""
        fail("text.partition(): separator must not be empty")
    let i = strings.find(s, sep)
    if i < 0
        return [s, "", ""]
    return [slice(s, 0, i), sep, slice(s, i + len(sep), len(s))]

