# std/paths: path text helpers. Paths use "/"; "\" is read as "/" too. A
# path that is not a string is "paths.base(): path must be a string, got int"
# (since 1.0.49; before, "cannot loop over an int").

# The characters of p with "\" as "/". A list, since indexing a string walks
# it from the start, and joined in halves, since adding one character at a time
# copies the text each time: both took time growing with the square of the length.
fun _chars(p, name)
    if type(p) != "string"
        fail("paths." + name + "(): path must be a string, got " + type(p))
    let cs = []
    for c in p
        if c == "\\"
            append(cs, "/")
        else
            append(cs, c)
    return cs

fun _glue(xs, a, b)
    if b - a <= 16
        let out = ""
        for i in a..b
            out = out + xs[i]
        return out
    let m = a + int((b - a) / 2)
    return _glue(xs, a, m) + _glue(xs, m, b)

fun _fix(p, name)
    let cs = _chars(p, name)
    return _glue(cs, 0, len(cs))

fun _last_slash(p)
    let cut = -1
    let i = 0
    for c in p
        if c == "/"
            cut = i
        i = i + 1
    return cut

# join(a, b): b on its own if it starts with "/", else a + "/" + b.
fun join(a, b)
    let x = _fix(a, "join")
    let y = _fix(b, "join")
    if x == "" or (len(y) > 0 and y[0] == "/")
        return y
    if x[len(x) - 1] == "/"
        return x + y
    return x + "/" + y

# base("a/b/c.txt") is "c.txt": what is after the last slash, so a path
# ending in / gives "".
fun base(p)
    let x = _fix(p, "base")
    return slice(x, _last_slash(x) + 1, len(x))

# dir("a/b/c.txt") is "a/b"; dir("c.txt") is "". Doubled slashes before the
# name go too, so dir("a//b") is "a" (since 1.0.52; it was "a/"), and a path
# with only slashes before the name gives "/".
fun dir(p)
    let x = _fix(p, "dir")
    let cut = _last_slash(x)
    if cut < 0
        return ""
    while cut > 0 and x[cut - 1] == "/"
        cut = cut - 1
    if cut == 0
        return "/"
    return slice(x, 0, cut)

# ext("notes.txt") is ".txt"; "" when there is none. Leading dots are part of the
# name, so ".hidden", ".." and "...a" have none.
fun ext(p)
    _chars(p, "ext")
    let b = _chars(base(p), "ext")
    let start = 0
    while start < len(b) and b[start] == "."
        start = start + 1
    let i = len(b) - 1
    while i > start
        if b[i] == "."
            return _glue(b, i, len(b))
        i = i - 1
    return ""

# stem("a.tar.gz") is "a.tar": the base without its ext, and a dotfile such
# as ".bashrc" keeps its whole name (it has no ext).
fun stem(p)
    _chars(p, "stem")
    return slice(base(p), 0, len(base(p)) - len(ext(p)))

# normalize: folds "." and "dir/.." away and drops doubled slashes.
fun normalize(p)
    let x = _chars(p, "normalize")
    let absolute = len(x) > 0 and x[0] == "/"
    let parts = []
    let start = 0
    append(x, "/")
    for i in 0..len(x)
        if x[i] == "/"
            let cur = _glue(x, start, i)
            if cur == ".." and len(parts) > 0 and parts[len(parts) - 1] != ".."
                pop(parts)
            else if cur == ".." and absolute
                cur = ""
            else if cur != "." and cur != ""
                append(parts, cur)
            start = i + 1
    let out = []
    for i in 0..len(parts)
        if i > 0
            append(out, "/")
        append(out, parts[i])
    let text = _glue(out, 0, len(out))
    if absolute
        return "/" + text
    if text == ""
        return "."
    return text

# Since 1.0.50: the names in a path after normalize, in order; an absolute
# path starts with "/" as its first part, and "." (the empty path) has none.
fun parts(p)
    _chars(p, "parts")
    let n = normalize(p)
    let out = []
    if slice(n, 0, 1) == "/"
        append(out, "/")
    let name = ""
    for c in n
        if c == "/"
            if name != ""
                append(out, name)
            name = ""
        else
            name = name + c
    if name != "" and name != "."
        append(out, name)
    return out

# Since 1.0.50: whether p starts at the root, "/" (or "\").
fun is_abs(p)
    let x = _fix(p, "is_abs")
    return len(x) > 0 and x[0] == "/"

# Since 1.0.50: p with its ext (as ext() finds it) swapped for e, which
# should start with a dot; an e of "" takes the ext off.
fun with_ext(p, e)
    let x = _fix(p, "with_ext")
    if type(e) != "string"
        fail("paths.with_ext(): ext must be a string, got " + type(e))
    # since 1.0.52: "txt" made "atxt" of "a.md", and a "/" made a new folder
    if e != "" and (slice(e, 0, 1) != "." or host_find(e, "/") >= 0 or host_find(e, "\\") >= 0)
        fail("paths.with_ext(): ext must be \"\" or start with a dot and hold no /, got \"" + e + "\"")
    return slice(x, 0, len(x) - len(ext(x))) + e

# Since 1.0.50: the path that leads from the folder base to target, with ".."
# for each folder to go up: relative("/a/b", "/a/c/d") is "../c/d". Both must
# be absolute or both relative, and base must not climb past its start.
fun relative(base, target)
    let b = parts(_fix(base, "relative"))
    let t = parts(_fix(target, "relative"))
    let b_abs = len(b) > 0 and b[0] == "/"
    let t_abs = len(t) > 0 and t[0] == "/"
    if b_abs != t_abs
        fail("paths.relative(): both paths must be absolute, or both relative, got " + base + " and " + target)
    for name in b
        if name == ".."
            fail("paths.relative(): base must not go up past its start, got " + base)
    let i = 0
    while i < len(b) and i < len(t) and b[i] == t[i]
        i = i + 1
    let out = []
    for j in i..len(b)
        append(out, "..")
    for j in i..len(t)
        append(out, t[j])
    if len(out) == 0
        return "."
    return _join_names(out)

fun _join_names(names)
    let s = names[0]
    for k in 1..len(names)
        s = s + "/" + names[k]
    return s
