# std/files: read and write text files. Paths are relative to where relic runs.
use std/strings

# read gives the whole file as text, or fails as "files.read(): cannot open
# {path}";
# write replaces the file (making it when missing), append_text adds to its
# end. None of them adds a newline.
fun read(path) = host_read_file(path)
fun write(path, text) = host_write_file(path, text, false)
fun append_text(path, text) = host_write_file(path, text, true)
fun exists(path) = host_file_exists(path)

fun lines(path) = strings.lines(read(path))

# Folders. list gives names (not full paths), sorted.
fun list(path) = host_list_dir(path)
fun is_dir(path) = host_is_dir(path)
fun make_dir(path) = host_make_dir(path)       # makes parent folders too
fun remove(path) = host_remove(path)           # a file or an empty folder
# A folder is not renamed: rename moves a file only, so renaming a folder
# fails as "files.rename(): cannot rename {from}". The type check keeps a
# non-string from failing as before, from host_rename, not from is_dir.
fun rename(from, to)
    if type(from) == "string" and is_dir(from)
        fail("files.rename(): cannot rename " + from)
    host_rename(from, to)
fun size(path) = host_file_size(path)          # in bytes

# remove_tree(path): a folder and everything in it, or one file.
# Missing path is a no-op (like `rm -rf`). A link goes as the link: since
# 1.0.52 the path is removed first, which takes a file, an empty folder or a
# link, and only a folder that is not empty is gone into. Before, a link to a
# folder was followed and what it pointed at was removed too.
fun remove_tree(path)
    try
        host_remove(path)
        return
    catch e
        if not host_is_dir(path)
            if host_file_exists(path)
                fail(e.message)
            return
    for name in host_list_dir(path)
        remove_tree(path + "/" + name)
    host_remove(path)
