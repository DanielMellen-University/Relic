# std/files: read and write text files. Paths are relative to where relic runs.
use std/strings

fun read(path) = host_read_file(path)
fun write(path, text) = host_write_file(path, text, false)
fun append_text(path, text) = host_write_file(path, text, true)
fun exists(path) = host_file_exists(path)

fun lines(path)
    let parts = strings.split(strings.replace(read(path), chr(13) + "\n", "\n"), "\n")
    if len(parts) > 0 and parts[len(parts) - 1] == ""
        pop(parts)
    return parts

# Folders. list gives names (not full paths), sorted.
fun list(path) = host_list_dir(path)
fun is_dir(path) = host_is_dir(path)
fun make_dir(path) = host_make_dir(path)       # makes parent folders too
fun remove(path) = host_remove(path)           # a file or an empty folder
fun rename(from, to) = host_rename(from, to)
fun size(path) = host_file_size(path)          # in bytes

# remove_tree(path): a folder and everything in it, or one file.
# Missing path is a no-op (like `rm -rf`).
fun remove_tree(path)
    if host_is_dir(path)
        for name in host_list_dir(path)
            remove_tree(path + "/" + name)
        host_remove(path)
    else if host_file_exists(path)
        host_remove(path)
