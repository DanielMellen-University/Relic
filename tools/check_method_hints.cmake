# The method-hint table is copied by hand into the C runtime, the host
# tree-walker and the self-hosted interpreter. This fails when those copies
# differ, or when an entry names a function that is not there.
#   cmake -DSRC=source/dir -P tools/check_method_hints.cmake
#
# A spell module.name must be `fun name(` in std/module.relic.
# A spell with no dot is a language built-in (append, len, keys, ...) and must
# be in g_core in runtime/c/rl_builtins.c. Those are not defined in std/.
cmake_minimum_required(VERSION 3.16)
if(NOT SRC)
  message(FATAL_ERROR "usage: cmake -DSRC=source/dir -P tools/check_method_hints.cmake")
endif()

function(c_table path outvar)
  file(READ "${path}" text)
  # Entries are {"type", "name", "spell"}, so the body itself contains '}'.
  # The initializer ends at the first semicolon.
  string(REGEX MATCH "kMethods\\[\\] = \\{([^;]*);" found "${text}")
  if(NOT found)
    message(FATAL_ERROR "${path}: no kMethods table")
  endif()
  set(body "${CMAKE_MATCH_1}")
  string(REGEX MATCHALL "\\{\"[a-z]+\", \"[a-z_]+\", \"[a-z_.]+\"\\}" rows "${body}")
  set(lines "")
  foreach(row ${rows})
    string(REGEX MATCH "\\{\"([a-z]+)\", \"([a-z_]+)\", \"([a-z_.]+)\"\\}" ok "${row}")
    string(APPEND lines "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3}\n")
  endforeach()
  if(lines STREQUAL "")
    message(FATAL_ERROR "${path}: kMethods table is empty")
  endif()
  set(${outvar} "${lines}" PARENT_SCOPE)
endfunction()

function(relic_table path outvar)
  file(READ "${path}" text)
  set(lines "")
  foreach(type list map string)
    string(REGEX MATCH "let method_for_${type} = \\{([^}]*)\\}" found "${text}")
    if(NOT found)
      message(FATAL_ERROR "${path}: no method_for_${type}")
    endif()
    set(body "${CMAKE_MATCH_1}")
    string(REGEX MATCHALL "[a-z_]+: \"[a-z_.]+\"" rows "${body}")
    if(rows STREQUAL "")
      message(FATAL_ERROR "${path}: method_for_${type} is empty")
    endif()
    foreach(row ${rows})
      string(REGEX MATCH "([a-z_]+): \"([a-z_.]+)\"" ok "${row}")
      string(APPEND lines "${type} ${CMAKE_MATCH_1} ${CMAKE_MATCH_2}\n")
    endforeach()
  endforeach()
  set(${outvar} "${lines}" PARENT_SCOPE)
endfunction()

c_table("${SRC}/runtime/c/rl_ops.c" from_c)
c_table("${SRC}/src/interp/interp.cpp" from_cpp)
relic_table("${SRC}/selfhost/interp.relic" from_relic)

if(NOT from_c STREQUAL from_cpp)
  message(FATAL_ERROR "method hint tables differ: runtime/c/rl_ops.c and src/interp/interp.cpp\n--- rl_ops.c\n${from_c}--- interp.cpp\n${from_cpp}")
endif()
if(NOT from_c STREQUAL from_relic)
  message(FATAL_ERROR "method hint tables differ: runtime/c/rl_ops.c and selfhost/interp.relic\n--- rl_ops.c\n${from_c}--- interp.relic\n${from_relic}")
endif()

file(READ "${SRC}/runtime/c/rl_builtins.c" builtins)
string(REGEX MATCH "static const rl_builtin_def g_core\\[\\] = \\{([^;]*);" found "${builtins}")
if(NOT found)
  message(FATAL_ERROR "runtime/c/rl_builtins.c: no g_core table")
endif()
set(core "${CMAKE_MATCH_1}")

string(REPLACE "\n" ";" entries "${from_c}")
set(n 0)
foreach(e ${entries})
  if(e STREQUAL "")
    continue()
  endif()
  string(REGEX MATCH "^([a-z]+) ([a-z_]+) ([a-z_.]+)$" ok "${e}")
  if(NOT ok)
    message(FATAL_ERROR "bad table row: ${e}")
  endif()
  set(spell "${CMAKE_MATCH_3}")
  math(EXPR n "${n} + 1")
  if(spell MATCHES "^([a-z]+)[.]([a-z_]+)$")
    set(mod "${CMAKE_MATCH_1}")
    set(fn "${CMAKE_MATCH_2}")
    set(stdfile "${SRC}/std/${mod}.relic")
    if(NOT EXISTS "${stdfile}")
      message(FATAL_ERROR "${spell}: std/${mod}.relic does not exist")
    endif()
    file(READ "${stdfile}" stdtext)
    string(REGEX MATCH "(^|\n)fun ${fn}\\(" defined "${stdtext}")
    if(NOT defined)
      message(FATAL_ERROR "${spell}: fun ${fn}( is missing from std/${mod}.relic")
    endif()
  else()
    string(FIND "${core}" "{\"${spell}\"," at)
    if(at LESS 0)
      message(FATAL_ERROR "${spell}: not a function in std/ and not a language built-in in rl_builtins.c")
    endif()
  endif()
endforeach()
message("method hint tables match: ${n} entries, each names a real function")
