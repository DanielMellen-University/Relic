# The program counts that docs/TESTING.md and docs/CGEN.md quote must match the
# files in the tree, so a new golden cannot leave the docs saying the old number.
#   cmake -DSRC=source/dir -P tools/check_doc_counts.cmake
file(GLOB goldens ${SRC}/tests/golden/*.relic)
set(programs 0)
set(compiled 0)
foreach(f ${goldens})
  get_filename_component(n ${f} NAME_WE)
  if(n MATCHES "^repl_")
    continue()
  endif()
  math(EXPR programs "${programs}+1")
  if(NOT EXISTS ${SRC}/tests/golden/${n}.args)
    math(EXPR compiled "${compiled}+1")
  endif()
endforeach()
# what selfhost_lexer and selfhost_parser read: goldens, their helper modules, std/, selfhost/ and the check cases
file(GLOB lexed ${SRC}/tests/golden/*.relic ${SRC}/tests/golden/modules/*.relic ${SRC}/std/*.relic ${SRC}/selfhost/*.relic ${SRC}/tests/check_cases/*.relic)
list(LENGTH lexed lexed_count)

file(READ ${SRC}/docs/TESTING.md testing)
file(READ ${SRC}/docs/CGEN.md cgen)
set(bad 0)
function(want label text pattern)
  if(NOT text MATCHES "${pattern}")
    message("${label}: the docs do not say '${pattern}'")
    set(bad 1 PARENT_SCOPE)
  endif()
endfunction()
want("selfhost_lexer count" "${testing}" "selfhost_lexer[^\n]*\\(${lexed_count} today\\)")
want("selfhost_interp count" "${testing}" "selfhost_interp[^\n]*\\(${programs} today\\)")
want("vm_matches_tree_walker count" "${testing}" "vm_matches_tree_walker[^\n]*\\(${programs} today\\)")
want("TESTING compiled count" "${testing}" "cgen_name` \\(${compiled} cases\\)")
want("TESTING default build" "${testing}" "${compiled} compiled goldens")
want("CGEN own goldens" "${cgen}" "its own ${compiled} compiled goldens")
want("CGEN today" "${cgen}" "Today: ${compiled} cases")
if(bad)
  message(FATAL_ERROR "docs out of date: ${programs} programs, ${compiled} compiled, ${lexed_count} lexed files")
endif()
message("docs counts match: ${programs} programs, ${compiled} compiled, ${lexed_count} lexed files")
