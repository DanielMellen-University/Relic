# Checks the inline examples in docs/STDLIB.md: each `call(args)` → `value`
# (or "is" / "gives" in place of →) in a std/NAME section is run as NAME.call(args)
# and must print value. A value that is not a literal (a number, a string, a
# list, a map, true, false, none, nan, inf) or a call with ^ in it (2^63 is
# notation) is left out. std/graphics is skipped: what it returns depends on
# whether the build has SDL (available() is false without it, true with it).
#   cmake -DRELIC=path/to/relic -DSRC=source/dir -DTMP=dir -P tools/check_stdlib_examples.cmake
file(REMOVE_RECURSE ${TMP})
file(MAKE_DIRECTORY ${TMP})
file(READ ${SRC}/docs/STDLIB.md doc)
# Per-module reference pages (docs/stdlib/*.md) use the same `call` → `value`
# lines. graphics stays skipped: available() depends on the build.
file(GLOB ref_docs ${SRC}/docs/stdlib/*.md)
foreach(extra ${ref_docs})
  file(READ ${extra} extra_text)
  string(APPEND doc "\n${extra_text}")
endforeach()
string(REGEX MATCHALL "\n## std/[a-z]+|`[a-z_]+\\([^`]*\\)` (→|is|gives) `[^`]+`" found "${doc}")
set(mod "")
set(uses "")
set(body "fun _show(v)\n    if type(v) == \"string\"\n        return \"\\\"\" + v + \"\\\"\"\n    return str(v)\n")
set(n 0)
foreach(item IN LISTS found)
  if(item MATCHES "^\n## std/([a-z]+)$")
    set(mod ${CMAKE_MATCH_1})
    if(mod STREQUAL "graphics")
      set(mod "")
    endif()
    continue()
  endif()
  if(mod STREQUAL "" OR NOT item MATCHES "^`([a-z_]+\\([^`]*\\))` [^`]+ `([^`]+)`$")
    continue()
  endif()
  set(call "${CMAKE_MATCH_1}")
  set(want "${CMAKE_MATCH_2}")
  if(call MATCHES "\\^" OR NOT want MATCHES "^(-?[0-9]|\"|\\[|\\{|true$|false$|none$|nan$|-?inf$)")
    continue()
  endif()
  if(NOT uses MATCHES "use std/${mod}\n")
    string(APPEND uses "use std/${mod}\n")
  endif()
  string(REPLACE "\\" "\\\\" want_lit "${want}")
  string(REPLACE "\"" "\\\"" want_lit "${want_lit}")
  string(REPLACE "{" "{{" want_lit "${want_lit}")
  string(REPLACE "}" "}}" want_lit "${want_lit}")
  string(REPLACE "\\" "\\\\" call_lit "${mod}.${call}")
  string(REPLACE "\"" "\\\"" call_lit "${call_lit}")
  string(REPLACE "{" "{{" call_lit "${call_lit}")
  string(REPLACE "}" "}}" call_lit "${call_lit}")
  string(APPEND body "if _show(${mod}.${call}) != \"${want_lit}\"\n    print(\"${call_lit} is \" + _show(${mod}.${call}) + \", the doc says ${want_lit}\")\n")
  math(EXPR n "${n} + 1")
endforeach()
if(n LESS 10)
  message(FATAL_ERROR "only ${n} STDLIB.md examples found; did the format change?")
endif()
file(WRITE ${TMP}/examples.relic "${uses}${body}print(\"checked ${n}\")\n")
execute_process(COMMAND ${RELIC} examples.relic WORKING_DIRECTORY ${TMP}
  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code)
string(REPLACE "\r\n" "\n" out "${out}")
if(NOT code EQUAL 0 OR NOT out STREQUAL "checked ${n}\n")
  message(FATAL_ERROR "STDLIB.md examples (exit ${code}):\n${out}${err}")
endif()
message("${n} std reference examples give what the docs say")
include(${CMAKE_CURRENT_LIST_DIR}/check_example_programs.cmake)
