# Bytecode VM check (M10): `relic FILE` (the VM) must give the same stdout
# and stderr, and exit with the same code, as `relic --tree FILE` (the tree-walker) for every golden program
# except repl_*, which are typed into the REPL.
file(GLOB files ${SRC}/tests/golden/*.relic)
set(bad 0)
set(total 0)
foreach(f ${files})
  get_filename_component(n ${f} NAME_WE)
  if(n MATCHES "^repl_")
    continue()
  endif()
  math(EXPR total "${total}+1")
  get_filename_component(dir ${f} DIRECTORY)
  set(stdin_file ${dir}/${n}.in)
  if(NOT EXISTS ${stdin_file})
    set(stdin_file ${SRC}/tools/empty.in)
  endif()
  execute_process(COMMAND ${RELIC} --tree ${f} INPUT_FILE ${stdin_file} WORKING_DIRECTORY ${dir} OUTPUT_VARIABLE a_out ERROR_VARIABLE a_err RESULT_VARIABLE a_code)
  execute_process(COMMAND ${RELIC} ${f} INPUT_FILE ${stdin_file} WORKING_DIRECTORY ${dir} OUTPUT_VARIABLE b_out ERROR_VARIABLE b_err RESULT_VARIABLE b_code)
  if(NOT a_out STREQUAL b_out OR NOT a_err STREQUAL b_err OR NOT a_code STREQUAL b_code)
    message("mismatch: ${n}\n--- tree-walker (exit ${a_code})\n${a_out}${a_err}--- vm (exit ${b_code})\n${b_out}${b_err}")
    math(EXPR bad "${bad}+1")
  endif()
endforeach()
if(bad GREATER 0)
  message(FATAL_ERROR "${bad} of ${total} programs differ")
endif()
message("all ${total} programs match")
