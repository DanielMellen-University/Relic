# Compare real runtime failures, not lexer failures or generated error stubs.
include(${SRC}/tools/compare_byte_output.cmake)
set(COMPARE_TMP "${TMP}")
file(MAKE_DIRECTORY "${COMPARE_TMP}")
compare_capture(host ${RELIC} --vm "${TEST}")
if(NOT CAPTURE_host_CODE STREQUAL "1")
  message(FATAL_ERROR "host did not report a runtime error: ${CAPTURE_host_CODE}")
endif()
file(READ "${COMPARE_TMP}/host.err" err)
if(NOT err MATCHES "error: division by zero\n")
  message(FATAL_ERROR "expected a division-by-zero runtime diagnostic")
endif()
# Pin the intended byte window independently of engine agreement. This also
# fails before the original host repair, when both engines retained 161 bytes.
get_filename_component(name "${TEST}" NAME_WE)
if(name STREQUAL "edge_continuation_0")
  string(REPEAT "a" 146 pad)
  set(want "${TEST}:1:9: error: division by zero\n    print(1 / 0) #${pad}\n            ^\n")
  if(NOT err STREQUAL want)
    message(FATAL_ERROR "isolated byte at the right edge changed the 160-byte window")
  endif()
endif()
compare_capture(tree ${RELIC} --tree "${TEST}")
compare_capture(selfhost ${RELIC} ${SRC}/selfhost/run.relic "${TEST}")
compare_capture(compiled ${EXE})
foreach(engine tree selfhost compiled)
  captures_equal(host ${engine} equal)
  if(NOT equal)
    message(FATAL_ERROR "${name}: ${engine} runtime diagnostic differs from host; captures: ${COMPARE_TMP}")
  endif()
endforeach()
