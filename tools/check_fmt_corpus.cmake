# Feed the compiled verifier every source, excluding build output. It checks
# lex/parse acceptance, token preservation, idempotence and optional host parity.
file(MAKE_DIRECTORY ${TMP})
file(GLOB_RECURSE corpus LIST_DIRECTORIES false ${SRC}/*.relic)
set(manifest "${TMP}/sources.txt")
file(WRITE "${manifest}" "")
get_filename_component(build_abs "${CMAKE_BINARY_DIR}" ABSOLUTE)
set(count 0)
foreach(src ${corpus})
  file(RELATIVE_PATH rel "${SRC}" "${src}")
  string(FIND "${src}/" "${build_abs}/" in_build)
  if(rel MATCHES "(^|/)build" OR (in_build EQUAL 0 AND NOT build_abs STREQUAL SRC))
    continue()
  endif()
  file(APPEND "${manifest}" "${src}\n")
  math(EXPR count "${count}+1")
endforeach()
if(count LESS 1)
  message(FATAL_ERROR "no source files in formatter corpus")
endif()
execute_process(COMMAND ${VERIFY} ${TOOL} "${manifest}" "${TMP}/once.relic" "${RELIC}"
  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code TIMEOUT 180)
if(NOT code EQUAL 0 OR NOT err STREQUAL "")
  message(FATAL_ERROR "formatter corpus verification: exit ${code}\n${out}${err}")
endif()
message("${out}")
