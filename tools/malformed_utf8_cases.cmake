# Generated in the build tree so fixtures can contain arbitrary source bytes.
set(utf8_dir "${CMAKE_CURRENT_BINARY_DIR}/malformed_utf8")
file(MAKE_DIRECTORY "${utf8_dir}")
string(ASCII 128 continuation)
string(ASCII 226 broken_lead)
string(ASCII 192 128 overlong)
string(ASCII 237 160 128 surrogate)
string(ASCII 244 144 128 128 out_of_range)
string(ASCII 195 169 valid)
string(REPEAT "a" 146 edge_pad)
string(REPEAT "a" 170 long_pad)
set(utf8_cases)
# The first case is the reported 160/161-byte discrepancy. Shaped sequences
# (even invalid scalars) stay together; isolated bytes each form one group.
foreach(kind continuation broken_lead overlong surrogate out_of_range valid)
  foreach(offset 0 1)
    set(name "edge_${kind}_${offset}")
    math(EXPR count "146 - ${offset}")
    string(REPEAT "a" ${count} pad)
    file(WRITE "${utf8_dir}/${name}.relic" "print(1 / 0) #${pad}${${kind}}z\n")
    list(APPEND utf8_cases ${name})
  endforeach()
endforeach()
# Exercise caret padding and walking the left edge past a malformed group.
foreach(kind continuation broken_lead)
  foreach(position short before inside)
    set(name "${position}_${kind}")
    if(position STREQUAL "short")
      set(content "${${kind}}x")
    elseif(position STREQUAL "before")
      set(content "${${kind}}${long_pad}")
    else()
      set(content "${long_pad}${${kind}}")
    endif()
    file(WRITE "${utf8_dir}/${name}.relic" "print(len(\"${content}\") / 0) #${long_pad}\n")
    list(APPEND utf8_cases ${name})
  endforeach()
endforeach()
