# The command line as docs/CLI.md describes it: exit codes, usage errors, args
# passed through, relic check, and the REPL on piped input.
#   cmake -DRELIC=path/to/relic -DSRC=source/dir -DTMP=scratch/dir -P tools/check_cli.cmake
file(MAKE_DIRECTORY ${TMP})
file(WRITE ${TMP}/args.relic "print(args())\n")
file(WRITE ${TMP}/clean.relic "let x = 1\nprint(x)\n")
file(WRITE ${TMP}/typo.relic "print(prnt)\n")
file(WRITE ${TMP}/exit3.relic "use std/os\nprint(\"before\")\nos.exit(3)\nprint(\"after\")\n")
file(WRITE ${TMP}/boom.relic "print(\"before\")\nprint(1 / 0)\n")
file(WRITE ${TMP}/chunks.relic "print(1 / 0)\nprint(\"still here\")\n")

# expect(label code out_regex err_regex ARGS...); stdin from the variable `stdin_file` if set
function(expect label code out_re err_re)
  if(stdin_file)
    execute_process(COMMAND ${RELIC} ${ARGN} WORKING_DIRECTORY ${TMP} INPUT_FILE ${stdin_file}
      OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE got)
  else()
    execute_process(COMMAND ${RELIC} ${ARGN} WORKING_DIRECTORY ${TMP}
      OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE got)
  endif()
  string(REPLACE "\r\n" "\n" out "${out}")
  string(REPLACE "\r\n" "\n" err "${err}")
  if(NOT got STREQUAL code)
    message(FATAL_ERROR "${label}: exit ${got}, wanted ${code}\n${out}${err}")
  endif()
  if(NOT out MATCHES "${out_re}")
    message(FATAL_ERROR "${label}: stdout did not match '${out_re}'\n${out}")
  endif()
  if(NOT err MATCHES "${err_re}")
    message(FATAL_ERROR "${label}: stderr did not match '${err_re}'\n${err}")
  endif()
endfunction()

function(expect_exact label code want_out want_err)
  execute_process(COMMAND ${RELIC} ${ARGN} WORKING_DIRECTORY ${TMP}
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE got)
  string(REPLACE "\r\n" "\n" out "${out}")
  string(REPLACE "\r\n" "\n" err "${err}")
  if(NOT got STREQUAL code OR NOT out STREQUAL want_out OR NOT err STREQUAL want_err)
    message(FATAL_ERROR "${label}: exit ${got}, wanted ${code}\n--- stdout\n${out}--- wanted stdout\n${want_out}--- stderr\n${err}--- wanted stderr\n${want_err}")
  endif()
endfunction()

set(usage "^usage: relic ")

expect("version" 0 "^relic [0-9]+\\.[0-9]+\\.[0-9]+\n$" "^$" --version)
expect("help" 0 "^$" "${usage}" --help)
expect("help with extra words" 2 "^$" "${usage}" --help extra)
expect("version with extra words" 2 "^$" "${usage}" --version extra)
expect("unknown flag" 2 "^$" "${usage}" --bogus)
expect("--vm without a file" 2 "^$" "${usage}" --vm)
expect("--tree without a file" 2 "^$" "${usage}" --tree)
expect("--tokens without a file" 2 "^$" "${usage}" --tokens)
expect("--ast with extra words" 2 "^$" "${usage}" --ast clean.relic extra)
expect("--bytecode with extra words" 2 "^$" "${usage}" --bytecode clean.relic extra)
expect("missing file" 2 "^$" "^relic: cannot open nofile.relic\n$" nofile.relic)
expect("missing file, --tokens" 2 "^$" "^relic: cannot open nofile.relic\n$" --tokens nofile.relic)
expect("missing file, --ast" 2 "^$" "^relic: cannot open nofile.relic\n$" --ast nofile.relic)
expect("missing file, --bytecode" 2 "^$" "^relic: cannot open nofile.relic\n$" --bytecode nofile.relic)
expect("a folder is not a file" 2 "^$" "^relic: cannot open \\.\n$" .)
expect("a folder after --tree" 2 "^$" "^relic: cannot open \\.\n$" --tree .)
expect("a folder, --tokens" 2 "^$" "^relic: cannot open \\.\n$" --tokens .)
expect("a folder, --ast" 2 "^$" "^relic: cannot open \\.\n$" --ast .)
expect("a folder, --bytecode" 2 "^$" "^relic: cannot open \\.\n$" --bytecode .)
expect("missing file after --tree" 2 "^$" "^relic: cannot open nofile.relic\n$" --tree nofile.relic)

# Anything after the file goes to the program, flags included, on every engine.
expect("args" 0 "^\\[\"--x\", \"y\"\\]\n$" "^$" args.relic --x y)
expect("args, --tree" 0 "^\\[\"--x\"\\]\n$" "^$" --tree args.relic --x)
expect("args, --vm" 0 "^\\[\"1\"\\]\n$" "^$" --vm args.relic 1)
expect_exact("args with spaces and flags" 0 "[\"two words\", \"--x\"]\n" "" args.relic "two words" --x)
expect_exact("args with spaces and flags, --tree" 0 "[\"two words\", \"--x\"]\n" "" --tree args.relic "two words" --x)

# Exit codes of a run: error 1, os.exit(n) as given, output before either is kept.
expect("runtime error" 1 "^before\n$" "division by zero" boom.relic)
expect("runtime error, --tree" 1 "^before\n$" "division by zero" --tree boom.relic)
expect("os.exit" 3 "^before\n$" "^$" exit3.relic)

# Module lex/parse errors retain their source span and hint on both engines.
file(WRITE ${TMP}/module_main.relic "use module_lex_bad\n")
file(WRITE ${TMP}/module_lex_bad.relic "print(1 && 2)\n")
set(module_lex_error "module_lex_bad.relic:1:9: error: unexpected '&&'\n    print(1 && 2)\n            ^^\nhint: Relic uses 'and', not '&&'\n")
expect_exact("module lexer note" 1 "" "${module_lex_error}" module_main.relic)
expect_exact("module lexer note, --tree" 1 "" "${module_lex_error}" --tree module_main.relic)
expect_exact("module lexer note, self-host" 1 "" "${module_lex_error}" ${SRC}/selfhost/run.relic module_main.relic)
file(WRITE ${TMP}/module_parse_bad.relic "let x as integer = 1\n")
file(WRITE ${TMP}/module_main.relic "use module_parse_bad\n")
set(module_parse_error "module_parse_bad.relic:1:10: error: unknown type 'integer'; use any, none, bool, int, float, number, string, list, map, function or module\n    let x as integer = 1\n             ^^^^^^^\nhint: did you mean 'int'?\n")
expect_exact("module parser note" 1 "" "${module_parse_error}" module_main.relic)
expect_exact("module parser note, --tree" 1 "" "${module_parse_error}" --tree module_main.relic)
expect_exact("module parser note, self-host" 1 "" "${module_parse_error}" ${SRC}/selfhost/run.relic module_main.relic)

# relic check
expect("check clean" 0 "^$" "^$" check clean.relic)
expect("check typo" 1 "^$" "typo.relic:1:7: warning: 'prnt' is not defined \\(did you mean 'print'\\?\\)" check typo.relic)
expect("check several" 1 "^$" "typo.relic:1:7: warning" check clean.relic typo.relic)
set(check_mixed_error "relic: cannot open nofile.relic\ntypo.relic:1:7: warning: 'prnt' is not defined (did you mean 'print'?)\n    print(prnt)\n          ^\n")
expect_exact("check warning and missing file" 2 "" "${check_mixed_error}" check clean.relic nofile.relic typo.relic)
expect("check missing" 2 "^$" "^relic: cannot open nofile.relic\n$" check nofile.relic)
expect("check a folder" 2 "^$" "^relic: cannot open \\.\n$" check .)
expect("check without files" 2 "^$" "${usage}" check)
file(WRITE ${TMP}/warnings_a.relic "print(first_unknown)\nprint(second_unknown)\n")
file(WRITE ${TMP}/warnings_b.relic "print(third_unknown)\nprint(fourth_unknown)\n")
set(check_order_error "warnings_b.relic:1:7: warning: 'third_unknown' is not defined\n    print(third_unknown)\n          ^\nwarnings_b.relic:2:7: warning: 'fourth_unknown' is not defined\n    print(fourth_unknown)\n          ^\nwarnings_a.relic:1:7: warning: 'first_unknown' is not defined\n    print(first_unknown)\n          ^\nwarnings_a.relic:2:7: warning: 'second_unknown' is not defined\n    print(second_unknown)\n          ^\n")
expect_exact("check file and finding order" 1 "" "${check_order_error}" check warnings_b.relic warnings_a.relic)

# The REPL on piped input: no prompts, an error does not stop it, exit 0
set(stdin_file ${TMP}/chunks.relic)
expect("repl pipe" 0 "^still here\n$" "<repl>:1:9: error: division by zero" )
message("command line matches CLI.md")
