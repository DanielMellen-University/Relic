# Self-host check (M9): the Relic parser in selfhost/ must print exactly what
# `relic --ast` prints, for every .relic source (errors included).
#   cmake -DRELIC=path/to/relic -DSRC=source/dir -P tools/compare_parsers.cmake
# With -DTOOL=path, compare the compiled self-hosted parser instead.
include(${CMAKE_CURRENT_LIST_DIR}/compare_byte_output.cmake)
file(GLOB files ${SRC}/tests/golden/*.relic ${SRC}/tests/golden/modules/*.relic ${SRC}/std/*.relic ${SRC}/selfhost/*.relic ${SRC}/tests/check_cases/*.relic)
if(TOOL)
  set(compare_name cgen_selfhost_parser)
else()
  set(compare_name selfhost_parser)
endif()
set(COMPARE_TMP "${CMAKE_CURRENT_BINARY_DIR}/${compare_name}")
file(MAKE_DIRECTORY "${COMPARE_TMP}")
set(bad 0)
foreach(f ${files})
  compare_capture(host "${RELIC}" --ast "${f}")
  if(TOOL)
    compare_capture(relic "${TOOL}" "${f}")
  else()
    compare_capture(relic "${RELIC}" "${SRC}/selfhost/ast.relic" "${f}")
  endif()
  captures_equal(host relic same)
  if(NOT same)
    get_filename_component(n "${f}" NAME)
    message("mismatch: ${n} (host exit ${CAPTURE_host_CODE}, relic exit ${CAPTURE_relic_CODE}; stdout/stderr compared byte-for-byte)")
    math(EXPR bad "${bad}+1")
  endif()
endforeach()

# A missing file, a folder and no file at all: the same exit code (2).
foreach(extra "${SRC}/no_such_file.relic" "${SRC}/tests" "")
  if(extra STREQUAL "")
    compare_capture(host "${RELIC}" --ast)
    if(TOOL)
      compare_capture(relic "${TOOL}")
    else()
      compare_capture(relic "${RELIC}" "${SRC}/selfhost/ast.relic")
    endif()
    # The usage line names the program, so compare only the exit code here.
    if(NOT CAPTURE_host_CODE STREQUAL "2" OR NOT CAPTURE_relic_CODE STREQUAL "2")
      message("mismatch with no file: host exit ${CAPTURE_host_CODE}, relic exit ${CAPTURE_relic_CODE}")
      math(EXPR bad "${bad}+1")
    endif()
  else()
    compare_capture(host "${RELIC}" --ast "${extra}")
    if(TOOL)
      compare_capture(relic "${TOOL}" "${extra}")
    else()
      compare_capture(relic "${RELIC}" "${SRC}/selfhost/ast.relic" "${extra}")
    endif()
    captures_equal(host relic same)
    if(NOT same OR NOT CAPTURE_host_CODE STREQUAL "2" OR NOT CAPTURE_relic_CODE STREQUAL "2")
      message("mismatch on '${extra}': host exit ${CAPTURE_host_CODE}, relic exit ${CAPTURE_relic_CODE}")
      math(EXPR bad "${bad}+1")
    endif()
  endif()
endforeach()
list(LENGTH files total)
if(bad GREATER 0)
  message(FATAL_ERROR "${bad} of ${total} files differ")
endif()
message("all ${total} files match byte-for-byte")
