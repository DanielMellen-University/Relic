# Self-host check (M9): the Relic parser in selfhost/ must print exactly what
# `relic --ast` prints, for every golden .relic file (errors included).
#   cmake -DRELIC=path/to/relic -DSRC=source/dir -P tools/compare_parsers.cmake
# With -DTOOL=path, that program (selfhost/ast.relic compiled to C) is
# checked instead of running selfhost/ast.relic on the host.
file(GLOB files ${SRC}/tests/golden/*.relic ${SRC}/tests/golden/modules/*.relic ${SRC}/std/*.relic ${SRC}/selfhost/*.relic ${SRC}/tests/check_cases/*.relic)
set(bad 0)
foreach(f ${files})
  execute_process(COMMAND ${RELIC} --ast ${f} OUTPUT_VARIABLE a_out ERROR_VARIABLE a_err RESULT_VARIABLE a_code)
  if(TOOL)
    execute_process(COMMAND ${TOOL} ${f} OUTPUT_VARIABLE b_out ERROR_VARIABLE b_err RESULT_VARIABLE b_code)
  else()
    execute_process(COMMAND ${RELIC} ${SRC}/selfhost/ast.relic ${f} OUTPUT_VARIABLE b_out ERROR_VARIABLE b_err RESULT_VARIABLE b_code)
  endif()
  foreach(v a_out a_err b_out b_err)
    string(REPLACE "\r\n" "\n" ${v} "${${v}}")
  endforeach()
  if(NOT a_out STREQUAL b_out OR NOT a_err STREQUAL b_err OR NOT a_code STREQUAL b_code)
    get_filename_component(n ${f} NAME)
    message("mismatch: ${n}\n--- host (exit ${a_code})\n${a_out}${a_err}--- relic (exit ${b_code})\n${b_out}${b_err}")
    math(EXPR bad "${bad}+1")
  endif()
endforeach()
# A missing file, a folder and no file at all: the same message and exit code (2).
foreach(extra "${SRC}/no_such_file.relic" "${SRC}/tests" "")
  if(extra STREQUAL "")
    set(host_cmd ${RELIC} --ast)
    if(TOOL)
      set(mine ${TOOL})
    else()
      set(mine ${RELIC} ${SRC}/selfhost/ast.relic)
    endif()
  else()
    set(host_cmd ${RELIC} --ast ${extra})
    if(TOOL)
      set(mine ${TOOL} ${extra})
    else()
      set(mine ${RELIC} ${SRC}/selfhost/ast.relic ${extra})
    endif()
  endif()
  execute_process(COMMAND ${host_cmd} OUTPUT_VARIABLE a_out ERROR_VARIABLE a_err RESULT_VARIABLE a_code)
  execute_process(COMMAND ${mine} OUTPUT_VARIABLE b_out ERROR_VARIABLE b_err RESULT_VARIABLE b_code)
  # the usage line names the program, so only the exit code is compared when there is no file
  if(extra STREQUAL "")
    set(a_err "")
    set(b_err "")
  endif()
  if(NOT a_out STREQUAL b_out OR NOT a_err STREQUAL b_err OR NOT a_code STREQUAL 2 OR NOT b_code STREQUAL 2)
    message("mismatch on '${extra}': host exit ${a_code} ${a_err} / relic exit ${b_code} ${b_err}")
    math(EXPR bad "${bad}+1")
  endif()
endforeach()
list(LENGTH files total)
if(bad GREATER 0)
  message(FATAL_ERROR "${bad} of ${total} files differ")
endif()
message("all ${total} files match")
