# Command-line input errors, with permissions restored before any assertion.
# DRIVER is run, tokens, ast, check or cgen. TOOL is an optional compiled copy.
cmake_minimum_required(VERSION 3.16)

if(WIN32)
  message("unreadable-skip: Windows does not use POSIX chmod permissions")
  return()
endif()
find_program(chmod_program chmod)
find_program(id_program id)
find_program(test_program test)
if(NOT chmod_program OR NOT id_program OR NOT test_program)
  message("unreadable-skip: chmod, id and test are needed to deny file reads")
  return()
endif()
execute_process(COMMAND ${id_program} -u OUTPUT_VARIABLE uid
  OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE id_code)
if(NOT id_code EQUAL 0)
  message("unreadable-skip: cannot determine the effective user ID")
  return()
endif()
if(uid STREQUAL "0")
  message("unreadable-skip: root can read files with mode 000")
  return()
endif()

file(MAKE_DIRECTORY "${TMP}")
set(input "${TMP}/unreadable input.relic")
# A previous interrupted test may have left the fixture unreadable.
if(EXISTS "${input}")
  execute_process(COMMAND ${chmod_program} 600 "${input}" RESULT_VARIABLE restored)
  if(NOT restored EQUAL 0)
    message(FATAL_ERROR "cannot restore the unreadable-input fixture")
  endif()
endif()
file(WRITE "${input}" "print(\"must not run\")\n")
file(REMOVE "${TMP}/output.c")
execute_process(COMMAND ${chmod_program} 000 "${input}" RESULT_VARIABLE chmod_code)
execute_process(COMMAND ${test_program} -r "${input}" RESULT_VARIABLE readable)
if(NOT chmod_code EQUAL 0 OR NOT readable STREQUAL "1")
  execute_process(COMMAND ${chmod_program} 600 "${input}")
  message("unreadable-skip: chmod cannot deny file reads on this filesystem")
  return()
endif()

set(code 2)
set(prefix relic)
if(DRIVER STREQUAL "cgen")
  set(code 3)
  set(prefix relicc)
endif()
set(expected "${prefix}: cannot open ${input}\n")
set(failures "")
function(expect_input_error label want_err)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${TMP}"
    INPUT_FILE "${SRC}/tools/empty.in" TIMEOUT 20
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE got)
  string(REPLACE "\r\n" "\n" err "${err}")
  if(NOT got STREQUAL code OR NOT out STREQUAL "" OR NOT err STREQUAL want_err)
    string(APPEND failures "${label}: wanted exit ${code}, got ${got}\n--- stdout\n${out}--- stderr\n${err}--- expected stderr\n${want_err}")
    set(failures "${failures}" PARENT_SCOPE)
  endif()
endfunction()

set(output_args)
if(DRIVER STREQUAL "cgen")
  set(output_args -o "${TMP}/output.c")
endif()
if(RELIC)
  expect_input_error("host VM" "${expected}" ${RELIC} "${SRC}/selfhost/${DRIVER}.relic" "${input}" ${output_args})
  expect_input_error("host tree" "${expected}" ${RELIC} --tree "${SRC}/selfhost/${DRIVER}.relic" "${input}" ${output_args})
endif()
if(TOOL)
  expect_input_error("compiled" "${expected}" ${TOOL} "${input}" ${output_args})
  if(DRIVER STREQUAL "cgen")
    expect_input_error("compiled stub" "${expected}" ${TOOL} "${input}" ${output_args} --stub)
  endif()
endif()
if(STAGE0)
  expect_input_error("bootstrap" "${expected}" ${STAGE0} "${input}" ${output_args})
endif()

if(DRIVER STREQUAL "cgen")
  set(import_main "${TMP}/import main.relic")
  set(imported "${TMP}/dependency.relic")
  file(WRITE "${import_main}" "use dependency\nprint(1)\n")
  file(WRITE "${imported}" "let value = 1\n")
  execute_process(COMMAND ${chmod_program} 000 "${imported}" RESULT_VARIABLE import_chmod_code)
  execute_process(COMMAND ${test_program} -r "${imported}" RESULT_VARIABLE import_readable)
  if(NOT import_chmod_code EQUAL 0 OR NOT import_readable STREQUAL "1")
    execute_process(COMMAND ${chmod_program} 600 "${imported}")
    message("unreadable-skip: chmod cannot deny reads of imported files on this filesystem")
  else()
    set(import_expected "${prefix}: cannot open ${imported}\n")
    if(RELIC)
      expect_input_error("host VM imported module" "${import_expected}" ${RELIC}
        "${SRC}/selfhost/${DRIVER}.relic" "${import_main}" ${output_args})
      expect_input_error("host tree imported module" "${import_expected}" ${RELIC} --tree
        "${SRC}/selfhost/${DRIVER}.relic" "${import_main}" ${output_args})
    endif()
    if(TOOL)
      expect_input_error("compiled imported module" "${import_expected}" ${TOOL} "${import_main}" ${output_args})
    endif()
    execute_process(COMMAND ${chmod_program} 600 "${imported}" RESULT_VARIABLE import_restored)
    if(NOT import_restored EQUAL 0)
      message(FATAL_ERROR "cannot restore the unreadable imported-module fixture")
    endif()
  endif()
endif()

execute_process(COMMAND ${chmod_program} 600 "${input}" RESULT_VARIABLE restored)
if(NOT restored EQUAL 0)
  message(FATAL_ERROR "cannot restore the unreadable-input fixture")
endif()
if(EXISTS "${TMP}/output.c")
  string(APPEND failures "unreadable input created output.c\n")
endif()
if(NOT failures STREQUAL "")
  message(FATAL_ERROR "${failures}")
endif()
message("${DRIVER}: unreadable input reports the file and exits ${code}")
