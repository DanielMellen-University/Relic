# Cross-check (C5): relicc, the compiler built from bootstrap/cgen.c, must
# write exactly the C that cgen running on the host wrote for each golden.
#   cmake -DTOOL=relicc -DSRC=source/dir -DHOST_C=build/cgen -DOUT=scratch/dir -P tools/compare_stage1_host.cmake
# HOST_C holds name.c for each golden, written by the host at build time.
file(GLOB files ${SRC}/tests/golden/*.relic)
file(MAKE_DIRECTORY ${OUT})
set(bad 0)
set(total 0)
foreach(f ${files})
  get_filename_component(name ${f} NAME_WE)
  if(NOT EXISTS ${HOST_C}/${name}.c)
    continue()
  endif()
  math(EXPR total "${total}+1")
  execute_process(COMMAND ${TOOL} ${f} -o ${OUT}/${name}.c --stub RESULT_VARIABLE code ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message("${name}: relicc exited with ${code}\n${err}")
    math(EXPR bad "${bad}+1")
    continue()
  endif()
  file(READ ${HOST_C}/${name}.c want)
  file(READ ${OUT}/${name}.c got)
  string(REPLACE "\r\n" "\n" want "${want}")
  string(REPLACE "\r\n" "\n" got "${got}")
  if(NOT got STREQUAL want)
    message("${name}: relicc and the host write different C (compare ${OUT}/${name}.c with ${HOST_C}/${name}.c)")
    math(EXPR bad "${bad}+1")
  endif()
endforeach()
if(total EQUAL 0)
  message(FATAL_ERROR "no host-written C found in ${HOST_C}")
endif()
if(bad GREATER 0)
  message(FATAL_ERROR "${bad} of ${total} programs differ")
endif()
message("all ${total} programs match")
