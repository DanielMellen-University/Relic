# selfhost/interp.relic: the Relic tree-walk interpreter, written in Relic (M9, stage 3).
# Mirrors src/interp/interp.cpp and src/builtins/builtins.cpp: same results,
# same output, same runtime errors and positions.
#
# Values are host values (numbers, strings, bools, none, lists, maps). Functions
# and built-ins are maps tagged with the key chr(1), which Relic source cannot
# write by accident, so type() and printing can tell them apart from user maps.
# The tag is also checked by identity (see tagbox), so this file can run itself.
#
# Errors: the first error is stored in rt.err, every step after that is a
# no-op, and loops stop, so output after an error never happens (this was
# written before Relic had try / catch). Known limits are listed in
# docs/ARCHITECTURE.md (Self-host).
use lexer
use parser
use tokens_fmt
use std/files
use std/strings

let tag = chr(1)
# Functions and modules also carry this list under chr(2). It is checked by
# identity (host_same), so when this interpreter runs another copy of itself,
# the inner copy's tagged maps are plain maps to the outer one.
let tagbox = []
let idkey = chr(2)

fun tagged(v, kind)
    v[tag] = kind
    v[idkey] = tagbox
    return v
let max_depth = 800

fun new_env(parent) = {vars: {}, parent: parent, hints: {}}

# ---- `as` hints ----

fun type_ok(t, v)
    if t == "any"
        return true
    if t == "number"
        return is_num(type_of(v))
    return t == type_of(v)

fun check_type(rt, at, t, v, what)
    if rt.err == none and not type_ok(t, v)
        fail(rt, at, what + " " + t + ", got " + type_of(v))

# The hint of a Let (kid 1) or a Fun (kid 2), or "".
fun hint_of(n, i)
    if len(n.kids) > i and n.kids[i].kind == "Type"
        return n.kids[i].text
    return ""

# " (did you mean 'x'?)" for the closest name within a small edit distance.
fun suggest(name, names)
    let limit = 1
    if len(name) >= 5
        limit = 2
    let best = ""
    let best_d = limit + 1
    for c in names
        if c == name or c == "" or (strings.starts_with(c, "host_") and not strings.starts_with(name, "host_"))
            next
        if len(c) - len(name) > limit or len(name) - len(c) > limit
            next
        let d = edit_distance(name, c)
        if d < len(name) and (d < best_d or (d == best_d and c < best))
            best_d = d
            best = c
    if best == ""
        return ""
    return " (did you mean '{best}'?)"

fun edit_distance(a, b)
    let row = []
    for j in 0..len(b) + 1
        append(row, j)
    for i in 1..len(a) + 1
        let diag = row[0]
        row[0] = i
        for j in 1..len(b) + 1
            let up = row[j]
            let cost = 1
            if a[i - 1] == b[j - 1]
                cost = 0
            let v = row[j] + 1
            if row[j - 1] + 1 < v
                v = row[j - 1] + 1
            if diag + cost < v
                v = diag + cost
            row[j] = v
            diag = up
    return row[len(b)]

fun find(env, name)
    let e = env
    while e != none
        if name in e.vars
            return e
        e = e.parent
    return none

# For a program run inside another (an IDE): set rt.out to a list and print
# and eprint add their lines to it instead of writing them; set rt.steps to a
# number and the run stops, with an error no try catches, after that many
# steps of the machine; put host_* names in rt.denied and calling one fails
# with "<name>(): not available here". The defaults change nothing.
fun new_runtime()
    let rt = {err: none, ret: none, flow_node: none, depth: 0, next_id: 0, globals: none, builtins: none, file: "", modules: {}, args: [], out: none, steps: -1, stopped: false, denied: {}}
    let builtins = new_env(none)
    for b in [["print", -1], ["len", 1], ["append", 2], ["str", 1], ["keys", 1], ["type", 1], ["fail", 1], ["int", 1], ["float", 1], ["slice", 3], ["ord", 1], ["chr", 1], ["num", 1], ["pop", 1], ["insert", 3], ["remove", 2], ["args", 0], ["eprint", -1], ["gc", 0]]
        builtins.vars[b[0]] = tagged({name: b[0], arity: b[1]}, "builtin")
    # host_* built-ins (files, clocks, math, graphics) are passed through to the host.
    for b in host_names()
        builtins.vars[b[0]] = tagged({name: b[0], arity: b[1]}, "builtin")
    rt.globals = new_env(builtins)
    rt.builtins = builtins
    return rt

# ---- modules ----

# The main file is a module too, so a module that uses it back gets the same scope.
fun set_main(rt, path)
    rt.file = path
    let name = path
    let cut = last_slash(name)
    name = slice(name, cut + 1, len(name))
    if len(name) > 6 and slice(name, len(name) - 6, len(name)) == ".relic"
        name = slice(name, 0, len(name) - 6)
    rt.modules[norm_path(path)] = new_module(name, rt.globals)

fun new_module(name, scope)
    return tagged({name: name, scope: scope}, "module")

fun last_slash(s)
    let cut = -1
    for i in 0..len(s)
        if s[i] == "/" or s[i] == "\\"
            cut = i
    return cut

fun folder_of(file) = slice(file, 0, last_slash(file) + 1)

# A cache key for a path: drops "." parts and folds "dir/.." away.
fun norm_path(p)
    let parts = []
    let cur = ""
    for c in p + "/"
        if c == "/" or c == "\\"
            if cur == ".."  and len(parts) > 0 and parts[len(parts) - 1] != ".." and parts[len(parts) - 1] != ""
                pop(parts)
            else if cur != "." and not (cur == "" and len(parts) > 0)
                append(parts, cur)
            cur = ""
        else
            cur = cur + c
    let out = ""
    for i in 0..len(parts)
        if i > 0
            out = out + "/"
        out = out + parts[i]
    return out

fun fail(rt, at, msg)
    if rt.err == none
        rt.err = {line: at.line, col: at.col, msg: msg, file: rt.file}
    return none

# ---- values ----

fun is_num(t) = t == "int" or t == "float"

# Type name with "a" or "an" in front, for error messages.
fun a_type(v)
    let t = type_of(v)
    if t == "int"
        return "an int"
    return "a " + t

fun type_of(v)
    let t = type(v)
    if t == "map" and idkey in v and host_same(v[idkey], tagbox)
        if v[tag] == "module"
            return "module"
        return "function"
    return t

fun is_plain_name(s)
    if s == "" or not (lexer.is_alpha(s[0]) or s[0] == "_")
        return false
    for c in s
        if not lexer.is_word(c)
            return false
    return true

fun show(v)
    if type(v) == "string"
        return v
    return repr(v)

# A list or map that holds itself prints as [...] or {...} where it repeats,
# like the host, and so does anything nested 1000 deep. It runs on its own stack of
# pieces (["v", value] still to print, ["s", text] to write, ["pop"] to leave a
# list or map), so deep nesting costs no host calls (the host's limit is 800).
fun repr(v)
    let t = type_of(v)
    if t != "list" and t != "map"
        return repr_leaf(v, t)
    let path = []
    let parts = []
    let work = [["v", v]]
    while len(work) > 0
        let w = pop(work)
        if w[0] == "s"
            append(parts, w[1])
            next
        if w[0] == "pop"
            pop(path)
            next
        let x = w[1]
        let tx = type_of(x)
        if tx != "list" and tx != "map"
            append(parts, repr_leaf(x, tx))
            next
        let seen = len(path) >= 1000
        for p in path
            if host_same(p, x)
                seen = true
        if seen
            if tx == "list"
                append(parts, "[...]")
            else
                append(parts, "{{...}}")
            next
        append(path, x)
        append(work, ["pop"])
        if tx == "list"
            append(parts, "[")
            append(work, ["s", "]"])
            let i = len(x) - 1
            while i >= 0
                append(work, ["v", x[i]])
                if i > 0
                    append(work, ["s", ", "])
                i = i - 1
        else
            append(parts, "{{")
            append(work, ["s", "}}"])
            let ks = keys(x)
            let i = len(ks) - 1
            while i >= 0
                append(work, ["v", x[ks[i]]])
                let k = ks[i]
                let name = tokens_fmt.quote(k)
                if is_plain_name(k)
                    name = k
                append(work, ["s", name + ": "])
                if i > 0
                    append(work, ["s", ", "])
                i = i - 1
    return strings.join(parts, "")

fun repr_leaf(v, t)
    if t == "string"
        return tokens_fmt.quote(v)
    if t == "function"
        return "<fun " + v.name + ">"
    if t == "module"
        return "<module " + v.name + ">"
    return str(v)

# Everything but lists and maps: numbers by value, functions by identity, the rest as the host.
fun equal_leaf(a, ta, b)
    if is_num(ta) and is_num(type(b))
        return a == b
    if ta != type_of(b)
        return false
    if ta == "function"
        if a[tag] != b[tag]
            return false
        if a[tag] == "builtin"
            return a.name == b.name
        return a.id == b.id
    return a == b

# Lists and maps by contents, like the host: the same list or map is equal at once, and
# pairs nested deeper than 10000 count as different. It runs on its own stack of
# [a, b, depth] triples, so deep nesting costs no host calls (the host's limit is 800).
fun equal(a, b)
    let ta = type_of(a)
    if ta != "list" and ta != "map"
        return equal_leaf(a, ta, b)
    if ta != type_of(b)
        return false
    let stack = [a, b, 0]
    while len(stack) > 0
        let d = pop(stack)
        let y = pop(stack)
        let x = pop(stack)
        if host_same(x, y)
            next
        if len(x) != len(y)
            return false
        let keys = none
        let n = len(x)
        if type_of(x) == "map"
            keys = keys_of(x)
        for i in 0..n
            let p = none
            let q = none
            if keys == none
                p = x[i]
                q = y[i]
            else
                if not (keys[i] in y)
                    return false
                p = x[keys[i]]
                q = y[keys[i]]
            if d + 1 > 10000
                return false
            let tp = type_of(p)
            if tp == "list" or tp == "map"
                if tp != type_of(q)
                    return false
                append(stack, p)
                append(stack, q)
                append(stack, d + 1)
            else if not equal_leaf(p, tp, q)
                return false
    return true

fun keys_of(m) = keys(m)

# Whole like the host's floor(d) == d: an infinity is whole too (built-ins then
# take the nearest int), a nan is not.
fun is_whole(d) = d % 1 == 0 or (d == d and d - d != d - d)

# Number to whole-number index, or an error (gives none).
fun whole(rt, at, v, what)
    if not is_num(type(v))
        return fail(rt, at, what + " must be a number, got " + type_of(v))
    if type(v) == "int"
        return v
    # a float: whole and within 9e15, and handed on as an int like the host does
    if not is_whole(v) or v > 9000000000000000 or v < -9000000000000000
        return fail(rt, at, what + " must be a whole number")
    return int(v)

# A whole number as an int, the way the host reads it: past the int range it is the nearest int.
fun as_int(v)
    if type(v) == "int"
        return v
    if v >= 9223372036854775808.0
        return 9223372036854775807
    if v <= -9223372036854775808.0
        return -9223372036854775807 - 1
    return int(v)

fun slot(rt, at, idx, size, what)
    let i = whole(rt, at, idx, what)
    if i == none
        return none
    if i < 0 or i >= size
        return fail(rt, at, "{what} {i} is out of range (size {size})")
    return i

# ---- statements ----

fun run(rt, program)
    machine(rt, [[k_block, program, rt.globals, 0]])

# The error for a return, break or next that reached the edge of a function
# body or of a file (file_edge true: a return is an error there too).
fun outside(rt, f, file_edge)
    if f == flow_return and file_edge
        fail(rt, rt.flow_node, "'return' outside a function")
    else if f == flow_break
        fail(rt, rt.flow_node, "'break' outside a loop")
    else if f == flow_next
        fail(rt, rt.flow_node, "'next' outside a loop")

# What reached the edge of a function body or a file, for outside() (an
# error is in rt.err).
let flow_return = 1
let flow_break = 2
let flow_next = 3

# Pops vals down to len start.
fun drop(vals, start)
    while len(vals) > start
        pop(vals)

fun not_defined(rt, n, env)
    let names = []
    let s = env
    while s != none
        for name in keys(s.vars)
            append(names, name)
        s = s.parent
    return fail(rt, n, "'{n.text}' is not defined" + suggest(n.text, names))

fun unary_of(rt, n, v)
    if n.text == "-"
        if not is_num(type(v))
            return fail(rt, n, "cannot negate " + a_type(v))
        if type(v) == "float"
            return -v
        return math(rt, n, "-", 0, v)
    if type(v) != "bool"
        return fail(rt, n, "'not' needs true or false, got " + type_of(v))
    return not v

fun field_of(rt, n, obj)
    if type_of(obj) == "module"
        if len(n.text) > 0 and n.text[0] == "_"
            return fail(rt, n, "'{n.text}' is private to module '{obj.name}'")
        if not (n.text in obj.scope.vars)
            return fail(rt, n, "module '{obj.name}' has no '{n.text}' (yet)")
        return obj.scope.vars[n.text]
    if type_of(obj) != "map"
        return fail(rt, n, "cannot read a field of " + a_type(obj))
    if not (n.text in obj)
        return fail(rt, n, "map has no key '{n.text}'" + suggest(n.text, keys(obj)))
    return obj[n.text]

fun index_of(rt, n, obj, idx)
    let t = type_of(obj)
    if t == "list"
        let i = slot(rt, n.kids[1], idx, len(obj), "list index")
        if i == none
            return none
        return obj[i]
    if t == "string"
        let i = slot(rt, n.kids[1], idx, len(obj), "string index")
        if i == none
            return none
        return obj[i]
    if t == "map"
        if type(idx) != "string"
            return fail(rt, n.kids[1], "map keys must be strings")
        if not (idx in obj)
            return fail(rt, n.kids[1], "map has no key '{idx}'" + suggest(idx, keys(obj)))
        return obj[idx]
    return fail(rt, n, "cannot index " + a_type(obj))

fun mismatch(rt, n, verb, a, b) = fail(rt, n, "cannot " + verb + " " + a_type(a) + " and " + a_type(b))

# Every binary operator but 'and' and 'or', on values already evaluated.
fun binop(rt, n, a, b)
    let op = n.text
    let ta = type_of(a)
    let tb = type_of(b)
    if op == "=="
        return equal(a, b)
    if op == "!="
        return not equal(a, b)
    if op == "in"
        if tb == "list"
            for x in b
                if equal(a, x)
                    return true
            return false
        if tb == "map"
            if ta != "string"
                return fail(rt, n, "map keys must be strings")
            return a in b
        if tb == "string"
            if ta != "string"
                return fail(rt, n, "can only look for a string inside a string")
            return a in b
        return fail(rt, n, "cannot look inside " + a_type(b))
    if op == "+"
        if is_num(ta) and is_num(tb)
            return math(rt, n, op, a, b)
        if (ta == "string" and tb == "string") or (ta == "list" and tb == "list")
            return a + b
        return mismatch(rt, n, "add", a, b)
    if op == "<" or op == "<=" or op == ">" or op == ">="
        if not ((is_num(ta) and is_num(tb)) or (ta == "string" and tb == "string"))
            return mismatch(rt, n, "compare", a, b)
        if op == "<"
            return a < b
        if op == "<="
            return a <= b
        if op == ">"
            return a > b
        return a >= b
    if not is_num(ta) or not is_num(tb)
        if op == "-"
            return mismatch(rt, n, "subtract", a, b)
        if op == "*"
            return mismatch(rt, n, "multiply", a, b)
        return mismatch(rt, n, "divide", a, b)
    if b == 0 and (op == "/" or op == "%")
        return fail(rt, n, "division by zero")
    return math(rt, n, op, a, b)

# Number math runs on the host; an int overflow there becomes this program's error.
fun math(rt, n, op, a, b)
    try
        if op == "+"
            return a + b
        if op == "-"
            return a - b
        if op == "*"
            return a * b
        if op == "/"
            return a / b
        return a % b
    catch e
        return fail(rt, n, e.message)

fun plural(n)
    if n == 1
        return ""
    return "s"

# An error leaving std into user code is reported at the user's call, with
# "host_x(): " renamed to the std function the user called.
fun in_std(file)
    let root = norm_path(host_std_root())
    let k = norm_path(file)
    return file != "" and len(k) > len(root) and slice(k, 0, len(root)) == root

fun std_boundary(rt, f, caller_file, n)
    if not in_std(f.file) or in_std(caller_file)
        return none
    if rt.err.file != "" and not in_std(rt.err.file)
        return none
    let msg = rt.err.msg
    let cut = strings.find(msg, "(): ")
    if strings.starts_with(msg, "host_") and cut >= 0
        let stem = slice(f.file, last_slash(f.file) + 1, len(f.file))
        stem = slice(stem, 0, len(stem) - 6)
        msg = stem + "." + f.name + "(): " + slice(msg, cut + 4, len(msg))
    rt.err = {line: n.line, col: n.col, msg: msg, file: caller_file}

# ---- the machine: statements, expressions and calls on one stack ----

# Since 1.0.21 (SH3, option C, slices 4 and 5) run() drives one frame stack
# for statements, expressions and calls, so a Relic call costs no host call
# and recursion reaches the host's limit (max_depth, same error text). Frames
# with a code below x_eval stay on the stack while the work above them runs:
#   [k_block, block, env, i]             runs block.kids from i on
#   [k_while, node, env]                 checks the condition, runs the body again
#   [k_for, node, env, items, i]         runs the body for items[i]
#   [k_try, node, env, depth, nvals]     the try part is running above it
#   [k_call, fun, caller_file, call]     a function body is running above it
#   [k_module, mod, caller_file, use, env]  a module body is running above it
# The rest are popped when they run: x_eval looks at a node and pushes the
# frames for its parts, the others take their parts' values from vals.
# A return unwinds to the nearest k_call, break and next to the nearest loop
# (not past a k_call or k_module), and an error to the nearest k_try, leaving
# each k_call on the way like the host does (std_boundary, depth, rt.file).
let k_block = 0
let k_while = 1
let k_for = 2
let k_try = 3
let k_call = 4
let k_module = 5
let x_eval = 10
let x_binary = 11
let x_call = 12
let x_logic_left = 13
let x_logic_right = 14
let x_field = 15
let x_index = 16
let x_unary = 17
let x_list = 18
let x_interp = 19
let x_map = 20
let x_range_start = 21
let x_range_end = 22
let x_drop = 23
let x_let = 24
let x_assign = 25
let x_if = 26
let x_while = 27
let x_for = 28
let x_return = 29

fun machine(rt, st)
    let vals = []
    while len(st) > 0
        if rt.err != none
            if not unwind_error(rt, st, vals)
                return none
            next
        if rt.steps >= 0
            if rt.steps == 0
                rt.stopped = true
                rt.err = {line: 0, col: 0, msg: "stopped: the program ran too long", file: rt.file}
                return none
            rt.steps = rt.steps - 1
        let fr = st[len(st) - 1]
        let step = fr[0]
        if step >= x_eval
            pop(st)
            let m = fr[1]
            if step == x_eval
                let en = fr[2]
                let mk = m.kind
                if mk == "Name"
                    let e = find(en, m.text)
                    if e == none
                        not_defined(rt, m, en)
                    else
                        append(vals, e.vars[m.text])
                else if mk == "Binary"
                    if m.text == "and" or m.text == "or"
                        append(st, [x_logic_left, m, en])
                        append(st, [x_eval, m.kids[0], en])
                    else
                        append(st, [x_binary, m])
                        append(st, [x_eval, m.kids[1], en])
                        let a = m.kids[0]
                        let e = none
                        if a.kind == "Name"
                            e = find(en, a.text)
                        if e != none
                            # a name on the left is read now, with no frame
                            append(vals, e.vars[a.text])
                        else
                            append(st, [x_eval, a, en])
                else if mk == "Call"
                    # Leading names and strings (the callee, simple arguments)
                    # are read now, with no frame; the rest get frames.
                    let kids = m.kids
                    let i = 0
                    while i < len(kids)
                        let c = kids[i]
                        if c.kind == "Name"
                            let e = find(en, c.text)
                            if e == none
                                break
                            append(vals, e.vars[c.text])
                        else if c.kind == "String"
                            append(vals, c.text)
                        else
                            break
                        i = i + 1
                    append(st, [x_call, m])
                    let j = len(kids) - 1
                    while j >= i
                        append(st, [x_eval, kids[j], en])
                        j = j - 1
                else if mk == "String"
                    append(vals, m.text)
                else if mk == "Number"
                    try
                        let v = num(m.text)
                        # num() turns an int too big for 64 bits into a float; a literal is an error
                        if type(v) == "float" and not ("." in m.text or "e" in m.text or "E" in m.text)
                            fail(rt, m, "int is too large (the limit is 9223372036854775807)")
                        else
                            append(vals, v)
                    catch err
                        # num() rounds a tiny float like the host; it refuses one too large
                        fail(rt, m, "float is too large")
                else if mk == "True"
                    append(vals, true)
                else if mk == "False"
                    append(vals, false)
                else if mk == "None"
                    append(vals, none)
                else if mk == "Field"
                    append(st, [x_field, m])
                    append(st, [x_eval, m.kids[0], en])
                else if mk == "Index"
                    append(st, [x_index, m])
                    append(st, [x_eval, m.kids[1], en])
                    append(st, [x_eval, m.kids[0], en])
                else if mk == "Unary"
                    append(st, [x_unary, m])
                    append(st, [x_eval, m.kids[0], en])
                else if mk == "List" or mk == "Interp"
                    if mk == "List"
                        append(st, [x_list, m])
                    else
                        append(st, [x_interp, m])
                    let i = len(m.kids) - 1
                    while i >= 0
                        append(st, [x_eval, m.kids[i], en])
                        i = i - 1
                else if mk == "Map"
                    append(st, [x_map, m])
                    let i = len(m.kids) - 1
                    while i >= 0
                        append(st, [x_eval, m.kids[i].kids[0], en])
                        i = i - 1
                else if mk == "Range"
                    append(st, [x_range_start, m, en])
                    append(st, [x_eval, m.kids[0], en])
                else
                    fail(rt, m, "cannot evaluate a " + mk)
            else if step == x_binary
                let b = pop(vals)
                append(vals, binop(rt, m, pop(vals), b))
            else if step == x_call
                let start = len(vals) - len(m.kids)
                let callee = vals[start]
                let argv = slice(vals, start + 1, len(vals))
                drop(vals, start)
                if type_of(callee) != "function"
                    fail(rt, m, "cannot call " + a_type(callee))
                else if callee[tag] == "builtin"
                    if callee.arity >= 0 and len(argv) != callee.arity
                        fail(rt, m, "{callee.name}() takes {callee.arity} argument{plural(callee.arity)}, got {len(argv)}")
                    else
                        let r = builtin(rt, callee.name, argv)
                        if r.err == none
                            append(vals, r.value)
                        else if callee.name == "fail"
                            fail(rt, m, r.err)
                        else
                            fail(rt, m, callee.name + "(): " + r.err)
                else
                    enter(rt, st, callee, argv, m)
            else if step == x_drop
                pop(vals)
            else if step == x_field
                append(vals, field_of(rt, m, pop(vals)))
            else if step == x_index
                let idx = pop(vals)
                append(vals, index_of(rt, m, pop(vals), idx))
            else if step == x_let
                let v = pop(vals)
                let en = fr[2]
                let hint = hint_of(m, 1)
                if hint != ""
                    check_type(rt, m.kids[0], hint, v, "'{m.text}' must be")
                    en.hints[m.text] = hint
                else if m.text in en.hints
                    remove(en.hints, m.text)
                if rt.err == none
                    en.vars[m.text] = v
            else if step == x_if
                let v = pop(vals)
                if type(v) != "bool"
                    fail(rt, m.kids[0], "'if' condition must be true or false, got " + type_of(v))
                else if v
                    append(st, [k_block, m.kids[1], new_env(fr[2]), 0])
                else if len(m.kids) > 2
                    let c = m.kids[2]
                    if c.kind != "If"
                        append(st, [k_block, c, new_env(fr[2]), 0])
                    else
                        append(st, [x_if, c, fr[2]])
                        append(st, [x_eval, c.kids[0], fr[2]])
            else if step == x_while
                let v = pop(vals)
                if type(v) != "bool"
                    fail(rt, m.kids[0], "'while' condition must be true or false, got " + type_of(v))
                else if v
                    append(st, [k_block, m.kids[1], new_env(fr[2]), 0])
                else
                    # the k_while frame under it
                    pop(st)
            else if step == x_return
                rt.flow_node = m
                flow_out(rt, st, vals, flow_return, pop(vals))
            else if step == x_assign
                let t = m.kids[0]
                let idx = none
                let obj = none
                if t.kind == "Index"
                    idx = pop(vals)
                if t.kind != "Name"
                    obj = pop(vals)
                assign_set(rt, t, pop(vals), obj, idx, fr[2], m.kids[1])
            else if step == x_for
                let src = pop(vals)
                let t = type_of(src)
                let items = none
                if t == "list"
                    items = slice(src, 0, len(src))
                else if t == "string"
                    items = []
                    for ch in src
                        append(items, ch)
                else if t == "map"
                    items = keys(src)
                else
                    fail(rt, m.kids[0], "cannot loop over " + a_type(src))
                if items != none
                    append(st, [k_for, m, fr[2], items, 0])
            else if step == x_logic_left
                let v = pop(vals)
                if type(v) != "bool"
                    fail(rt, m.kids[0], "'" + m.text + "' operand must be true or false, got " + type_of(v))
                else if m.text == "and" and not v
                    append(vals, false)
                else if m.text == "or" and v
                    append(vals, true)
                else
                    append(st, [x_logic_right, m])
                    append(st, [x_eval, m.kids[1], fr[2]])
            else if step == x_logic_right
                let v = vals[len(vals) - 1]
                if type(v) != "bool"
                    fail(rt, m.kids[1], "'" + m.text + "' operand must be true or false, got " + type_of(v))
            else if step == x_unary
                append(vals, unary_of(rt, m, pop(vals)))
            else if step == x_list
                let start = len(vals) - len(m.kids)
                let l = slice(vals, start, len(vals))
                drop(vals, start)
                append(vals, l)
            else if step == x_interp
                let start = len(vals) - len(m.kids)
                let s = ""
                for i in start..len(vals)
                    s = s + show(vals[i])
                drop(vals, start)
                append(vals, s)
            else if step == x_map
                let start = len(vals) - len(m.kids)
                let mp = {}
                for i in 0..len(m.kids)
                    mp[m.kids[i].text] = vals[start + i]
                drop(vals, start)
                append(vals, mp)
            else if step == x_range_start
                # The start is checked before the end is evaluated.
                whole(rt, m.kids[0], vals[len(vals) - 1], "range start")
                append(st, [x_range_end, m])
                append(st, [x_eval, m.kids[1], fr[2]])
            else
                # x_range_end
                let b = whole(rt, m.kids[1], pop(vals), "range end")
                let a = pop(vals)
                if rt.err == none
                    if b - a > 10000000
                        fail(rt, m, "range is too large")
                    else
                        append(vals, a..b)
        else if step == k_block
            let kids = fr[1].kids
            let i = fr[3]
            if i >= len(kids)
                pop(st)
                next
            fr[3] = i + 1
            let n = kids[i]
            let en = fr[2]
            let k = n.kind
            if k == "ExprStmt"
                append(st, [x_drop, n])
                append(st, [x_eval, n.kids[0], en])
            else if k == "Let"
                append(st, [x_let, n, en])
                append(st, [x_eval, n.kids[0], en])
            else if k == "Assign"
                append(st, [x_assign, n, en])
                let t = n.kids[0]
                if t.kind == "Index"
                    append(st, [x_eval, t.kids[1], en])
                if t.kind != "Name"
                    append(st, [x_eval, t.kids[0], en])
                append(st, [x_eval, n.kids[1], en])
            else if k == "If"
                append(st, [x_if, n, en])
                append(st, [x_eval, n.kids[0], en])
            else if k == "Return"
                if len(n.kids) == 0
                    rt.flow_node = n
                    flow_out(rt, st, vals, flow_return, none)
                else
                    append(st, [x_return, n])
                    append(st, [x_eval, n.kids[0], en])
            else if k == "While"
                append(st, [k_while, n, en])
            else if k == "For"
                append(st, [x_for, n, en])
                append(st, [x_eval, n.kids[0], en])
            else if k == "Break"
                rt.flow_node = n
                flow_out(rt, st, vals, flow_break, none)
            else if k == "Next"
                rt.flow_node = n
                flow_out(rt, st, vals, flow_next, none)
            else if k == "Fun"
                rt.next_id = rt.next_id + 1
                en.vars[n.text] = tagged({name: n.text, node: n, closure: en, id: rt.next_id, file: rt.file}, "fun")
            else if k == "Try"
                append(st, [k_try, n, en, rt.depth, len(vals)])
                append(st, [k_block, n.kids[0], new_env(en), 0])
            else if k == "Use"
                use_module(rt, st, n, en)
            else
                fail(rt, n, "cannot run a " + k + " here")
        else if step == k_call
            # The body ended without a return.
            let body = fr[1].node.kids[1]
            if body.kind != "Block"
                finish_call(rt, st, vals, pop(vals), body)
            else
                finish_call(rt, st, vals, none, fr[1].node)
        else if step == k_while
            append(st, [x_while, fr[1], fr[2]])
            append(st, [x_eval, fr[1].kids[0], fr[2]])
        else if step == k_for
            let i = fr[4]
            if i >= len(fr[3])
                pop(st)
                next
            fr[4] = i + 1
            let scope = new_env(fr[2])
            scope.vars[fr[1].text] = fr[3][i]
            append(st, [k_block, fr[1].kids[1], scope, 0])
        else if step == k_try
            # the try part ended without an error
            pop(st)
        else
            # k_module: the module's body ended
            pop(st)
            rt.file = fr[2]
            bind_module(fr[3], fr[4], fr[1])
    if len(vals) > 0
        return vals[0]
    return none

# A user function call: checks, then a k_call frame and its body on top.
fun enter(rt, st, f, argv, n)
    let params = f.node.kids[0].kids
    if len(argv) != len(params)
        return fail(rt, n, "{f.name}() takes {len(params)} argument{plural(len(params))}, got {len(argv)}")
    if rt.depth >= max_depth
        return fail(rt, n, "too much recursion (more than {max_depth} calls deep)")
    let scope = new_env(f.closure)
    for i in 0..len(argv)
        let prm = params[i]
        if len(prm.kids) > 0
            check_type(rt, n, prm.kids[0].text, argv[i], "{f.name}() argument '{prm.text}' must be")
            if rt.err != none
                return none
            scope.hints[prm.text] = prm.kids[0].text
        scope.vars[prm.text] = argv[i]
    rt.depth = rt.depth + 1
    append(st, [k_call, f, rt.file, n])
    rt.file = f.file
    let body = f.node.kids[1]
    if body.kind == "Block"
        append(st, [k_block, body, scope, 0])
    else
        append(st, [x_eval, body, scope])

# The k_call frame on top gets its result: the return hint is checked (an
# error leaves the frame for unwind_error), then the frame goes.
fun finish_call(rt, st, vals, result, at)
    let fr = st[len(st) - 1]
    let f = fr[1]
    let ret_hint = hint_of(f.node, 2)
    if ret_hint != ""
        check_type(rt, at, ret_hint, result, "{f.name}() must return")
        if rt.err != none
            return none
    pop(st)
    rt.depth = rt.depth - 1
    rt.file = fr[2]
    append(vals, result)

# return, break or next: unwind to where it goes, or fail at the edge of a
# function body or a file like outside() does.
fun flow_out(rt, st, vals, flow, v)
    while len(st) > 0
        let k = st[len(st) - 1][0]
        if k == k_call
            if flow == flow_return
                return finish_call(rt, st, vals, v, rt.flow_node)
            return outside(rt, flow, false)
        if k == k_module
            return outside(rt, flow, true)
        if flow != flow_return and (k == k_while or k == k_for)
            if flow == flow_break
                pop(st)
            return none
        pop(st)
    outside(rt, flow, true)

# An error unwinds to the nearest k_try, which runs its catch part; each
# k_call and k_module on the way is left like the host leaves a call or a
# module. Gives false when no try catches it.
fun unwind_error(rt, st, vals)
    if rt.stopped
        return false
    while len(st) > 0
        let fr = pop(st)
        let k = fr[0]
        if k == k_try
            let e = rt.err
            rt.err = none
            rt.depth = fr[3]
            drop(vals, fr[4])
            let scope = new_env(fr[2])
            if fr[1].text != ""
                scope.vars[fr[1].text] = {message: e.msg, line: e.line, col: e.col}
            append(st, [k_block, fr[1].kids[1], scope, 0])
            return true
        if k == k_call
            std_boundary(rt, fr[1], fr[2], fr[3])
            rt.depth = rt.depth - 1
            rt.file = fr[2]
        else if k == k_module
            rt.file = fr[2]
    return false

# Sets a name, field or index; the target's parts are already evaluated (obj, idx).
fun assign_set(rt, target, v, obj, idx, env, value_at)
    if target.kind == "Name"
        let e = find(env, target.text)
        if e == none or host_same(e, rt.builtins)
            return fail(rt, target, "'{target.text}' is not declared; use 'let {target.text} = ...'")
        if target.text in e.hints
            check_type(rt, value_at, e.hints[target.text], v, "'{target.text}' must be")
            if rt.err != none
                return
        e.vars[target.text] = v
        return
    let t = type_of(obj)
    if target.kind == "Field"
        if t == "module"
            return fail(rt, target, "cannot change a module's names from outside; give it a function that does it")
        if t != "map"
            return fail(rt, target, "cannot set a field on " + a_type(obj))
        obj[target.text] = v
        return
    if t == "list"
        let i = slot(rt, target.kids[1], idx, len(obj), "list index")
        if i != none
            obj[i] = v
    else if t == "map"
        if type(idx) != "string"
            return fail(rt, target.kids[1], "map keys must be strings")
        obj[idx] = v
    else
        fail(rt, target, "cannot set an index on " + a_type(obj))

# A `use` on the stack: a new module's body runs in a k_module frame.
fun use_module(rt, st, n, en)
    let path = n.text
    let file = folder_of(rt.file) + path + ".relic"
    if len(path) >= 4 and slice(path, 0, 4) == "std/"
        file = host_std_root() + slice(path, 4, len(path)) + ".relic"
    let key = norm_path(file)
    if key in rt.modules
        return bind_module(n, en, rt.modules[key])
    if not files.exists(file)
        return fail(rt, n, "cannot find module '{path}' (no file {path}.relic)")
    let name = slice(path, last_slash(path) + 1, len(path))
    let mod = new_module(name, new_env(rt.builtins))
    rt.modules[key] = mod
    let lexed = lexer.lex(files.read(file))
    let err = lexed.err
    if err == none
        let parsed = parser.parse(lexed.tokens)
        err = parsed.err
        if err == none
            append(st, [k_module, mod, rt.file, n, en])
            rt.file = file
            append(st, [k_block, parsed.tree, mod.scope, 0])
            return none
    rt.err = {line: err.line, col: err.col, msg: err.msg, file: file}

fun bind_module(n, en, m)
    if len(n.kids) > 0
        en.vars[n.kids[0].text] = m
    else
        en.vars[m.name] = m

# ---- built-ins: {value, err}, err is the message without the name ----

fun ok(v) = {value: v, err: none}
fun bad(msg) = {value: none, err: msg}

fun builtin(rt, name, a)
    if name == "print" or name == "eprint"
        let s = ""
        for i in 0..len(a)
            if i > 0
                s = s + " "
            s = s + show(a[i])
        if rt.out != none
            append(rt.out, s)
        else if name == "print"
            print(s)
        else
            eprint(s)
        return ok(none)
    let t = ""
    if len(a) > 0
        t = type_of(a[0])
    if name == "len"
        if t == "string" or t == "list" or t == "map"
            return ok(len(a[0]))
        return bad("cannot get the length of " + a_type(a[0]))
    if name == "append"
        if t != "list"
            return bad("first argument must be a list, got " + t)
        append(a[0], a[1])
        return ok(none)
    if name == "str"
        return ok(show(a[0]))
    if name == "keys"
        if t != "map"
            return bad("argument must be a map, got " + t)
        return ok(keys(a[0]))
    if name == "type"
        return ok(t)
    if name == "int" or name == "float"
        # The host does the work; its message comes back without the "int(): " part.
        try
            if name == "int"
                return ok(int(a[0]))
            return ok(float(a[0]))
        catch e
            return bad(slice(e.message, len(name) + 4, len(e.message)))
    if name == "fail"
        if t != "string"
            return bad("fail(): message must be a string, got " + t)
        return bad(a[0])
    if name == "args" or name == "host_args"
        return ok(slice(rt.args, 0, len(rt.args)))
    if slice(name, 0, 5) == "host_"
        if name in rt.denied
            return bad("not available here")
        try
            return ok(host_call(name, a))
        catch e
            return bad(slice(e.message, 13, len(e.message)))
    if name == "slice"
        for i in [1, 2]
            let what = "start"
            if i == 2
                what = "end"
            if not is_num(type(a[i]))
                return bad(what + " must be a number, got " + type_of(a[i]))
            if not is_whole(a[i])
                return bad(what + " must be a whole number")
        if t != "string" and t != "list"
            return bad("cannot slice " + a_type(a[0]))
        return ok(slice(a[0], a[1], a[2]))
    if name == "ord"
        if t != "string"
            return bad("argument must be a string, got " + t)
        if len(a[0]) != 1
            return bad("needs a one-character string")
        return ok(ord(a[0]))
    if name == "chr"
        if not is_num(t)
            return bad("argument must be a number, got " + t)
        if not is_whole(a[0])
            return bad("argument must be a whole number")
        if a[0] < 0 or a[0] > 1114111 or (a[0] >= 55296 and a[0] <= 57343)
            return bad("code must be 0 to 1114111 and not 55296 to 57343 (surrogates)")
        return ok(chr(a[0]))
    if name == "gc"
        # Its values live on the host heap, so the host's collector runs and counts them.
        return ok(gc())
    if name == "num"
        if is_num(t)
            return ok(a[0])
        if t != "string"
            return bad("argument must be a string, got " + t)
        return parse_number(a[0])
    if name == "pop"
        if t != "list"
            return bad("first argument must be a list, got " + t)
        if len(a[0]) == 0
            return bad("list is empty")
        return ok(pop(a[0]))
    if name == "insert"
        if t != "list"
            return bad("first argument must be a list, got " + t)
        if not is_num(type(a[1]))
            return bad("index must be a number, got " + type_of(a[1]))
        if not is_whole(a[1])
            return bad("index must be a whole number")
        if a[1] < 0 or a[1] > len(a[0])
            return bad("index {as_int(a[1])} is out of range")
        insert(a[0], a[1], a[2])
        return ok(none)
    # remove
    if t == "list"
        if not is_num(type(a[1]))
            return bad("index must be a number, got " + type_of(a[1]))
        if not is_whole(a[1])
            return bad("index must be a whole number")
        if a[1] < 0 or a[1] >= len(a[0])
            return bad("index {as_int(a[1])} is out of range")
        return ok(remove(a[0], a[1]))
    if t == "map"
        if type(a[1]) != "string"
            return bad("map keys must be strings")
        if not (a[1] in a[0])
            return bad("map has no key '{a[1]}'")
        return ok(remove(a[0], a[1]))
    return bad("cannot remove from " + a_type(a[0]))

# num() on a string: the host's parser, so inf, nan, hex and range errors match.
fun parse_number(s)
    try
        return ok(num(s))
    catch e
        return bad(slice(e.message, 7, len(e.message)))
