# selfhost/interp.relic: the Relic tree-walk interpreter, written in Relic (M9, stage 3).
# Mirrors src/interp/interp.cpp and src/builtins/builtins.cpp: same results,
# same output, same runtime errors and positions.
#
# Values are host values (numbers, strings, bools, none, lists, maps). Functions
# and built-ins are maps tagged with the key chr(1), which Relic source cannot
# write by accident, so type() and printing can tell them apart from user maps.
# The tag is also checked by identity (see tagbox), so this file can run itself.
#
# Errors: the first error is stored in rt.err, every step after that is a
# no-op, and loops stop, so output after an error never happens (this was
# written before Relic had try / catch). Known limits are listed in
# docs/ARCHITECTURE.md (Self-host).
use lexer
use parser
use tokens_fmt
use std/files
use std/strings

let tag = chr(1)
# Functions and modules also carry this list under chr(2). It is checked by
# identity (host_same), so when this interpreter runs another copy of itself,
# the inner copy's tagged maps are plain maps to the outer one.
let tagbox = []
let idkey = chr(2)

fun tagged(v, kind)
    v[tag] = kind
    v[idkey] = tagbox
    return v
let max_depth = 800

fun new_env(parent) = {vars: {}, parent: parent, hints: {}}

# ---- `as` hints ----

fun type_ok(t, v)
    if t == "any"
        return true
    if t == "number"
        return is_num(type_of(v))
    return t == type_of(v)

fun check_type(rt, at, t, v, what)
    if rt.err == none and not type_ok(t, v)
        fail(rt, at, what + " " + t + ", got " + type_of(v))

# The hint of a Let (kid 1) or a Fun (kid 2), or "".
fun hint_of(n, i)
    if len(n.kids) > i and n.kids[i].kind == "Type"
        return n.kids[i].text
    return ""

# " (did you mean 'x'?)" for the closest name within a small edit distance.
fun suggest(name, names)
    let limit = 1
    if len(name) >= 5
        limit = 2
    let best = ""
    let best_d = limit + 1
    for c in names
        if c == name or c == "" or (strings.starts_with(c, "host_") and not strings.starts_with(name, "host_"))
            next
        if len(c) - len(name) > limit or len(name) - len(c) > limit
            next
        let d = edit_distance(name, c)
        if d < len(name) and (d < best_d or (d == best_d and c < best))
            best_d = d
            best = c
    if best == ""
        return ""
    return " (did you mean '{best}'?)"

fun edit_distance(a, b)
    let row = []
    for j in 0..len(b) + 1
        append(row, j)
    for i in 1..len(a) + 1
        let diag = row[0]
        row[0] = i
        for j in 1..len(b) + 1
            let up = row[j]
            let cost = 1
            if a[i - 1] == b[j - 1]
                cost = 0
            let v = row[j] + 1
            if row[j - 1] + 1 < v
                v = row[j - 1] + 1
            if diag + cost < v
                v = diag + cost
            row[j] = v
            diag = up
    return row[len(b)]

fun find(env, name)
    let e = env
    while e != none
        if name in e.vars
            return e
        e = e.parent
    return none

fun new_runtime()
    let rt = {err: none, ret: none, flow_node: none, depth: 0, next_id: 0, globals: none, builtins: none, file: "", modules: {}, args: []}
    let builtins = new_env(none)
    for b in [["print", -1], ["len", 1], ["append", 2], ["str", 1], ["keys", 1], ["type", 1], ["fail", 1], ["int", 1], ["float", 1], ["slice", 3], ["ord", 1], ["chr", 1], ["num", 1], ["pop", 1], ["insert", 3], ["remove", 2], ["args", 0], ["eprint", -1], ["gc", 0]]
        builtins.vars[b[0]] = tagged({name: b[0], arity: b[1]}, "builtin")
    # host_* built-ins (files, clocks, math, graphics) are passed through to the host.
    for b in host_names()
        builtins.vars[b[0]] = tagged({name: b[0], arity: b[1]}, "builtin")
    rt.globals = new_env(builtins)
    rt.builtins = builtins
    return rt

# ---- modules ----

# The main file is a module too, so a module that uses it back gets the same scope.
fun set_main(rt, path)
    rt.file = path
    let name = path
    let cut = last_slash(name)
    name = slice(name, cut + 1, len(name))
    if len(name) > 6 and slice(name, len(name) - 6, len(name)) == ".relic"
        name = slice(name, 0, len(name) - 6)
    rt.modules[norm_path(path)] = new_module(name, rt.globals)

fun new_module(name, scope)
    return tagged({name: name, scope: scope}, "module")

fun last_slash(s)
    let cut = -1
    for i in 0..len(s)
        if s[i] == "/" or s[i] == "\\"
            cut = i
    return cut

fun folder_of(file) = slice(file, 0, last_slash(file) + 1)

# A cache key for a path: drops "." parts and folds "dir/.." away.
fun norm_path(p)
    let parts = []
    let cur = ""
    for c in p + "/"
        if c == "/" or c == "\\"
            if cur == ".."  and len(parts) > 0 and parts[len(parts) - 1] != ".." and parts[len(parts) - 1] != ""
                pop(parts)
            else if cur != "." and not (cur == "" and len(parts) > 0)
                append(parts, cur)
            cur = ""
        else
            cur = cur + c
    let out = ""
    for i in 0..len(parts)
        if i > 0
            out = out + "/"
        out = out + parts[i]
    return out

fun load_module(rt, n)
    let path = n.text
    let file = folder_of(rt.file) + path + ".relic"
    if len(path) >= 4 and slice(path, 0, 4) == "std/"
        file = host_std_root() + slice(path, 4, len(path)) + ".relic"
    let key = norm_path(file)
    if key in rt.modules
        return rt.modules[key]
    if not files.exists(file)
        return fail(rt, n, "cannot find module '{path}' (no file {path}.relic)")
    let name = slice(path, last_slash(path) + 1, len(path))
    let mod = new_module(name, new_env(rt.builtins))
    rt.modules[key] = mod
    let saved = rt.file
    rt.file = file
    let lexed = lexer.lex(files.read(file))
    let err = lexed.err
    if err == none
        let parsed = parser.parse(lexed.tokens)
        err = parsed.err
        if err == none
            for s in parsed.tree.kids
                let f = exec(rt, s, mod.scope)
                if rt.err != none
                    break
                if f == "return"
                    fail(rt, rt.flow_node, "'return' outside a function")
                else if f == "break"
                    fail(rt, rt.flow_node, "'break' outside a loop")
                else if f == "next"
                    fail(rt, rt.flow_node, "'next' outside a loop")
    if err != none and rt.err == none
        rt.err = {line: err.line, col: err.col, msg: err.msg, file: file}
    rt.file = saved
    return mod

fun fail(rt, at, msg)
    if rt.err == none
        rt.err = {line: at.line, col: at.col, msg: msg, file: rt.file}
    return none

# ---- values ----

fun is_num(t) = t == "int" or t == "float"

# Type name with "a" or "an" in front, for error messages.
fun a_type(v)
    let t = type_of(v)
    if t == "int"
        return "an int"
    return "a " + t

fun type_of(v)
    let t = type(v)
    if t == "map" and idkey in v and host_same(v[idkey], tagbox)
        if v[tag] == "module"
            return "module"
        return "function"
    return t

fun is_plain_name(s)
    if s == "" or not (lexer.is_alpha(s[0]) or s[0] == "_")
        return false
    for c in s
        if not lexer.is_word(c)
            return false
    return true

fun show(v)
    if type(v) == "string"
        return v
    return repr(v)

fun repr(v)
    return repr_in(v, [])

# A list or map that holds itself prints as [...] or {...} where it repeats,
# like the host, and so does anything nested 1000 deep.
fun repr_in(v, path)
    let t = type_of(v)
    if t == "string"
        return tokens_fmt.quote(v)
    if t == "list" or t == "map"
        let seen = len(path) >= 1000
        for p in path
            if host_same(p, v)
                seen = true
        if seen
            if t == "list"
                return "[...]"
            return "{{...}}"
        append(path, v)
    if t == "list"
        let s = "["
        let first = true
        for x in v
            if not first
                s = s + ", "
            s = s + repr_in(x, path)
            first = false
        pop(path)
        return s + "]"
    if t == "map"
        let s = "{{"
        let first = true
        for k in v
            if not first
                s = s + ", "
            if is_plain_name(k)
                s = s + k
            else
                s = s + tokens_fmt.quote(k)
            s = s + ": " + repr_in(v[k], path)
            first = false
        pop(path)
        return s + "}}"
    if t == "function"
        return "<fun " + v.name + ">"
    if t == "module"
        return "<module " + v.name + ">"
    return str(v)

fun equal(a, b)
    let ta = type_of(a)
    if is_num(ta) and is_num(type(b))
        return a == b
    if ta != type_of(b)
        return false
    if ta == "list"
        if host_same(a, b)
            return true
        if len(a) != len(b)
            return false
        for i in 0..len(a)
            if not equal(a[i], b[i])
                return false
        return true
    if ta == "map"
        if host_same(a, b)
            return true
        if len(a) != len(b)
            return false
        for k in a
            if not (k in b) or not equal(a[k], b[k])
                return false
        return true
    if ta == "function"
        if a[tag] != b[tag]
            return false
        if a[tag] == "builtin"
            return a.name == b.name
        return a.id == b.id
    return a == b

fun is_whole(d) = d % 1 == 0

# Number to whole-number index, or an error (gives none).
fun whole(rt, at, v, what)
    if not is_num(type(v))
        return fail(rt, at, what + " must be a number, got " + type_of(v))
    if not is_whole(v) or v > 9000000000000000 or v < -9000000000000000
        return fail(rt, at, what + " must be a whole number")
    return v

fun slot(rt, at, idx, size, what)
    let i = whole(rt, at, idx, what)
    if i == none
        return none
    if i < 0 or i >= size
        return fail(rt, at, "{what} {i} is out of range (size {size})")
    return i

# ---- statements ----

fun run(rt, program)
    for s in program.kids
        if rt.err != none
            return
        let f = exec(rt, s, rt.globals)
        if rt.err != none
            return
        if f == "return"
            fail(rt, rt.flow_node, "'return' outside a function")
        else if f == "break"
            fail(rt, rt.flow_node, "'break' outside a loop")
        else if f == "next"
            fail(rt, rt.flow_node, "'next' outside a loop")

fun exec_block(rt, block, env)
    for s in block.kids
        let f = exec(rt, s, env)
        if rt.err != none
            return "error"
        if f != "normal"
            return f
    return "normal"

fun condition(rt, n, env, what)
    let v = eval(rt, n, env)
    if rt.err != none
        return false
    if type(v) != "bool"
        fail(rt, n, what + " must be true or false, got " + type_of(v))
        return false
    return v

fun exec(rt, n, env)
    let k = n.kind
    if k == "Let"
        let v = eval(rt, n.kids[0], env)
        let hint = hint_of(n, 1)
        if hint != ""
            check_type(rt, n.kids[0], hint, v, "'{n.text}' must be")
            env.hints[n.text] = hint
        else if n.text in env.hints
            remove(env.hints, n.text)
        if rt.err == none
            env.vars[n.text] = v
        return "normal"
    if k == "Assign"
        let v = eval(rt, n.kids[1], env)
        if rt.err == none
            assign(rt, n.kids[0], v, env, n.kids[1])
        return "normal"
    if k == "ExprStmt"
        eval(rt, n.kids[0], env)
        return "normal"
    if k == "Fun"
        rt.next_id = rt.next_id + 1
        let f = tagged({name: n.text, node: n, closure: env, id: rt.next_id, file: rt.file}, "fun")
        env.vars[n.text] = f
        return "normal"
    if k == "If"
        if condition(rt, n.kids[0], env, "'if' condition")
            return exec_block(rt, n.kids[1], new_env(env))
        if rt.err == none and len(n.kids) > 2
            let alt = n.kids[2]
            if alt.kind == "If"
                return exec(rt, alt, env)
            return exec_block(rt, alt, new_env(env))
        return "normal"
    if k == "While"
        while condition(rt, n.kids[0], env, "'while' condition")
            let f = exec_block(rt, n.kids[1], new_env(env))
            if f == "break" or f == "error"
                break
            if f == "return"
                return f
        return "normal"
    if k == "For"
        let src = eval(rt, n.kids[0], env)
        if rt.err != none
            return "normal"
        let t = type_of(src)
        let items = []
        if t == "list"
            items = slice(src, 0, len(src))
        else if t == "string"
            for c in src
                append(items, c)
        else if t == "map"
            items = keys(src)
        else
            fail(rt, n.kids[0], "cannot loop over " + a_type(src))
            return "normal"
        for item in items
            let scope = new_env(env)
            scope.vars[n.text] = item
            let f = exec_block(rt, n.kids[1], scope)
            if f == "break" or f == "error"
                break
            if f == "return"
                return f
        return "normal"
    if k == "Return"
        if len(n.kids) == 0
            rt.ret = none
        else
            rt.ret = eval(rt, n.kids[0], env)
        rt.flow_node = n
        return "return"
    if k == "Try"
        let depth = rt.depth
        let f = exec_block(rt, n.kids[0], new_env(env))
        if rt.err == none
            return f
        let e = rt.err
        rt.err = none
        rt.depth = depth
        let scope = new_env(env)
        if n.text != ""
            scope.vars[n.text] = {message: e.msg, line: e.line, col: e.col}
        return exec_block(rt, n.kids[1], scope)
    if k == "Break"
        rt.flow_node = n
        return "break"
    if k == "Next"
        rt.flow_node = n
        return "next"
    if k == "Use"
        let m = load_module(rt, n)
        if rt.err == none
            if len(n.kids) > 0
                env.vars[n.kids[0].text] = m
            else
                env.vars[m.name] = m
        return "normal"
    fail(rt, n, "cannot run a " + k + " here")
    return "normal"

fun assign(rt, target, v, env, value_at)
    if target.kind == "Name"
        let e = find(env, target.text)
        if e == none or host_same(e, rt.builtins)
            return fail(rt, target, "'{target.text}' is not declared; use 'let {target.text} = ...'")
        if target.text in e.hints
            check_type(rt, value_at, e.hints[target.text], v, "'{target.text}' must be")
            if rt.err != none
                return
        e.vars[target.text] = v
        return
    let obj = eval(rt, target.kids[0], env)
    if rt.err != none
        return
    let t = type_of(obj)
    if target.kind == "Field"
        if t == "module"
            return fail(rt, target, "cannot change a module's names from outside; give it a function that does it")
        if t != "map"
            return fail(rt, target, "cannot set a field on " + a_type(obj))
        obj[target.text] = v
        return
    let idx = eval(rt, target.kids[1], env)
    if rt.err != none
        return
    if t == "list"
        let i = slot(rt, target.kids[1], idx, len(obj), "list index")
        if i != none
            obj[i] = v
    else if t == "map"
        if type(idx) != "string"
            return fail(rt, target.kids[1], "map keys must be strings")
        obj[idx] = v
    else
        fail(rt, target, "cannot set an index on " + a_type(obj))

# ---- expressions ----

# The frame stack (SH3, option C, Daniel's pick, Oct 24 2026). eval runs an
# expression on its own stack instead of the host's, so a deep Relic program
# does not run out of host calls before it reaches max_depth. Leaves are
# answered at once, with no frame. Any other node gets a frame: a small list
# [step, node, env], where step is one of the codes below. Values go on vals.
# A step_eval frame looks at a node and pushes the frames for its parts; the
# other steps run once those parts are on vals and combine them. Errors stop
# the loop at once, so nothing runs after the first one, as before.
# Since 1.0.15 every expression kind runs here except calls, which still go
# to call() and recurse on the host (the next slices change that).
let step_eval = 0
let step_unary = 1
let step_logic_left = 2
let step_logic_right = 3
let step_binary = 4
let step_interp = 5
let step_list = 6
let step_map = 7
let step_range_start = 8
let step_range_end = 9
let step_field = 10
let step_index = 11

fun eval(rt, n, env)
    if rt.err != none
        return none
    let k = n.kind
    if k == "Name"
        let e = find(env, n.text)
        if e != none
            return e.vars[n.text]
        return not_defined(rt, n, env)
    if k == "String"
        return n.text
    if k == "Call"
        return call(rt, n, env)
    let stack = [[step_eval, n, env]]
    let vals = []
    while len(stack) > 0
        let fr = pop(stack)
        let step = fr[0]
        let m = fr[1]
        if step == step_eval
            let en = fr[2]
            let mk = m.kind
            if mk == "Name"
                let e = find(en, m.text)
                if e == none
                    return not_defined(rt, m, en)
                append(vals, e.vars[m.text])
            else if mk == "Call"
                append(vals, call(rt, m, en))
                if rt.err != none
                    return none
            else if mk == "Binary"
                if m.text == "and" or m.text == "or"
                    append(stack, [step_logic_left, m, en])
                    append(stack, [step_eval, m.kids[0], en])
                else
                    append(stack, [step_binary, m])
                    append(stack, [step_eval, m.kids[1], en])
                    append(stack, [step_eval, m.kids[0], en])
            else if mk == "String"
                append(vals, m.text)
            else if mk == "Number"
                try
                    append(vals, num(m.text))
                catch err
                    return fail(rt, m, "float is too large")
            else if mk == "True"
                append(vals, true)
            else if mk == "False"
                append(vals, false)
            else if mk == "None"
                append(vals, none)
            else if mk == "Field"
                append(stack, [step_field, m])
                append(stack, [step_eval, m.kids[0], en])
            else if mk == "Index"
                append(stack, [step_index, m])
                append(stack, [step_eval, m.kids[1], en])
                append(stack, [step_eval, m.kids[0], en])
            else if mk == "Unary"
                append(stack, [step_unary, m])
                append(stack, [step_eval, m.kids[0], en])
            else if mk == "List" or mk == "Interp"
                if mk == "List"
                    append(stack, [step_list, m])
                else
                    append(stack, [step_interp, m])
                let i = len(m.kids) - 1
                while i >= 0
                    append(stack, [step_eval, m.kids[i], en])
                    i = i - 1
            else if mk == "Map"
                append(stack, [step_map, m])
                let i = len(m.kids) - 1
                while i >= 0
                    append(stack, [step_eval, m.kids[i].kids[0], en])
                    i = i - 1
            else if mk == "Range"
                append(stack, [step_range_start, m, en])
                append(stack, [step_eval, m.kids[0], en])
            else
                return fail(rt, m, "cannot evaluate a " + mk)
        else if step == step_binary
            let b = pop(vals)
            let r = binop(rt, m, pop(vals), b)
            if rt.err != none
                return none
            append(vals, r)
        else if step == step_logic_left
            let v = pop(vals)
            if type(v) != "bool"
                return fail(rt, m.kids[0], "'" + m.text + "' operand must be true or false, got " + type_of(v))
            if m.text == "and" and not v
                append(vals, false)
            else if m.text == "or" and v
                append(vals, true)
            else
                append(stack, [step_logic_right, m])
                append(stack, [step_eval, m.kids[1], fr[2]])
        else if step == step_logic_right
            let v = vals[len(vals) - 1]
            if type(v) != "bool"
                return fail(rt, m.kids[1], "'" + m.text + "' operand must be true or false, got " + type_of(v))
        else if step == step_field
            let r = field_of(rt, m, pop(vals))
            if rt.err != none
                return none
            append(vals, r)
        else if step == step_index
            let idx = pop(vals)
            let r = index_of(rt, m, pop(vals), idx)
            if rt.err != none
                return none
            append(vals, r)
        else if step == step_unary
            let r = unary_of(rt, m, pop(vals))
            if rt.err != none
                return none
            append(vals, r)
        else if step == step_list
            let start = len(vals) - len(m.kids)
            let l = slice(vals, start, len(vals))
            drop(vals, start)
            append(vals, l)
        else if step == step_interp
            let start = len(vals) - len(m.kids)
            let s = ""
            for i in start..len(vals)
                s = s + show(vals[i])
            drop(vals, start)
            append(vals, s)
        else if step == step_map
            let start = len(vals) - len(m.kids)
            let mp = {}
            for i in 0..len(m.kids)
                mp[m.kids[i].text] = vals[start + i]
            drop(vals, start)
            append(vals, mp)
        else if step == step_range_start
            # The start is checked before the end is evaluated, as before.
            let a = whole(rt, m.kids[0], vals[len(vals) - 1], "range start")
            if rt.err != none
                return none
            append(stack, [step_range_end, m])
            append(stack, [step_eval, m.kids[1], fr[2]])
        else
            # step_range_end
            let b = whole(rt, m.kids[1], pop(vals), "range end")
            let a = pop(vals)
            if rt.err != none
                return none
            if b - a > 10000000
                return fail(rt, m, "range is too large")
            append(vals, a..b)
    return vals[0]

# Pops vals down to len start.
fun drop(vals, start)
    while len(vals) > start
        pop(vals)

fun not_defined(rt, n, env)
    let names = []
    let s = env
    while s != none
        for name in keys(s.vars)
            append(names, name)
        s = s.parent
    return fail(rt, n, "'{n.text}' is not defined" + suggest(n.text, names))

fun unary_of(rt, n, v)
    if n.text == "-"
        if not is_num(type(v))
            return fail(rt, n, "cannot negate " + a_type(v))
        if type(v) == "float"
            return -v
        return math(rt, n, "-", 0, v)
    if type(v) != "bool"
        return fail(rt, n, "'not' needs true or false, got " + type_of(v))
    return not v

fun field_of(rt, n, obj)
    if type_of(obj) == "module"
        if len(n.text) > 0 and n.text[0] == "_"
            return fail(rt, n, "'{n.text}' is private to module '{obj.name}'")
        if not (n.text in obj.scope.vars)
            return fail(rt, n, "module '{obj.name}' has no '{n.text}' (yet)")
        return obj.scope.vars[n.text]
    if type_of(obj) != "map"
        return fail(rt, n, "cannot read a field of " + a_type(obj))
    if not (n.text in obj)
        return fail(rt, n, "map has no key '{n.text}'" + suggest(n.text, keys(obj)))
    return obj[n.text]

fun index_of(rt, n, obj, idx)
    let t = type_of(obj)
    if t == "list"
        let i = slot(rt, n.kids[1], idx, len(obj), "list index")
        if i == none
            return none
        return obj[i]
    if t == "string"
        let i = slot(rt, n.kids[1], idx, len(obj), "string index")
        if i == none
            return none
        return obj[i]
    if t == "map"
        if type(idx) != "string"
            return fail(rt, n.kids[1], "map keys must be strings")
        if not (idx in obj)
            return fail(rt, n.kids[1], "map has no key '{idx}'" + suggest(idx, keys(obj)))
        return obj[idx]
    return fail(rt, n, "cannot index " + a_type(obj))

fun mismatch(rt, n, verb, a, b) = fail(rt, n, "cannot " + verb + " " + a_type(a) + " and " + a_type(b))

# Every binary operator but 'and' and 'or', on values already evaluated.
fun binop(rt, n, a, b)
    let op = n.text
    let ta = type_of(a)
    let tb = type_of(b)
    if op == "=="
        return equal(a, b)
    if op == "!="
        return not equal(a, b)
    if op == "in"
        if tb == "list"
            for x in b
                if equal(a, x)
                    return true
            return false
        if tb == "map"
            if ta != "string"
                return fail(rt, n, "map keys must be strings")
            return a in b
        if tb == "string"
            if ta != "string"
                return fail(rt, n, "can only look for a string inside a string")
            return a in b
        return fail(rt, n, "cannot look inside " + a_type(b))
    if op == "+"
        if is_num(ta) and is_num(tb)
            return math(rt, n, op, a, b)
        if (ta == "string" and tb == "string") or (ta == "list" and tb == "list")
            return a + b
        return mismatch(rt, n, "add", a, b)
    if op == "<" or op == "<=" or op == ">" or op == ">="
        if not ((is_num(ta) and is_num(tb)) or (ta == "string" and tb == "string"))
            return mismatch(rt, n, "compare", a, b)
        if op == "<"
            return a < b
        if op == "<="
            return a <= b
        if op == ">"
            return a > b
        return a >= b
    if not is_num(ta) or not is_num(tb)
        if op == "-"
            return mismatch(rt, n, "subtract", a, b)
        if op == "*"
            return mismatch(rt, n, "multiply", a, b)
        return mismatch(rt, n, "divide", a, b)
    if b == 0 and (op == "/" or op == "%")
        return fail(rt, n, "division by zero")
    return math(rt, n, op, a, b)

# Number math runs on the host; an int overflow there becomes this program's error.
fun math(rt, n, op, a, b)
    try
        if op == "+"
            return a + b
        if op == "-"
            return a - b
        if op == "*"
            return a * b
        if op == "/"
            return a / b
        return a % b
    catch e
        return fail(rt, n, e.message)

fun plural(n)
    if n == 1
        return ""
    return "s"

fun call(rt, n, env)
    let callee = eval(rt, n.kids[0], env)
    let argv = []
    for i in 1..len(n.kids)
        append(argv, eval(rt, n.kids[i], env))
    if rt.err != none
        return none
    if type_of(callee) != "function"
        return fail(rt, n, "cannot call " + a_type(callee))
    if callee[tag] == "builtin"
        if callee.arity >= 0 and len(argv) != callee.arity
            return fail(rt, n, "{callee.name}() takes {callee.arity} argument{plural(callee.arity)}, got {len(argv)}")
        let r = builtin(rt, callee.name, argv)
        if r.err != none
            if callee.name == "fail"
                return fail(rt, n, r.err)
            return fail(rt, n, callee.name + "(): " + r.err)
        return r.value
    let f = callee
    let params = f.node.kids[0].kids
    if len(argv) != len(params)
        return fail(rt, n, "{f.name}() takes {len(params)} argument{plural(len(params))}, got {len(argv)}")
    if rt.depth >= max_depth
        return fail(rt, n, "too much recursion (more than {max_depth} calls deep)")
    let scope = new_env(f.closure)
    for i in 0..len(argv)
        let prm = params[i]
        if len(prm.kids) > 0
            check_type(rt, n, prm.kids[0].text, argv[i], "{f.name}() argument '{prm.text}' must be")
            if rt.err != none
                return none
            scope.hints[prm.text] = prm.kids[0].text
        scope.vars[prm.text] = argv[i]
    let body = f.node.kids[1]
    let ret_hint = hint_of(f.node, 2)
    let ret_what = "{f.name}() must return"
    rt.depth = rt.depth + 1
    let saved_file = rt.file
    rt.file = f.file
    let result = none
    if body.kind != "Block"
        result = eval(rt, body, scope)
        if ret_hint != ""
            check_type(rt, body, ret_hint, result, ret_what)
    else
        let fl = exec_block(rt, body, scope)
        if fl == "break"
            fail(rt, rt.flow_node, "'break' outside a loop")
        else if fl == "next"
            fail(rt, rt.flow_node, "'next' outside a loop")
        else if fl == "return"
            result = rt.ret
            rt.ret = none
            if ret_hint != ""
                check_type(rt, rt.flow_node, ret_hint, result, ret_what)
        else if ret_hint != "" and fl == "normal"
            check_type(rt, f.node, ret_hint, none, ret_what)
    if rt.err != none
        std_boundary(rt, f, saved_file, n)
    rt.depth = rt.depth - 1
    rt.file = saved_file
    return result

# An error leaving std into user code is reported at the user's call, with
# "host_x(): " renamed to the std function the user called.
fun in_std(file)
    let root = norm_path(host_std_root())
    let k = norm_path(file)
    return file != "" and len(k) > len(root) and slice(k, 0, len(root)) == root

fun std_boundary(rt, f, caller_file, n)
    if not in_std(f.file) or in_std(caller_file)
        return none
    if rt.err.file != "" and not in_std(rt.err.file)
        return none
    let msg = rt.err.msg
    let cut = strings.find(msg, "(): ")
    if strings.starts_with(msg, "host_") and cut >= 0
        let stem = slice(f.file, last_slash(f.file) + 1, len(f.file))
        stem = slice(stem, 0, len(stem) - 6)
        msg = stem + "." + f.name + "(): " + slice(msg, cut + 4, len(msg))
    rt.err = {line: n.line, col: n.col, msg: msg, file: caller_file}

# ---- built-ins: {value, err}, err is the message without the name ----

fun ok(v) = {value: v, err: none}
fun bad(msg) = {value: none, err: msg}

fun builtin(rt, name, a)
    if name == "print" or name == "eprint"
        let s = ""
        for i in 0..len(a)
            if i > 0
                s = s + " "
            s = s + show(a[i])
        if name == "print"
            print(s)
        else
            eprint(s)
        return ok(none)
    let t = ""
    if len(a) > 0
        t = type_of(a[0])
    if name == "len"
        if t == "string" or t == "list" or t == "map"
            return ok(len(a[0]))
        return bad("cannot get the length of " + a_type(a[0]))
    if name == "append"
        if t != "list"
            return bad("first argument must be a list, got " + t)
        append(a[0], a[1])
        return ok(none)
    if name == "str"
        return ok(show(a[0]))
    if name == "keys"
        if t != "map"
            return bad("argument must be a map, got " + t)
        return ok(keys(a[0]))
    if name == "type"
        return ok(t)
    if name == "int" or name == "float"
        # The host does the work; its message comes back without the "int(): " part.
        try
            if name == "int"
                return ok(int(a[0]))
            return ok(float(a[0]))
        catch e
            return bad(slice(e.message, len(name) + 4, len(e.message)))
    if name == "fail"
        if t != "string"
            return bad("fail(): message must be a string, got " + t)
        return bad(a[0])
    if name == "args" or name == "host_args"
        return ok(slice(rt.args, 0, len(rt.args)))
    if slice(name, 0, 5) == "host_"
        try
            return ok(host_call(name, a))
        catch e
            return bad(slice(e.message, 13, len(e.message)))
    if name == "slice"
        for i in [1, 2]
            let what = "start"
            if i == 2
                what = "end"
            if not is_num(type(a[i]))
                return bad(what + " must be a number, got " + type_of(a[i]))
            if not is_whole(a[i])
                return bad(what + " must be a whole number")
        if t != "string" and t != "list"
            return bad("cannot slice " + a_type(a[0]))
        return ok(slice(a[0], a[1], a[2]))
    if name == "ord"
        if t != "string"
            return bad("argument must be a string, got " + t)
        if len(a[0]) != 1
            return bad("needs a one-character string")
        return ok(ord(a[0]))
    if name == "chr"
        if not is_num(t)
            return bad("argument must be a number, got " + t)
        if not is_whole(a[0])
            return bad("argument must be a whole number")
        if a[0] < 0 or a[0] > 1114111 or (a[0] >= 55296 and a[0] <= 57343)
            return bad("code must be 0 to 1114111 and not 55296 to 57343 (surrogates)")
        return ok(chr(a[0]))
    if name == "gc"
        # Its values live on the host heap, so the host's collector runs and counts them.
        return ok(gc())
    if name == "num"
        if is_num(t)
            return ok(a[0])
        if t != "string"
            return bad("argument must be a string, got " + t)
        return parse_number(a[0])
    if name == "pop"
        if t != "list"
            return bad("first argument must be a list, got " + t)
        if len(a[0]) == 0
            return bad("list is empty")
        return ok(pop(a[0]))
    if name == "insert"
        if t != "list"
            return bad("first argument must be a list, got " + t)
        if not is_num(type(a[1]))
            return bad("index must be a number, got " + type_of(a[1]))
        if not is_whole(a[1])
            return bad("index must be a whole number")
        if a[1] < 0 or a[1] > len(a[0])
            return bad("index {a[1]} is out of range")
        insert(a[0], a[1], a[2])
        return ok(none)
    # remove
    if t == "list"
        if not is_num(type(a[1]))
            return bad("index must be a number, got " + type_of(a[1]))
        if not is_whole(a[1])
            return bad("index must be a whole number")
        if a[1] < 0 or a[1] >= len(a[0])
            return bad("index {a[1]} is out of range")
        return ok(remove(a[0], a[1]))
    if t == "map"
        if type(a[1]) != "string"
            return bad("map keys must be strings")
        if not (a[1] in a[0])
            return bad("map has no key '{a[1]}'")
        return ok(remove(a[0], a[1]))
    return bad("cannot remove from " + a_type(a[0]))

# num() on a string: the host's parser, so inf, nan, hex and range errors match.
fun parse_number(s)
    try
        return ok(num(s))
    catch e
        return bad(slice(e.message, 7, len(e.message)))
