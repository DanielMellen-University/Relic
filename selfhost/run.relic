# selfhost/run.relic: runs a Relic file with the lexer, parser and interpreter
# written in Relic. Same output and errors as `relic FILE`.
#   relic selfhost/run.relic FILE [args...]
# Words after FILE are what the program gets from args().
# Exit codes like the host's: 1 for an error nobody caught, 2 for bad usage or a
# file that cannot be opened. A program's own os.exit(code) is passed through.
use lexer
use parser
use interp
use std/files
use errfmt

let argv = args()
if len(argv) < 1
    eprint("usage: relic selfhost/run.relic FILE [args...]")
    host_exit(2)
else if not files.exists(argv[0]) or files.is_dir(argv[0])
    eprint("relic: cannot open {argv[0]}")
    host_exit(2)
else
    let path = argv[0]
    let lexed = lexer.lex(files.read(path))
    let err = lexed.err
    if err == none
        let parsed = parser.parse(lexed.tokens)
        err = parsed.err
        if err == none
            let rt = interp.new_runtime()
            rt.args = slice(argv, 1, len(argv))
            interp.set_main(rt, path)
            interp.run(rt, parsed.tree)
            err = rt.err
    if err != none
        if "file" in err and err.file != ""
            path = err.file
        errfmt.show(path, err)
        host_exit(1)
