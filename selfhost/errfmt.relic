# selfhost/errfmt.relic: error text the same as the host prints, the
# "path:line:col: error: msg" line and then the source line with a caret.
use std/files
use std/strings

fun _byte_len(c)
    let n = ord(c)
    if n < 128
        return 1
    if n < 2048
        return 2
    if n < 65536
        return 3
    return 4

# Very long lines are cut to a window of 160 bytes around the column, on character edges,
# the way the host does. Gives [text, col] with the column moved to match.
# Columns count characters, so the window start is found by walking that many
# characters in, and the column is moved by the characters cut off, not the bytes.
fun _window(text, col)
    let total = 0
    for c in text
        total = total + _byte_len(c)
    if total <= 160
        return [text, col]
    let skip = 0
    if col > 80
        skip = col - 80
    # the character `skip` characters in: its byte offset and its index
    let from = 0
    let first = 0
    let n = 0
    for c in text
        if n >= skip
            break
        from = from + _byte_len(c)
        n = n + 1
    first = n
    # past from + 160 bytes, up to the next character start
    let stop = from + 160
    let pos = from
    let i = first
    # (text[i] walks the line from its start, so the rest is read in one pass)
    for c in slice(text, first, len(text))
        if pos >= stop
            break
        pos = pos + _byte_len(c)
        i = i + 1
    return [slice(text, first, i), col - first]

fun snippet(path, line, col, end)
    if line < 1 or col < 1 or not files.exists(path)
        return ""
    return snippet_in(strings.split(files.read(path), "\n"), line, col, end)

# The same from the file's lines, split once by a caller with many messages for
# one file (check.relic read and split the whole file again for each warning).
# end is the last column to underline; a value below col underlines col only.
fun snippet_in(lines, line, col, end)
    if line < 1 or col < 1 or line > len(lines)
        return ""
    let text = lines[line - 1]
    if len(text) > 0 and text[len(text) - 1] == chr(13)
        text = slice(text, 0, len(text) - 1)
    if strings.trim(text) == ""
        return ""
    let saved = col
    let w = _window(text, col)
    text = w[0]
    col = w[1]
    if end < saved
        end = saved
    end = end - (saved - col)
    if end < col
        end = col
    let pad = ""
    let n = 0
    for c in text
        if n >= col - 1
            break
        if c == chr(9)
            pad = pad + c
        else
            pad = pad + " "
        n = n + 1
    let marks = ""
    let want = end - col + 1
    if want < 1
        want = 1
    if want > 200
        want = 200
    while len(marks) < want
        marks = marks + "^"
    return "    {text}\n    {pad}{marks}\n"

fun _end_of(err)
    if "end" in err and err.end != none and err.end >= err.col
        return err.end
    return err.col

fun _hint_of(err)
    if "hint" in err and err.hint != none
        return err.hint
    return ""

fun show(path, err)
    eprint("{path}:{err.line}:{err.col}: error: {err.msg}")
    let s = snippet(path, err.line, err.col, _end_of(err))
    if s != ""
        eprint(slice(s, 0, len(s) - 1))
    let hint = _hint_of(err)
    if hint != ""
        eprint("hint: {hint}")
