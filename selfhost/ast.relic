# selfhost/ast.relic: same output as `relic --ast FILE`, using the Relic lexer and parser.
#   relic selfhost/ast.relic FILE
# Exit codes like the host's: 1 for a lex or parse error, 2 for bad usage or a file that cannot be opened.
use lexer
use parser
use tokens_fmt
use std/files
use errfmt

# Depth first from a stack of [node, depth], not recursion, so a long chain
# (a + b + ..., else if ...) does not reach the 800-call limit.
fun dump(top, start, out)
    let todo = [[top, start]]
    while len(todo) > 0
        let item = pop(todo)
        let n = item[0]
        let depth = item[1]
        let line = ""
        for i in 0..depth
            line = line + "  "
        line = line + n.kind
        if n.kind == "String"
            line = line + " " + tokens_fmt.quote(n.text)
        else if n.text != ""
            line = line + " " + n.text
        append(out, line)
        let i = len(n.kids) - 1
        while i >= 0
            append(todo, [n.kids[i], depth + 1])
            i = i - 1

let argv = args()
if len(argv) != 1
    eprint("usage: relic selfhost/ast.relic FILE")
    host_exit(2)
else if not files.exists(argv[0]) or files.is_dir(argv[0])
    eprint("relic: cannot open {argv[0]}")
    host_exit(2)
else
    let path = argv[0]
    let lexed = lexer.lex(files.read(path))
    let err = lexed.err
    let tree = none
    if err == none
        let parsed = parser.parse(lexed.tokens)
        err = parsed.err
        tree = parsed.tree
    if err != none
        errfmt.show(path, err)
        host_exit(1)
    else
        let out = []
        dump(tree, 0, out)
        for line in out
            print(line)
