# selfhost/check.relic: `relic check FILE...` written in Relic (SH4). Same
# warnings, same order, same exit code as the host's `relic check`:
#   relic selfhost/check.relic FILE...
# It mirrors the host's VM compiler (src/vm/vm.cpp, vm_check): the same walk
# over the tree, in the same order, with the same scopes, so a name is
# reported when the compiler would have found nothing to load. The scope
# rules in short:
#   - a function has one scope for its parameters and the names of its body;
#     a block gets a scope only if it has a `let` or `fun` of its own
#   - a name a block declares further down is "pending": a function nested in
#     that block may read it (it is set by the time the call runs)
#   - top-level `let` and `fun` names exist from the start as globals, but only
#     after their line has run: a read in the main code above them is "used
#     before it is defined"
use lexer
use parser
use interp
use errfmt
use std/files
use std/lists
use std/strings

fun new_scope() = {names: {}, pending: {}}

# The state of one file's check.
fun new_check()
    let rt = interp.new_runtime()
    return {
        items: [],
        scopes: [],
        fns: [{base: 0, loops: 0}],
        gset: {},
        defined: {},
        reads: [],
        builtins: rt.builtins.vars
    }

fun add_item(ck, n, msg)
    append(ck.items, {line: n.line, col: n.col, msg: msg})

fun use_name(n)
    if len(n.kids) > 0
        return n.kids[0].text
    let t = n.text
    let cut = -1
    for i in 0..len(t)
        if t[i] == "/"
            cut = i
    return slice(t, cut + 1, len(t))

fun declares(block)
    for s in block.kids
        if s.kind == "Let" or s.kind == "Fun"
            return true
    return false

# The names a block declares further down (for functions nested before them).
fun pend(sc, body)
    for st in body.kids
        if st.kind == "Let" or st.kind == "Fun"
            sc.pending[st.text] = true
        else if st.kind == "Use"
            sc.pending[use_name(st)] = true

fun open_scope(ck, body)
    let sc = new_scope()
    if body != none
        pend(sc, body)
    append(ck.scopes, sc)

fun close_scope(ck)
    pop(ck.scopes)

fun in_main(ck) = len(ck.fns) == 1

# Declares in the innermost scope, or as a global at the top level.
fun declare(ck, name)
    if len(ck.scopes) == 0
        ck.gset[name] = true
        ck.defined[name] = true
        return
    let sc = ck.scopes[len(ck.scopes) - 1]
    if name in sc.pending
        remove(sc.pending, name)
    sc.names[name] = true

fun find_late(ck, name)
    let base = ck.fns[len(ck.fns) - 1].base
    let i = len(ck.scopes) - 1
    while i >= base
        if name in ck.scopes[i].names
            return false
        i = i - 1
    i = base - 1
    while i >= 0
        if name in ck.scopes[i].names
            return false
        if name in ck.scopes[i].pending
            return true
        i = i - 1
    return false

fun resolves(ck, name)
    let i = len(ck.scopes) - 1
    while i >= 0
        if name in ck.scopes[i].names
            return true
        i = i - 1
    return false

fun load_name(ck, n)
    let name = n.text
    if find_late(ck, name)
        return
    if resolves(ck, name)
        return
    if name in ck.gset
        if in_main(ck) and not (name in ck.defined) and not (name in ck.builtins)
            add_item(ck, n, "'{name}' is used before it is defined")
        return
    if name in ck.builtins
        return
    # Not found: a global declared later still counts, so decide at the end.
    let locals = []
    for sc in ck.scopes
        for k in keys(sc.names)
            append(locals, k)
    append(ck.reads, {node: n, locals: locals})

fun number(ck, n)
    try
        let v = num(n.text)
        if type(v) == "float" and not ("." in n.text or "e" in n.text or "E" in n.text)
            add_item(ck, n, "int is too large (the limit is 9223372036854775807)")
    catch err
        # num() rounds a tiny float to a subnormal or 0.0 like the host, so it only
        # refuses a literal that is too large
        add_item(ck, n, "float is too large")

# Visits the nodes in the same order as a recursive walk, from a list used as
# a stack, so a long chain (a + b + ..., f()()...) does not reach the 800-call limit.
fun expr(ck, top)
    let todo = [top]
    while len(todo) > 0
        let n = pop(todo)
        let k = n.kind
        if k == "Name"
            load_name(ck, n)
        else if k == "Number"
            number(ck, n)
        else if k == "Map"
            let i = len(n.kids) - 1
            while i >= 0
                append(todo, n.kids[i].kids[0])
                i = i - 1
        else if k != "String" and k != "True" and k != "False" and k != "None"
            let i = len(n.kids) - 1
            while i >= 0
                append(todo, n.kids[i])
                i = i - 1

fun block(ck, b, new_scope)
    let scoped = new_scope and declares(b)
    if scoped
        open_scope(ck, b)
    for s in b.kids
        stmt(ck, s)
    if scoped
        close_scope(ck)

fun function(ck, n)
    let sc = new_scope()
    for prm in n.kids[0].kids
        sc.names[prm.text] = true
    let body = n.kids[1]
    if body.kind == "Block"
        pend(sc, body)
    append(ck.fns, {base: len(ck.scopes), loops: 0})
    append(ck.scopes, sc)
    if body.kind == "Block"
        for st in body.kids
            stmt(ck, st)
    else
        expr(ck, body)
    pop(ck.scopes)
    pop(ck.fns)

fun loop_in(ck)
    let f = ck.fns[len(ck.fns) - 1]
    f.loops = f.loops + 1

fun loop_out(ck)
    let f = ck.fns[len(ck.fns) - 1]
    f.loops = f.loops - 1

fun stmt(ck, n)
    let k = n.kind
    if k == "Let"
        expr(ck, n.kids[0])
        declare(ck, n.text)
    else if k == "Fun"
        declare(ck, n.text)
        function(ck, n)
        declare(ck, n.text)
    else if k == "Assign"
        expr(ck, n.kids[1])
        let t = n.kids[0]
        if t.kind == "Field"
            expr(ck, t.kids[0])
        else if t.kind == "Index"
            expr(ck, t.kids[0])
            expr(ck, t.kids[1])
    else if k == "ExprStmt"
        expr(ck, n.kids[0])
    else if k == "If"
        # else if links in a loop, for the same reason as expr()
        let cur = n
        while cur != none
            expr(ck, cur.kids[0])
            block(ck, cur.kids[1], true)
            let alt = none
            if len(cur.kids) > 2
                alt = cur.kids[2]
                if alt.kind != "If"
                    block(ck, alt, true)
                    alt = none
            cur = alt
    else if k == "While"
        expr(ck, n.kids[0])
        loop_in(ck)
        block(ck, n.kids[1], true)
        loop_out(ck)
    else if k == "For"
        expr(ck, n.kids[0])
        loop_in(ck)
        open_scope(ck, n.kids[1])
        declare(ck, n.text)
        for s in n.kids[1].kids
            stmt(ck, s)
        close_scope(ck)
        loop_out(ck)
    else if k == "Return"
        if len(n.kids) > 0
            expr(ck, n.kids[0])
        if len(ck.fns) == 1
            add_item(ck, n, "'return' outside a function")
    else if k == "Break" or k == "Next"
        if ck.fns[len(ck.fns) - 1].loops == 0
            if k == "Break"
                add_item(ck, n, "'break' outside a loop")
            else
                add_item(ck, n, "'next' outside a loop")
    else if k == "Try"
        block(ck, n.kids[0], true)
        if n.text == ""
            block(ck, n.kids[1], true)
        else
            open_scope(ck, n.kids[1])
            declare(ck, n.text)
            for s in n.kids[1].kids
                stmt(ck, s)
            close_scope(ck)
    else if k == "Use"
        declare(ck, use_name(n))

# All the warnings for a parsed program, in the host's order.
fun check_tree(tree)
    let ck = new_check()
    for s in tree.kids
        if s.kind == "Let" or s.kind == "Fun"
            ck.gset[s.text] = true
    for s in tree.kids
        stmt(ck, s)
    for r in ck.reads
        if not (r.node.text in ck.gset)
            let all = []
            for g in keys(ck.gset)
                append(all, g)
            for l in r.locals
                append(all, l)
            for b in keys(ck.builtins)
                append(all, b)
            add_item(ck, r.node, "'{r.node.text}' is not defined" + interp.suggest(r.node.text, all))
    return lists.sort_by(ck.items, before)

fun before(a, b) = a.line < b.line or (a.line == b.line and a.col < b.col)

fun warn(path, lines, it)
    eprint("{path}:{it.line}:{it.col}: warning: {it.msg}")
    let s = errfmt.snippet_in(lines, it.line, it.col)
    if s != ""
        eprint(slice(s, 0, len(s) - 1))

# Checks one file; gives the exit code the host gives for it (0, 1).
fun check_file(path)
    let src = files.read(path)
    let lexed = lexer.lex(src)
    let err = lexed.err
    let tree = none
    if err == none
        let parsed = parser.parse(lexed.tokens)
        err = parsed.err
        tree = parsed.tree
    if err != none
        errfmt.show(path, err)
        return 1
    let items = check_tree(tree)
    let lines = []
    if len(items) > 0
        lines = strings.split(src, "\n")
    for it in items
        warn(path, lines, it)
    if len(items) > 0
        return 1
    return 0

fun main(argv)
    if len(argv) < 1
        eprint("usage: relic selfhost/check.relic FILE...")
        return 2
    let code = 0
    for path in argv
        if not files.exists(path) or files.is_dir(path)
            eprint("relic: cannot open {path}")
            code = 2
        else
            let r = check_file(path)
            if r != 0 and code == 0
                code = r
    return code

let status = main(args())
if status != 0
    host_exit(status)
