# Source formatting, using the lexer and parser for validation and a separate
# scan to retain comments, physical lines and the original string escapes.
# The atom and line rules mirror src/fmt/fmt.cpp.
use lexer
use parser

fun atom(kind, text) = {kind: kind, text: text, unary: false, tight: false, comment: false}
fun new_line(indent, depth) = {indent: indent, depth: depth, blank: false, comment_only: false, atoms: []}

fun space_kw(w)
    return w in ["let", "fun", "if", "else", "while", "for", "return", "not", "and", "or", "in", "use", "try", "catch", "as"]

fun ends_expr(a)
    if a.unary and a.text == "-"
        return false
    if a.kind == "number"
        return true
    if a.kind == "string"
        return len(a.text) == 0 or a.text[len(a.text) - 1] != "{{"
    if a.kind == "word"
        return not space_kw(a.text) and a.text != "break" and a.text != "next"
    return a.text in [")", "]", "}}"]

fun emit(st, a)
    if a.kind == "op"
        if a.text in ["(", "[", "{{"]
            st.depth = st.depth + 1
        else if a.text in [")", "]", "}}"]
            st.depth = st.depth - 1
    if a.kind == "word" and a.text == "use"
        st.use_path = true
    if a.kind == "word" and a.text == "as"
        st.use_path = false
    st.prev = a
    append(st.cur.atoms, a)

fun finish(st)
    append(st.lines, st.cur)
    st.cur = none
    if st.depth == 0
        st.prev = none
        st.use_path = false

fun spaces(st)
    while lexer.peek(st, 0) == " " or lexer.peek(st, 0) == chr(13)
        lexer.advance(st)

fun comment(st)
    lexer.advance(st)
    let start = st.pos
    while not lexer.eof(st) and lexer.peek(st, 0) != "\n" and lexer.peek(st, 0) != chr(13)
        lexer.advance(st)
    let end = st.pos
    while end > start and (st.chars[end - 1] == " " or st.chars[end - 1] == chr(9))
        end = end - 1
    let a = atom("op", lexer._cat(st.chars, start, end))
    a.comment = true
    return a

# Validated strings can be scanned as source chunks. An interpolation's final
# brace belongs to the next literal chunk; only expression braces affect depth.
fun string(st)
    let start = st.pos
    lexer.advance(st)
    while not lexer.eof(st)
        let ch = lexer.peek(st, 0)
        if ch == "\\"
            lexer.advance(st)
            let e = lexer.advance(st)
            if e == "u"
                lexer.advance(st)
                while lexer.peek(st, 0) != "}}"
                    lexer.advance(st)
                lexer.advance(st)
        else if ch == "\""
            lexer.advance(st)
            emit(st, atom("string", lexer.text_of(st, start)))
            return
        else if ch == "{{"
            lexer.advance(st)
            if lexer.peek(st, 0) == "{{"
                lexer.advance(st)
            else
                emit(st, atom("string", lexer.text_of(st, start)))
                let braces = 0
                while true
                    spaces(st)
                    if lexer.peek(st, 0) == "}}" and braces == 0
                        start = st.pos
                        lexer.advance(st)
                        break
                    code_token(st)
                    let t = st.prev.text
                    if t == "{{"
                        braces = braces + 1
                    else if t == "}}" and braces > 0
                        braces = braces - 1
        else if ch == "}}" and lexer.peek(st, 1) == "}}"
            lexer.advance(st)
            lexer.advance(st)
        else
            lexer.advance(st)

fun code_token(st)
    let start = st.pos
    let c = lexer.peek(st, 0)
    if lexer.is_digit(c)
        while lexer.is_digit(lexer.peek(st, 0))
            lexer.advance(st)
        if lexer.peek(st, 0) == "." and lexer.is_digit(lexer.peek(st, 1))
            lexer.advance(st)
            while lexer.is_digit(lexer.peek(st, 0))
                lexer.advance(st)
        if lexer.peek(st, 0) == "e" or lexer.peek(st, 0) == "E"
            let k = 1
            if lexer.peek(st, 1) == "+" or lexer.peek(st, 1) == "-"
                k = 2
            if lexer.is_digit(lexer.peek(st, k))
                for i in 0..k
                    lexer.advance(st)
                while lexer.is_digit(lexer.peek(st, 0))
                    lexer.advance(st)
        emit(st, atom("number", lexer.text_of(st, start)))
    else if lexer.is_alpha(c) or c == "_"
        while lexer.is_word(lexer.peek(st, 0))
            lexer.advance(st)
        emit(st, atom("word", lexer.text_of(st, start)))
    else if c == "\""
        string(st)
    else
        lexer.advance(st)
        if (c in ["=", "<", ">", "!"] and lexer.peek(st, 0) == "=") or (c == "." and lexer.peek(st, 0) == ".")
            lexer.advance(st)
        let a = atom("op", lexer.text_of(st, start))
        if c == "/"
            a.tight = st.use_path
        if c == "-"
            a.unary = st.prev == none or not ends_expr(st.prev)
        emit(st, a)

# Comments attach to the physical line, including lines the parser drops.
# Previous expression and use-path state survive wrapped lines only.
fun scan(source)
    let st = lexer.new_state(source)
    st.depth = 0
    st.use_path = false
    st.prev = none
    st.cur = none
    st.lines = []
    while not lexer.eof(st)
        if st.cur == none
            let indent = 0
            while lexer.peek(st, 0) == " "
                lexer.advance(st)
                indent = indent + 1
            if lexer.peek(st, 0) == chr(13)
                lexer.advance(st)
                next
            if lexer.eof(st)
                break
            let ln = new_line(indent, st.depth)
            if lexer.peek(st, 0) == "\n"
                lexer.advance(st)
                ln.blank = true
                append(st.lines, ln)
                next
            if lexer.peek(st, 0) == "#"
                ln.comment_only = true
                append(ln.atoms, comment(st))
                append(st.lines, ln)
                if lexer.peek(st, 0) == chr(13)
                    lexer.advance(st)
                if lexer.peek(st, 0) == "\n"
                    lexer.advance(st)
                next
            st.cur = ln
        spaces(st)
        if lexer.eof(st)
            break
        if lexer.peek(st, 0) == "\n"
            lexer.advance(st)
            finish(st)
        else if lexer.peek(st, 0) == "#"
            append(st.cur.atoms, comment(st))
            if lexer.peek(st, 0) == chr(13)
                lexer.advance(st)
            if lexer.peek(st, 0) == "\n"
                lexer.advance(st)
            finish(st)
        else
            code_token(st)
    if st.cur != none
        finish(st)
    return st.lines
