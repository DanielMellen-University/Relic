# selfhost/parser.relic: the Relic parser, written in Relic (M9, stage 2).
# Mirrors src/parser/parser.cpp: same tree shape, same errors and positions.
# parse(tokens) gives back {tree, err}. A node is {kind, text, line, col, kids}.
#
# Relic has no catchable errors, so the first error is recorded and from then
# on the parser sees an ERR token at every step. Every loop stops on it, so the
# parse winds down without checks at each call.

fun node(kind, at, text)
    return {kind: kind, text: text, line: at.line, col: at.col, kids: []}

fun add(n, kid)
    append(n.kids, kid)
    return n

fun new_parser(tokens) = {toks: tokens, pos: 0, err: none, dead: {kind: "ERR", text: "", line: 0, col: 0}, nest: 0, h: 0, elifs: 0}

# Nesting of expressions, `-`, `not` and blocks, counted like the host's
# parser (kMaxNesting in src/parser/parser.cpp; keep the two the same). At 32
# levels relicc, this parser compiled to C, needs about 290 KB of C stack on
# Linux and about half of Windows' 1 MB with MSVC; it overflowed there near 65.
let max_nesting = 32

fun nest_in(p)
    p.nest = p.nest + 1
    if p.nest > max_nesting
        fail(p, peek(p), "too deeply nested (more than {max_nesting} levels)")

fun nest_out(p)
    p.nest = p.nest - 1

# p.h is the height of the expression just parsed: 0 for a name, number or
# other leaf, one more than its highest part for anything else (a + b + c is 2,
# f()() is 2). Past max_depth the parse stops, like the host's parser (kMaxDepth
# in src/parser/parser.cpp; keep the two the same): the host walks a tree with
# recursion. `else if` links count the same way, with the links of any chain
# they sit in (p.elifs).
let max_depth = 10000

# n has just been finished; h is the height of the parts parsed before the last.
fun grow(p, n, h)
    if p.h < h
        p.h = h
    p.h = p.h + 1
    if p.h > max_depth
        fail(p, n, "expression is too deeply nested (limit {max_depth})")

fun peek(p)
    if p.err != none
        return p.dead
    return p.toks[p.pos]

fun at(p, kind) = peek(p).kind == kind

fun advance(p)
    let t = peek(p)
    if p.err == none and p.pos < len(p.toks) - 1
        p.pos = p.pos + 1
    return t

fun match(p, kind)
    if not at(p, kind)
        return false
    advance(p)
    return true

fun fail(p, t, msg)
    fail_span(p, t, t.col, msg, "")

# end is the last underlined column. hint may be "".
fun fail_span(p, t, end, msg, hint)
    if p.err == none
        p.err = {line: t.line, col: t.col, end: end, msg: msg, hint: hint}

fun describe(t)
    let k = t.kind
    if k == "NEWLINE"
        return "end of line"
    if k == "INDENT"
        return "an indented block"
    if k == "DEDENT"
        return "end of block"
    if k == "EOF"
        return "end of file"
    if k == "NUMBER"
        return "number " + t.text
    if k == "STRING" or k == "STRING_PART"
        return "a string"
    if k == "NAME"
        return "name '{t.text}'"
    return "'{t.text}'"

# Columns in a token's text. ASCII is the common case; a continuation byte
# does not add a column.
fun text_cols(s)
    let n = 0
    for ch in s
        n = n + 1
    if n < 1
        return 1
    return n

# Common parse mistakes. none when the usual "expected ..., got ..." is enough.
# Keep in step with kExpect and kWords in src/diag/diag.cpp.
fun expect_extra(p, what)
    let got = peek(p)
    let prev = none
    if p.pos > 0
        prev = p.toks[p.pos - 1]
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "PLUS"
        return {msg: "Relic has no '+='", hint: "write x = x + 1", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "MINUS"
        return {msg: "Relic has no '-='", hint: "write x = x - 1", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "STAR"
        return {msg: "Relic has no '*='", hint: "write x = x * 1", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "SLASH"
        return {msg: "Relic has no '/='", hint: "write x = x / 1", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "PERCENT"
        return {msg: "Relic has no '%='", hint: "write x = x % 1", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "EQ_EQ"
        return {msg: "Relic has no '==='", hint: "compare with '=='; '=' assigns", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "ASSIGN" and prev != none and prev.kind == "BANG_EQ"
        return {msg: "Relic has no '!=='", hint: "compare with '!='", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "GREATER" and prev != none and prev.kind == "MINUS"
        return {msg: "Relic has no '->'", hint: "there is no arrow; write the steps out", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "GREATER" and prev != none and prev.kind == "ASSIGN"
        return {msg: "Relic has no '=>'", hint: "a function is written 'fun name() = ...'", cover_prev: true, cover_got: true}
    if what == "end of line" and got.kind == "COLON"
        return {msg: "", hint: "Relic statements do not end with a colon", cover_prev: false, cover_got: true}
    if what == "an expression" and got.kind == "SLASH" and prev != none and prev.kind == "SLASH"
        return {msg: "comments start with '#'", hint: "a comment runs from '#' to the end of the line", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "STAR" and prev != none and prev.kind == "SLASH"
        return {msg: "Relic comments start with '#', not '/*'", hint: "delete the '/*'", cover_prev: true, cover_got: true}
    if what == "an expression" and got.kind == "PLUS" and prev != none and prev.kind == "PLUS"
        return {msg: "Relic has no '++'", hint: "write the new value out, as in n = n + 1", cover_prev: true, cover_got: true}
    if what == "end of line before the block" and got.kind == "COLON"
        return {msg: "", hint: "Relic headers do not end with a colon; indent the next line 4 spaces", cover_prev: false, cover_got: true}
    if what == "end of line before the block" and got.kind == "ASSIGN"
        return {msg: "", hint: "compare with '=='; a single '=' assigns", cover_prev: false, cover_got: true}
    if what == "'=' after the name" and got.kind == "COLON"
        return {msg: "", hint: "use '=', not ':='", cover_prev: false, cover_got: true}
    if what == "'in' after the loop name" and got.kind == "NAME" and got.text == "of"
        return {msg: "", hint: "loops are written 'for name in list'", cover_prev: false, cover_got: true}
    if what == "'in' after the loop name" and got.kind == "COLON"
        return {msg: "", hint: "loops are written 'for name in list', not a colon", cover_prev: false, cover_got: true}
    if what == "end of line" and got.kind == "NOT"
        return {msg: "", hint: "write 'not (a in b)' to negate a test", cover_prev: false, cover_got: true}
    if what == "'catch' after the 'try' block"
        return {msg: "", hint: "a try needs a catch after its block", cover_prev: false, cover_got: true}
    # @@EXPECT@@
    if len(what) < 0
        return {msg: got.kind, hint: "", cover_prev: prev != none, cover_got: false}
    return none

fun word_extra(word)
    if word == "func"
        return "functions are written with 'fun', not 'func'"
    if word == "function"
        return "functions are written with 'fun', not 'function'"
    if word == "def"
        return "functions are written with 'fun', not 'def'"
    if word == "fn"
        return "functions are written with 'fun', not 'fn'"
    if word == "elseif"
        return "write 'else if', not 'elseif'"
    if word == "elif"
        return "write 'else if', not 'elif'"
    if word == "elsif"
        return "write 'else if', not 'elsif'"
    if word == "var"
        return "bindings start with 'let', not 'var'"
    if word == "const"
        return "bindings start with 'let'; Relic has no const"
    if word == "int"
        return "write 'let name = ... as int', not a C declaration"
    if word == "string"
        return "write 'let name = ... as string'"
    if word == "bool"
        return "write 'let name = ... as bool'"
    if word == "float"
        return "write 'let name = ... as float'"
    if word == "import"
        return "modules are loaded with 'use', not 'import'"
    if word == "print"
        return "call it as print(...); the parentheses are required"
    if word == "len"
        return "call it as len(...); the parentheses are required"
    if word == "class"
        return "Relic has no classes; use a map or a module"
    if word == "switch"
        return "branch with if and else if"
    if word == "lambda"
        return "write 'fun name() = ...'"
    if word == "except"
        return "catch an error with try and catch"
    # @@WORD@@
    if len(word) < 0
        return word
    return ""

fun type_extra(name)
    if name == "integer"
        return "did you mean 'int'?"
    if name == "str"
        return "did you mean 'string'?"
    if name == "boolean"
        return "did you mean 'bool'?"
    if name == "dict"
        return "did you mean 'map'?"
    if name == "array"
        return "did you mean 'list'?"
    # @@TYPE@@
    if len(name) < 0
        return name
    return ""

fun fail_expected(p, what)
    let got = peek(p)
    let msg = "expected " + what + ", got " + describe(got)
    let extra = expect_extra(p, what)
    if extra != none
        if extra.msg != ""
            msg = extra.msg
        let col = got.col
        let end = got.col
        if extra.cover_got
            end = got.col + text_cols(got.text) - 1
        if extra.cover_prev and p.pos > 0
            let prev = p.toks[p.pos - 1]
            if prev.line == got.line
                col = prev.col
        if end < col
            end = col
        fail_span(p, {kind: got.kind, text: got.text, line: got.line, col: col}, end, msg, extra.hint)
        return
    if what == "end of line" and p.pos > 0
        let prev = p.toks[p.pos - 1]
        if prev.kind == "NAME"
            let word = word_extra(prev.text)
            if word != ""
                fail_span(p, got, got.col + text_cols(got.text) - 1, msg, word)
                return
    fail(p, got, msg)

fun expect(p, kind, what)
    if not at(p, kind)
        fail_expected(p, what)
    return advance(p)

fun end_of_line(p) = expect(p, "NEWLINE", "end of line")

# ---- statements ----

fun program(p)
    let prog = node("Program", peek(p), "")
    while not at(p, "EOF") and p.err == none
        add(prog, statement(p))
    return prog

fun statement(p)
    let t = peek(p)
    let k = t.kind
    if k == "LET"
        return let_stmt(p)
    if k == "FUN"
        return fun_stmt(p)
    if k == "IF"
        return if_stmt(p)
    if k == "WHILE"
        return while_stmt(p)
    if k == "FOR"
        return for_stmt(p)
    if k == "USE"
        return use_stmt(p)
    if k == "TRY"
        return try_stmt(p)
    if k == "CATCH"
        fail_span(p, t, t.col, "'catch' without a matching 'try'", "a catch follows the block of a try")
    if k == "RETURN"
        advance(p)
        let n = node("Return", t, "")
        if not at(p, "NEWLINE")
            add(n, expression(p))
        end_of_line(p)
        return n
    if k == "BREAK" or k == "NEXT"
        advance(p)
        end_of_line(p)
        if k == "BREAK"
            return node("Break", t, "")
        return node("Next", t, "")
    if k == "ELSE"
        fail_span(p, t, t.col, "'else' without a matching 'if'", "an else follows the block of an if")
    if k == "INDENT"
        fail(p, t, "unexpected indent")
    return expr_stmt(p)

fun block(p)
    nest_in(p)
    let start = peek(p)
    if not at(p, "NEWLINE")
        fail_expected(p, "end of line before the block")
    advance(p)
    if not at(p, "INDENT")
        let got = peek(p)
        fail_span(p, got, got.col, "expected an indented block, got " + describe(got), "indent that line by exactly 4 spaces")
    advance(p)
    let b = node("Block", start, "")
    while not at(p, "DEDENT") and not at(p, "EOF") and p.err == none
        add(b, statement(p))
    match(p, "DEDENT")
    nest_out(p)
    return b

fun try_stmt(p)
    let kw = advance(p)
    let body = block(p)
    if not at(p, "CATCH")
        fail_expected(p, "'catch' after the 'try' block")
    advance(p)
    let name = ""
    if at(p, "NAME")
        name = advance(p).text
    let n = node("Try", kw, name)
    add(n, body)
    add(n, block(p))
    return n

fun use_stmt(p)
    let kw = advance(p)
    let path = ""
    while at(p, "DOT_DOT")
        advance(p)
        expect(p, "SLASH", "'/' after '..'")
        path = path + "../"
    path = path + expect(p, "NAME", "a module name after 'use'").text
    while match(p, "SLASH")
        path = path + "/" + expect(p, "NAME", "a name after '/'").text
    let n = node("Use", kw, path)
    if match(p, "AS")
        let t = expect(p, "NAME", "a name after 'as'")
        add(n, node("Name", t, t.text))
    end_of_line(p)
    return n

fun let_stmt(p)
    let kw = advance(p)
    let name = expect(p, "NAME", "a name after 'let'")
    let hint = type_hint(p)
    expect(p, "ASSIGN", "'=' after the name")
    let n = node("Let", kw, name.text)
    add(n, expression(p))
    if hint != none
        add(n, hint)
    end_of_line(p)
    return n

fun fun_stmt(p)
    let kw = advance(p)
    let name = expect(p, "NAME", "a function name after 'fun'")
    let n = node("Fun", kw, name.text)
    let open = expect(p, "LPAREN", "'(' after the function name")
    let params = node("Params", open, "")
    let names = {}
    if not at(p, "RPAREN")
        let more = true
        while more and p.err == none
            let t = expect(p, "NAME", "a parameter name")
            if t.text in names
                fail_span(p, t, t.col, "duplicate parameter '{t.text}'", "each parameter name is written once")
            names[t.text] = true
            let prm = node("Name", t, t.text)
            let hint = type_hint(p)
            if hint != none
                add(prm, hint)
            add(params, prm)
            more = match(p, "COMMA")
    expect(p, "RPAREN", "')' after the parameters")
    add(n, params)
    let hint = type_hint(p)
    if match(p, "ASSIGN")
        add(n, expression(p))
        end_of_line(p)
    else
        add(n, block(p))
    if hint != none
        add(n, hint)
    return n

let known_types = ["any", "none", "bool", "int", "float", "number", "string", "list", "map", "function", "module"]

# Optional `as type`; none when there is no `as`.
fun type_hint(p)
    if not at(p, "AS")
        return none
    advance(p)
    let t = peek(p)
    if t.kind != "NAME" and t.kind != "NONE"
        fail_expected(p, "a type name after 'as'")
        return none
    advance(p)
    if not (t.text in known_types)
        let type_msg = "unknown type '{t.text}'; use any, none, bool, int, float, number, string, list, map, function or module"
        let hinted = type_extra(t.text)
        if hinted != ""
            fail_span(p, t, t.col + text_cols(t.text) - 1, type_msg, hinted)
        else
            fail(p, t, type_msg)
        return none
    return node("Type", t, t.text)

fun if_stmt(p)
    let kw = advance(p)
    let top = node("If", kw, "")
    add(top, expression(p))
    add(top, block(p))
    # each `else if` hangs off the one before; a loop, not recursion, so a long
    # chain does not run into the 800-call limit (relicc runs this compiled)
    let cur = top
    let more = true
    let saved = p.elifs
    while more and at(p, "ELSE")
        advance(p)
        if at(p, "IF")
            p.elifs = p.elifs + 1
            if p.elifs > max_depth
                fail(p, peek(p), "'else if' chain is too long (limit {max_depth})")
            let n = node("If", advance(p), "")
            add(n, expression(p))
            add(n, block(p))
            add(cur, n)
            cur = n
        else
            add(cur, block(p))
            more = false
    p.elifs = saved
    return top

fun while_stmt(p)
    let kw = advance(p)
    let n = node("While", kw, "")
    add(n, expression(p))
    add(n, block(p))
    return n

fun for_stmt(p)
    let kw = advance(p)
    let name = expect(p, "NAME", "a loop name after 'for'")
    expect(p, "IN", "'in' after the loop name")
    let n = node("For", kw, name.text)
    add(n, expression(p))
    add(n, block(p))
    return n

fun expr_stmt(p)
    let start = peek(p)
    let e = expression(p)
    if at(p, "ASSIGN")
        let eq = advance(p)
        if e.kind != "Name" and e.kind != "Index" and e.kind != "Field"
            fail(p, eq, "can only assign to a name, an index or a field")
        let n = node("Assign", start, "")
        add(n, e)
        add(n, expression(p))
        end_of_line(p)
        return n
    let n = node("ExprStmt", start, "")
    add(n, e)
    end_of_line(p)
    return n

# ---- expressions, lowest precedence first ----

fun expression(p)
    nest_in(p)
    let e = or_expr(p)
    nest_out(p)
    return e

fun binary(left, op, right)
    let n = node("Binary", op, op.text)
    add(n, left)
    return add(n, right)

fun or_expr(p)
    let left = and_expr(p)
    while at(p, "OR")
        let op = advance(p)
        let h = p.h
        left = binary(left, op, and_expr(p))
        grow(p, left, h)
    return left

fun and_expr(p)
    let left = not_expr(p)
    while at(p, "AND")
        let op = advance(p)
        let h = p.h
        left = binary(left, op, not_expr(p))
        grow(p, left, h)
    return left

fun not_expr(p)
    if at(p, "NOT")
        let op = advance(p)
        nest_in(p)
        let n = add(node("Unary", op, "not"), not_expr(p))
        grow(p, n, 0)
        nest_out(p)
        return n
    return compare(p)

let compare_ops = {EQ_EQ: true, BANG_EQ: true, LESS: true, LESS_EQ: true, GREATER: true, GREATER_EQ: true, IN: true}

fun compare(p)
    let left = range(p)
    if peek(p).kind in compare_ops
        let op = advance(p)
        let h = p.h
        left = binary(left, op, range(p))
        grow(p, left, h)
        if peek(p).kind in compare_ops
            let op = peek(p)
            fail_span(p, op, op.col + text_cols(op.text) - 1, "comparisons cannot be chained; use 'and'", "")
    return left

fun range(p)
    let left = additive(p)
    if at(p, "DOT_DOT")
        let op = advance(p)
        let n = add(node("Range", op, ""), left)
        let h = p.h
        add(n, additive(p))
        grow(p, n, h)
        return n
    return left

# Operator kinds as maps: one peek and one lookup per check, not one at() for
# each kind (every expression passes through all these levels).
let add_ops = {PLUS: true, MINUS: true}
let mul_ops = {STAR: true, SLASH: true, PERCENT: true}

fun additive(p)
    let left = multiplicative(p)
    while peek(p).kind in add_ops
        let op = advance(p)
        let h = p.h
        left = binary(left, op, multiplicative(p))
        grow(p, left, h)
    return left

fun multiplicative(p)
    let left = unary(p)
    while peek(p).kind in mul_ops
        let op = advance(p)
        let h = p.h
        left = binary(left, op, unary(p))
        grow(p, left, h)
    return left

fun unary(p)
    if at(p, "MINUS")
        let op = advance(p)
        nest_in(p)
        let n = add(node("Unary", op, "-"), unary(p))
        grow(p, n, 0)
        nest_out(p)
        return n
    return postfix(p)

# Parses "item, item, ..." up to `close`; a trailing comma is fine. p.h ends
# as the highest item, or 0 for none.
fun items(p, n, close)
    let h = 0
    if not at(p, close)
        let more = true
        while more and p.err == none
            add(n, expression(p))
            if p.h > h
                h = p.h
            more = match(p, "COMMA") and not at(p, close)
    p.h = h

fun postfix(p)
    let e = primary(p)
    while p.err == none
        let k = peek(p).kind
        if k == "LPAREN"
            let call = add(node("Call", advance(p), ""), e)
            let h = p.h
            items(p, call, "RPAREN")
            expect(p, "RPAREN", "')' after the arguments")
            grow(p, call, h)
            e = call
        else if k == "LBRACKET"
            let idx = add(node("Index", advance(p), ""), e)
            let h = p.h
            add(idx, expression(p))
            expect(p, "RBRACKET", "']' after the index")
            grow(p, idx, h)
            e = idx
        else if k == "DOT"
            let dot = advance(p)
            let name = expect(p, "NAME", "a field name after '.'")
            e = add(node("Field", dot, name.text), e)
            grow(p, e, 0)
        else
            return e
    return e

let literals = {NUMBER: "Number", STRING: "String", NAME: "Name"}
let words = {TRUE: "True", FALSE: "False", NONE: "None"}

fun primary(p)
    let t = peek(p)
    let k = t.kind
    p.h = 0
    if k in literals
        advance(p)
        return node(literals[k], t, t.text)
    if k in words
        advance(p)
        return node(words[k], t, "")
    if k == "STRING_PART"
        return interp(p)
    if k == "LPAREN"
        advance(p)
        let e = expression(p)
        expect(p, "RPAREN", "')'")
        return e
    if k == "LBRACKET"
        advance(p)
        let l = node("List", t, "")
        items(p, l, "RBRACKET")
        expect(p, "RBRACKET", "']' to close the list")
        grow(p, l, 0)
        return l
    if k == "LBRACE"
        return map_literal(p)
    fail_expected(p, "an expression")
    return node("None", t, "")

fun map_literal(p)
    let open = advance(p)
    let m = node("Map", open, "")
    let seen = {}
    let h = 0
    if not at(p, "RBRACE")
        let more = true
        while more and p.err == none
            let key = peek(p)
            if key.kind != "NAME" and key.kind != "STRING"
                fail_expected(p, "a map key (a name or a string)")
            advance(p)
            # a map of the keys so far: comparing with each one made a long literal quadratic
            if key.text in seen
                fail_span(p, key, key.col, "duplicate map key '{key.text}'", "each map key is written once")
            seen[key.text] = true
            expect(p, "COLON", "':' after the map key")
            let pair = add(node("Pair", key, key.text), expression(p))
            grow(p, pair, 0)
            if p.h > h
                h = p.h
            add(m, pair)
            more = match(p, "COMMA") and not at(p, "RBRACE")
    expect(p, "RBRACE", "'}}' to close the map")
    p.h = h
    grow(p, m, 0)
    return m

fun interp(p)
    let n = node("Interp", peek(p), "")
    let h = 0
    while p.err == none
        let part = advance(p)
        if part.text != ""
            add(n, node("String", part, part.text))
        if part.kind == "STRING_END"
            p.h = h
            grow(p, n, 0)
            return n
        expect(p, "INTERP_START", "'{{'")
        if at(p, "INTERP_END")
            fail(p, peek(p), "empty '{{}}' in a string; use '{{{{' for a brace")
        add(n, expression(p))
        if p.h > h
            h = p.h
        expect(p, "INTERP_END", "'}}' to close the value in the string")
        if not at(p, "STRING_PART") and not at(p, "STRING_END")
            fail_expected(p, "the rest of the string")
    return n

fun parse(tokens)
    let p = new_parser(tokens)
    let tree = program(p)
    return {tree: tree, err: p.err}
